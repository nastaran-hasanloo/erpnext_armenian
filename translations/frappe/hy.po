#: frappe/core/page/permission_manager/permission_manager_help.html:47 frappe/public/js/frappe/ui/permission_dialog.js:23
msgid "Allows the user to delete documents."
msgstr "Թույլ է տալիս օգտատիրոջը ջնջել փաստաթղթեր։"

#: frappe/core/page/permission_manager/permission_manager_help.html:37 frappe/public/js/frappe/ui/permission_dialog.js:20
msgid "Allows the user to edit existing records they have access to."
msgstr "Թույլ է տալիս օգտատիրոջը խմբագրել այն գոյություն ունեցող գրառումները, որոնց հասանելիություն ունի։"

#: frappe/core/page/permission_manager/permission_manager_help.html:57
msgid "Allows the user to email from the document."
msgstr "Թույլ է տալիս օգտատիրոջը էլ. նամակ ուղարկել փաստաթղթից։"

#: frappe/core/page/permission_manager/permission_manager_help.html:67
msgid "Allows the user to export data from the Report view."
msgstr "Թույլ է տալիս օգտատիրոջը արտահանել տվյալներ Հաշվետվության տեսքից։"

#: frappe/public/js/frappe/ui/permission_dialog.js:56
msgid "Allows the user to export document data from the system."
