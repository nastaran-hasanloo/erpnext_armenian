msgstr "Թույլատրել փաստաթղթի ստեղծում էլ. փոստի միջոցով"

msgid "Allow editing Price List rate in transactions"
msgstr "Թույլատրել գնացուցակի գնի խմբագրումը գործարքներում"

msgid "Allow editing after submit"
msgstr "Թույլատրել խմբագրում հաստատումից հետո"

msgid ""
"Allow editing even if the doctype has a workflow set up.\n"
"\n"
"Does nothing if a workflow isn't set up."
msgstr ""
"Թույլատրել խմբագրում, նույնիսկ եթե doctype-ի համար կարգավորված է աշխատանքային հոսք։\n"
"\n"
"Ոչինչ չի անում, եթե աշխատանքային հոսք կարգավորված չէ։"

msgid "Allow events in timeline"
msgstr "Թույլատրել իրադարձություններ ժամանակագրությունում"

msgid "Allow existing Serial No to be Manufactured/Received again"
msgstr "Թույլատրել գոյություն ունեցող սերիական համարի կրկնակի արտադրումը/ստացումը"

msgid "Allow in Quick Entry"
msgstr "Թույլատրել արագ մուտքագրման մեջ"

msgid "Allow incomplete forms"
msgstr "Թույլատրել անավարտ ձևեր"

msgid "Allow internal transfers at user-defined rate"
msgstr "Թույլատրել ներքին տեղափոխումներ օգտատիրոջ սահմանած գնով"

msgid "Allow material consumptions without immediately manufacturing finished goods against a Work Order"
msgstr "Թույլատրել նյութերի սպառումը՝ առանց արտադրական պատվերի դիմաց պատրաստի արտադրանքի անմիջական արտադրության"

msgid "Allow multi-currency invoices against single party account "
msgstr "Թույլատրել բազմարժութային հաշիվ-ապրանքագրեր մեկ կողմի հաշվի դիմաց "

msgid "Allow multiple Sales Orders against a customer's Purchase Order"
msgstr "Թույլատրել մի քանի վաճառքի պատվեր հաճախորդի մեկ գնման պատվերի դիմաց"

msgid "Allow multiple responses"
msgstr "Թույլատրել բազմակի պատասխաններ"

msgid "Allow negative rates for Items"
msgstr "Թույլատրել բացասական գներ ապրանքների համար"

msgid "Allow negative stock"
msgstr "Թույլատրել բացասական պաշար"

msgid "Allow negative stock for Batch"
msgstr "Թույլատրել բացասական պաշար խմբաքանակի համար"

msgid "Allow notifications"
msgstr "Թույլատրել ծանուցումներ"

msgid "Allow on Submit"
msgstr "Թույլատրել հաստատման ժամանակ"

msgid "Allow only one session per user"
msgstr "Թույլատրել միայն մեկ սեսիա յուրաքանչյուր օգտատիրոջ համար"

msgid "Allow page break inside tables"
msgstr "Թույլատրել էջի ընդմիջում աղյուսակների ներսում"

msgid "Allow partial reservation"
msgstr "Թույլատրել մասնակի ամրագրում"

msgid "Allow print"
msgstr "Թույլատրել տպում"

msgid "Allow purchase invoice creation without purchase order"
msgstr "Թույլատրել գնման հաշիվ-ապրանքագրի ստեղծում առանց գնման պատվերի"

msgid "Allow purchase invoice creation without purchase receipt"
msgstr "Թույլատրել գնման հաշիվ-ապրանքագրի ստեղծում առանց ապրանքի ընդունման ակտի"

msgid "Allow sales invoice creation without delivery note"
msgstr "Թույլատրել վաճառքի հաշիվ-ապրանքագրի ստեղծում առանց առաքման ակտի"

msgid "Allow sales invoice creation without sales order"
msgstr "Թույլատրել վաճառքի հաշիվ-ապրանքագրի ստեղծում առանց վաճառքի պատվերի"

msgid "Allow sales transactions with zero quantities if the rate is fixed but the quantities are not. e.g. Rate Contracts"
msgstr "Թույլատրել զրոյական քանակներով վաճառքի գործարքներ, եթե գինը ֆիքսված է, իսկ քանակները՝ ոչ։ Օրինակ՝ գնային պայմանագրեր"

msgid "Allow same Item to be added multiple times in a transaction"
msgstr "Թույլատրել նույն ապրանքի բազմակի ավելացումը մեկ գործարքում"

msgid "Allow saving if mandatory fields are not filled"
msgstr "Թույլատրել պահպանում, եթե պարտադիր դաշտերը լրացված չեն"

msgid "Allow stock to go below zero for this item, even if negative stock is disabled in Stock Settings."
msgstr "Թույլատրել այս ապրանքի պաշարի իջնելը զրոյից ցածր, նույնիսկ եթե բացասական պաշարն անջատված է պահեստի կարգավորումներում։"

msgid "Allow substituting this item with an alternative from the Item Alternative list when stock is unavailable."
msgstr "Թույլատրել այս ապրանքի փոխարինումը այլընտրանքային ապրանքների ցանկից, երբ պաշարն առկա չէ։"

msgid "Allow switching between list, kanban, report, and other views from the toolbar"
msgstr "Թույլատրել անցում ցանկի, կանբանի, հաշվետվության և այլ տեսքերի միջև գործիքագոտուց"

msgid "Allow the following users to approve Leave Applications for block days."
msgstr "Թույլատրել հետևյալ օգտատերերին հաստատել արգելափակված օրերի արձակուրդի դիմումները։"

msgid "Allow this item to be used in purchase transactions."
msgstr "Թույլատրել այս ապրանքի օգտագործումը գնման գործարքներում։"

msgid "Allow this item to be used in sales transactions."
msgstr "Թույլատրել այս ապրանքի օգտագործումը վաճառքի գործարքներում։"

msgid "Allow to edit stock UOM qty for Purchase documents"
msgstr "Թույլատրել պահեստային Չ/մ-ով քանակի խմբագրումը գնման փաստաթղթերում"

msgid "Allow to edit stock UOM qty for Sales documents"
msgstr "Թույլատրել պահեստային Չ/մ-ով քանակի խմբագրումը վաճառքի փաստաթղթերում"

msgid "Allow to edit stock UOM qty for Stock Entry"
msgstr "Թույլատրել պահեստային Չ/մ-ով քանակի խմբագրումը պահեստային գործառնությունում"

msgid "Allow to make Quality Inspection after Purchase / Delivery"
msgstr "Թույլատրել որակի ստուգում կատարել գնումից / առաքումից հետո"

msgid "Allow transferring raw materials even after the Required Quantity is fulfilled"
msgstr "Թույլատրել հումքի տեղափոխումը նույնիսկ պահանջվող քանակը լրացվելուց հետո"

msgid "Allow user to login only after this hour (0-24)"
msgstr "Թույլատրել օգտատիրոջը մուտք գործել միայն այս ժամից հետո (0-24)"

msgid "Allow user to login only before this hour (0-24)"
msgstr "Թույլատրել օգտատիրոջը մուտք գործել միայն այս ժամից առաջ (0-24)"

msgid "Allow users to log in without a password, using a login link sent to their email"
msgstr "Թույլատրել օգտատերերին մուտք գործել առանց գաղտնաբառի՝ իրենց էլ. փոստին ուղարկված մուտքի հղումով"

msgid "Allowed"
msgstr "Թույլատրված"

msgid "Allowed Dimension"
msgstr "Թույլատրված չափում"

msgid "Allowed DocTypes"
msgstr "Թույլատրված DocType-եր"

msgid "Allowed Doctypes for Guest Uploads"
msgstr "Հյուրերի վերբեռնումների համար թույլատրված Doctype-եր"

msgid "Allowed File Extensions"
msgstr "Թույլատրված ֆայլերի ընդլայնումներ"

msgid "Allowed In Mentions"
msgstr "Թույլատրված հիշատակումներում"

msgid "Allowed Items"
msgstr "Թույլատրված ապրանքներ"

msgid "Allowed Modules"
msgstr "Թույլատրված մոդուլներ"

msgid "Allowed Public Client Origins"
msgstr "Թույլատրված հանրային կլիենտների աղբյուրներ"

msgid "Allowed Roles"
msgstr "Թույլատրված դերեր"

msgid "Allowed To Transact With"
msgstr "Թույլատրված է գործարքներ կատարել"

msgid "Allowed Users"
msgstr "Թույլատրված օգտատերեր"

msgid "Allowed Users is not required as Frappe CRM is already installed on the site."
msgstr "Թույլատրված օգտատերերը պարտադիր չեն, քանի որ Frappe CRM-ն արդեն տեղադրված է կայքում։"

msgid "Allowed Users is required for data synchronization from remote Frappe CRM site."
msgstr "Թույլատրված օգտատերերը պարտադիր են հեռավոր Frappe CRM կայքից տվյալների համաժամեցման համար։"

msgid "Allowed embedding domains"
msgstr "Թույլատրված ներկառուցման դոմեններ"

msgid "Allowed primary roles are 'Customer' and 'Supplier'. Please select one of these roles only."
msgstr "Թույլատրված հիմնական դերերն են «Հաճախորդ» և «Մատակարար»։ Խնդրում ենք ընտրել միայն այս դերերից մեկը։"

msgid "Allowed special characters are '/' and '-'"
msgstr "Թույլատրված հատուկ նշաններն են '/' և '-'"

msgid "Allowed to transact with"
msgstr "Թույլատրված է գործարքներ կատարել"

msgid "Allowed: {0}"
msgstr "Թույլատրված՝ {0}"

msgid "Allowing DocType, DocType. Be careful!"
msgstr "Թույլատրվում է DocType, DocType։ Զգույշ եղեք։"

msgid "Allows allocating more leaves than the number of days in the allocation period."
msgstr "Թույլ է տալիս բաշխել ավելի շատ արձակուրդ, քան բաշխման ժամանակաշրջանի օրերի քանակն է։"

msgid "Allows clients to fetch metadata from the <code>/.well-known/oauth-authorization-server</code> endpoint. Reference: <a href=\"https://datatracker.ietf.org/doc/html/rfc8414\">RFC8414</a>"
msgstr "Թույլ է տալիս կլիենտներին ստանալ մետատվյալներ <code>/.well-known/oauth-authorization-server</code> վերջնակետից։ Հղում՝ <a href=\"https://datatracker.ietf.org/doc/html/rfc8414\">RFC8414</a>"

msgid "Allows clients to fetch metadata from the <code>/.well-known/oauth-protected-resource</code> endpoint. Reference: <a href=\"https://datatracker.ietf.org/doc/html/rfc9728#name-protected-resource-metadata\">RFC9728</a>"
msgstr "Թույլ է տալիս կլիենտներին ստանալ մետատվյալներ <code>/.well-known/oauth-protected-resource</code> վերջնակետից։ Հղում՝ <a href=\"https://datatracker.ietf.org/doc/html/rfc9728#name-protected-resource-metadata\">RFC9728</a>"

msgid "Allows clients to register themselves without manual intervention. Registration creates a <b>OAuth Client</b> entry. Reference: <a href=\"https://datatracker.ietf.org/doc/html/rfc7591\">RFC7591</a>"
msgstr "Թույլ է տալիս կլիենտներին գրանցվել առանց ձեռքով միջամտության։ Գրանցումը ստեղծում է <b>OAuth կլիենտ</b> գրառում։ Հղում՝ <a href=\"https://datatracker.ietf.org/doc/html/rfc7591\">RFC7591</a>"

msgid "Allows clients to view this as an Authorization Server when querying the <code>/.well-known/oauth-protected-resource</code> end point."
msgstr "Թույլ է տալիս կլիենտներին դիտարկել սա որպես Թույլտվության սերվեր՝ <code>/.well-known/oauth-protected-resource</code> վերջնակետին հարցում անելիս։"

msgid "Allows enabled Social Login Key Base URL to be shown as authorization server."
msgstr "Թույլ է տալիս միացված Social Login Key-ի բազային URL-ը ցուցադրել որպես թույլտվության սերվեր։"

msgid "Allows printing or PDF download of documents."
msgstr "Թույլ է տալիս փաստաթղթերի տպում կամ PDF ներբեռնում։"

msgid "Allows sharing document access with other users."
msgstr "Թույլ է տալիս կիսվել փաստաթղթի հասանելիությամբ այլ օգտատերերի հետ։"

msgid "Allows skipping authorization if a user has active tokens."
msgstr "Թույլ է տալիս բաց թողնել թույլտվությունը, եթե օգտատերն ունի ակտիվ տոկեններ։"

msgid "Allows the user to access reports related to the document."
msgstr "Թույլ է տալիս օգտատիրոջը մուտք գործել փաստաթղթին վերաբերող հաշվետվություններ։"

msgid "Allows the user to amend a cancelled document into a new copy."
msgstr "Թույլ է տալիս օգտատիրոջը ուղղել չեղարկված փաստաթուղթը՝ ստեղծելով նոր օրինակ։"

msgid "Allows the user to cancel submitted documents."
msgstr "Թույլ է տալիս օգտատիրոջը չեղարկել հաստատված փաստաթղթերը։"

msgid "Allows the user to create new documents."
msgstr "Թույլ է տալիս օգտատիրոջը ստեղծել նոր փաստաթղթեր։"

msgid "Allows the user to delete documents."
msgstr "Թույլ է տալիս օգտատիրոջը ջնջել փաստաթղթեր։"

msgid "Allows the user to edit existing records they have access to."
msgstr "Թույլ է տալիս օգտատիրոջը խմբագրել այն գոյություն ունեցող գրառումները, որոնց հասանելիություն ունի։"

msgid "Allows the user to email from the document."
msgstr "Թույլ է տալիս օգտատիրոջը էլ. նամակ ուղարկել փաստաթղթից։"

msgid "Allows the user to export data from the Report view."
msgstr "Թույլ է տալիս օգտատիրոջը արտահանել տվյալներ Հաշվետվության տեսքից։"

msgid "Allows the user to export document data from the system."
msgstr "Թույլ է տալիս օգտատիրոջը արտահանել փաստաթղթի տվյալները համակարգից։"

msgid "Allows the user to print or download the document as a PDF."
msgstr "Թույլ է տալիս օգտատիրոջը տպել կամ ներբեռնել փաստաթուղթը PDF ձևաչափով։"

msgid "Allows the user to search and see records."
msgstr "Թույլ է տալիս օգտատիրոջը որոնել և տեսնել գրառումները։"

msgid "Allows the user to search and select records in other forms. This does not allow the user to view the record itself."
msgstr "Թույլ է տալիս օգտատիրոջը որոնել և ընտրել գրառումներ այլ ձևերում։ Սա օգտատիրոջը թույլ չի տալիս դիտել բուն գրառումը։"

msgid "Allows the user to send emails linked to the document."
msgstr "Թույլ է տալիս օգտատիրոջը ուղարկել փաստաթղթի հետ կապված էլ. նամակներ։"

msgid "Allows the user to share document access with other users who may not have access to the document themselves."
msgstr "Թույլ է տալիս օգտատիրոջը կիսվել փաստաթղթի հասանելիությամբ այլ օգտատերերի հետ, որոնք կարող է իրենք հասանելիություն չունենան փաստաթղթին։"

msgid "Allows the user to submit documents."
