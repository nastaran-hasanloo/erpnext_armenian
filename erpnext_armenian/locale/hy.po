msgstr "Տող #{}: {} POS հաշիվ-ապրանքագիրը {} հաճախորդի դիմաց չէ"

msgid "Row #{}: POS Invoice {} is not submitted yet"
msgstr "Տող #{}: {} POS հաշիվ-ապրանքագիրը դեռ հաստատված չէ"

msgid "Row #{}: Party ID is required"
msgstr "Տող #{}: Կողմի ID-ն պարտադիր է"

msgid "Row #{}: Please assign task to a member."
msgstr "Տող #{}: Խնդրում ենք առաջադրանքը նշանակել որևէ անդամի։"

msgid "Row #{}: Please use a different Finance Book."
msgstr "Տող #{}: Խնդրում ենք օգտագործել այլ ֆինանսական մատյան։"

msgid "Row #{}: Serial No {} cannot be returned since it was not transacted in original invoice {}"
msgstr "Տող #{}: {} սերիական համարը չի կարող վերադարձվել, քանի որ այն չի օգտագործվել {} սկզբնական հաշիվ-ապրանքագրում"

msgid "Row #{}: The original Invoice {} of return invoice {} is not consolidated."
msgstr "Տող #{}: {} վերադարձի հաշիվ-ապրանքագրի {} սկզբնական հաշիվ-ապրանքագիրը համախմբված չէ։"

msgid "Row #{}: You cannot add positive quantities in a return invoice. Please remove item {} to complete the return."
msgstr "Տող #{}: Վերադարձի հաշիվ-ապրանքագրում չեք կարող ավելացնել դրական քանակներ։ Խնդրում ենք հեռացնել {} ապրանքը՝ վերադարձն ավարտելու համար։"

msgid "Row #{}: item {} has been picked already."
msgstr "Տող #{}: {} ապրանքն արդեն հավաքված է։"

msgid "Row #{}: {}"
msgstr "Տող #{}: {}"

msgid "Row #{}: {} {} does not exist."
msgstr "Տող #{}: {} {} գոյություն չունի։"

msgid "Row #{}: {} {} doesn't belong to Company {}. Please select valid {}."
msgstr "Տող #{}: {} {}-ը չի պատկանում {} ընկերությանը։ Խնդրում ենք ընտրել վավեր {}։"

