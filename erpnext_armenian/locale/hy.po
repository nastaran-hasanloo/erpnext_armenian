msgid "The Sales Person is linked with {0}"
msgstr "Վաճառքի ներկայացուցիչը կապված է {0}-ի հետ"

msgid "The Serial No at Row #{0}: {1} is not available in warehouse {2}."
msgstr "Տող #{0}-ի սերիական համարը՝ {1}, հասանելի չէ {2} պահեստում։"

msgid "The Serial No {0} is reserved against the {1} {2} and cannot be used for any other transaction."
msgstr "{0} սերիական համարն ամրագրված է {1} {2}-ի դիմաց և չի կարող օգտագործվել որևէ այլ գործարքի համար։"

msgid "The Serial and Batch Bundle {0} is not valid for this transaction. The 'Type of Transaction' should be 'Outward' instead of 'Inward' in Serial and Batch Bundle {0}"
msgstr "Սերիական համարի և խմբաքանակի {0} փաթեթը վավեր չէ այս գործարքի համար։ Սերիական համարի և խմբաքանակի {0} փաթեթում «Գործարքի տեսակը» պետք է լինի «Ելքային»՝ «Մուտքային»-ի փոխարեն"

msgid "The Stock Closing Entry for {0} is not completed yet. Wait for it to complete before submitting the Period Closing Voucher."
msgstr "{0}-ի պաշարի փակման գրառումը դեռ ավարտված չէ։ Սպասեք դրա ավարտին՝ նախքան ժամանակահատվածի փակման փաստաթուղթը հաստատելը։"

msgid "The Stock Entry of type 'Manufacture' is known as backflush. Raw materials being consumed to manufacture finished goods is known as backflushing. <br><br> When creating Manufacture Entry, raw-material items are backflushed based on BOM of production item. If you want raw-material items to be backflushed based on Material Transfer entry made against that Work Order instead, then you can set it under this field."
msgstr "«Արտադրություն» տեսակի պահեստային գործառնությունը կոչվում է հետադարձ դուրսգրում (backflush)։ Պատրաստի արտադրանք արտադրելու համար հումքի սպառումը կոչվում է հետադարձ դուրսգրում։ <br><br> Արտադրական գործառնություն ստեղծելիս հումքը դուրս է գրվում ըստ արտադրվող ապրանքի BOM-ի։ Եթե ցանկանում եք, որ հումքը դուրս գրվի ըստ այդ արտադրական պատվերի դիմաց կատարված նյութերի տեղափոխման գրառման, կարող եք սահմանել դա այս դաշտում։"

msgid "The Supplier Scorecard standing of {0} is now {1}."
msgstr "{0}-ի դիրքը մատակարարի գնահատման քարտում այժմ {1} է։"

msgid "The Typst block could not render its template: {0}"
msgstr "Typst բլոկը չկարողացավ արտապատկերել իր կաղապարը՝ {0}"

msgid "The Typst block in {0} does not compile: {1}"
msgstr "{0}-ում Typst բլոկը չի կոմպիլյացվում՝ {1}"

msgid "The Typst block in {0} has a template error: {1}"
msgstr "{0}-ում Typst բլոկն ունի կաղապարի սխալ՝ {1}"

msgid "The Typst renderer cannot embed this background image: {0}"
msgstr "Typst արտապատկերիչը չի կարող ներդնել այս ֆոնային պատկերը՝ {0}"

msgid "The Typst renderer cannot embed this image: {0}"
msgstr "Typst արտապատկերիչը չի կարող ներդնել այս պատկերը՝ {0}"

msgid "The User record for this request has been auto-deleted due to inactivity by system admins."
msgstr "Այս հարցման Օգտատիրոջ գրառումը ավտոմատ ջնջվել է համակարգի ադմինիստրատորների կողմից՝ ոչ ակտիվության պատճառով։"

msgid "The VAT accounts to report in the South Africa VAT audit report."
msgstr "VAT հաշիվները, որոնք պետք է ներառվեն Հարավային Աֆրիկայի VAT աուդիտի հաշվետվությունում։"

msgid "The account head under Liability or Equity, in which Profit/Loss will be booked"
msgstr "Պարտավորությունների կամ Սեփական կապիտալի բաժնի հաշիվը, որում կձևակերպվի շահույթը/վնասը"

msgid "The account type of {0} cannot be changed from {1} because stock ledger entries exist against it."
msgstr "{0} հաշվի տեսակը չի կարող փոխվել {1}-ից, քանի որ դրա նկատմամբ առկա են պահեստային մատյանի գրառումներ։"

msgid "The account your customers pay into and you pay from, linked to its account in your chart of accounts. See [Bank Account](https://docs.frappe.io/erpnext/user/manual/en/bank-account)."
msgstr "Հաշիվը, որին վճարում են ձեր հաճախորդները և որից վճարում եք դուք, կապված ձեր հաշվային պլանի համապատասխան հաշվին։ Տե՛ս [Bank Account](https://docs.frappe.io/erpnext/user/manual/en/bank-account)։"

msgid "The allocated amount is greater than the outstanding amount of Payment Request {0}"
msgstr "Բաշխված գումարը գերազանցում է {0} վճարման հարցման չմարված գումարը"

msgid "The amount format detected in the statement file. This is used to parse the deposit and withdrawal values from each row."
msgstr "Քաղվածքի ֆայլում հայտնաբերված գումարի ձևաչափը։ Այն օգտագործվում է յուրաքանչյուր տողից մուտքի և ելքի արժեքները վերլուծելու համար։"

msgid "The amount of {0} set in this payment request is different from the calculated amount of all payment plans: {1}. Make sure this is correct before submitting the document."
msgstr "Այս վճարման հարցման մեջ սահմանված {0} գումարը տարբերվում է բոլոր վճարման պլանների հաշվարկված գումարից՝ {1}։ Փաստաթուղթը հաստատելուց առաջ համոզվեք, որ սա ճիշտ է։"

msgid "The app this one mounts on, for a companion app -- one with no rail of its own, whose entries live on a host's. Blank on every ordinary dock. An **app name** rather than a Link to a `Dock`: every consumer wants a string, and a pin aimed at a record would be a pin aimed at one of that app's three layers, which means nothing. App-layer only: `depends_on` hides it elsewhere and `validate` blanks it, because hiding a field does not stop an API write."
msgstr "Հավելվածը, որի վրա տեղադրվում է այս մեկը՝ ուղեկցող հավելվածի դեպքում, որը չունի սեփական վահանակ, և որի տարրերը գտնվում են հյուրընկալողի վահանակում։ Դատարկ է բոլոր սովորական dock-երում։ Սա **հավելվածի անուն** է, այլ ոչ թե հղում `Dock`-ին. յուրաքանչյուր սպառող ակնկալում է տող, իսկ գրառմանն ուղղված ամրացումը կլիներ ուղղված այդ հավելվածի երեք շերտերից մեկին, ինչը իմաստ չունի։ Միայն հավելվածի շերտում. `depends_on`-ը թաքցնում է այն այլ տեղերում, իսկ `validate`-ը մաքրում է, քանի որ դաշտի թաքցնելը չի կանխում API-ի միջոցով գրառումը։"

msgid "The app this sidebar is placed in. Derived from the module when there is one -- a module sits in exactly one app. Author-set when there is not: an app-rooted sidebar has no module to derive it from, and this is then the only thing that says which app ships the file."
msgstr "Հավելվածը, որում տեղադրված է այս կողային վահանակը։ Ստացվում է մոդուլից, եթե այն կա. մոդուլը պատկանում է ճիշտ մեկ հավելվածի։ Սահմանվում է հեղինակի կողմից, եթե մոդուլ չկա. հավելվածին կցված կողային վահանակը չունի մոդուլ, որից կարելի է այն ստանալ, և այդ դեպքում միայն սա է նշում, թե որ հավելվածն է մատակարարում ֆայլը։"

msgid "The app whose dock lists this module. A custom module may leave it empty and stand on its own."
msgstr "Հավելվածը, որի dock-ում նշված է այս մոդուլը։ Հատուկ մոդուլը կարող է այն դատարկ թողնել և լինել ինքնուրույն։"

msgid "The app whose dock this layer arranges. Required: a dock belongs to an app, and a layer that named none would be one arrangement spanning every rail. An `Autocomplete` over installed apps rather than a Link, because there is no `App` doctype -- the house spelling, shared with `Sidebar.app` and `Desktop Icon.app`."
msgstr "Հավելվածը, որի dock-ը դասավորում է այս շերտը։ Պարտադիր է. dock-ը պատկանում է հավելվածի, իսկ որևէ հավելված չնշող շերտը կլիներ բոլոր վահանակներն ընդգրկող մեկ դասավորություն։ Տեղադրված հավելվածների `Autocomplete`, այլ ոչ թե Link, քանի որ `App` doctype գոյություն չունի. սա ընդունված գրելաձևն է, որն օգտագործվում է նաև `Sidebar.app`-ում և `Desktop Icon.app`-ում։"

msgid "The application has been updated to a new version, please refresh this page"
msgstr "Հավելվածը թարմացվել է նոր տարբերակի, խնդրում ենք թարմացնել այս էջը"

msgid "The application name will be used in the Login page."
msgstr "Հավելվածի անվանումը կօգտագործվի Մուտքի էջում։"

msgid "The attachments could not be correctly linked to the new document"
msgstr "Կցորդները չհաջողվեց ճիշտ կապել նոր փաստաթղթին"

msgid "The bank account is disabled. Please enable it"
msgstr "Բանկային հաշիվն անջատված է։ Խնդրում ենք միացնել այն"

msgid "The bank account is not a company account. Please select a company account"
msgstr "Բանկային հաշիվը ընկերության հաշիվ չէ։ Խնդրում ենք ընտրել ընկերության հաշիվ"

msgid "The batch {0} is reserved for {1} in the warehouse {2} and the remaining quantity is not enough to cover the reservations. So, cannot proceed with the {3} {4}."
msgstr "{0} խմբաքանակը ամրագրված է {1}-ի համար {2} պահեստում, և մնացած քանակը բավարար չէ ամրագրումները ծածկելու համար։ Հետևաբար հնարավոր չէ շարունակել {3} {4}-ը։"

msgid "The bill your supplier sent, so you know what you owe and when it is due. See [Purchase Invoice](https://docs.frappe.io/erpnext/user/manual/en/purchase-invoice)."
msgstr "Մատակարարի ուղարկած հաշիվը, որպեսզի իմանաք՝ որքան եք պարտք և երբ է վճարման ժամկետը։ Տե՛ս [Purchase Invoice](https://docs.frappe.io/erpnext/user/manual/en/purchase-invoice)։"

msgid "The block {0} points at a {1} this version of the app no longer ships."
msgstr "{0} բլոկը հղում է անում {1}-ի, որն այս հավելվածի տարբերակն այլևս չի մատակարարում։"

msgid ""
"The browser API key obtained from the Google Cloud Console under <a href=\"https://console.cloud.google.com/apis/credentials\">\n"
"\"APIs &amp; Services\" &gt; \"Credentials\"\n"
"</a>"
msgstr ""
"Google Cloud Console-ից ստացված դիտարկիչի API բանալին՝ <a href=\"https://console.cloud.google.com/apis/credentials\">\n"
"\"APIs &amp; Services\" &gt; \"Credentials\"\n"
"</a> բաժնում"

msgid "The card was saved in another column"
msgstr "Քարտը պահպանվել է մեկ այլ սյունակում"

msgid "The cash or non-trade discount cannot be combined with discounts carried from other documents."
msgstr "Կանխիկ կամ ոչ առևտրային զեղչը չի կարող համակցվել այլ փաստաթղթերից փոխանցված զեղչերի հետ։"

msgid "The cash or non-trade discount cannot be combined with the discount of {0}."
msgstr "Կանխիկ կամ ոչ առևտրային զեղչը չի կարող համակցվել {0}-ի զեղչի հետ։"

msgid "The change to {0} cannot be carried by a customization."
msgstr "{0}-ի փոփոխությունը չի կարող իրականացվել կարգավորման միջոցով։"

msgid "The changes have been reverted."
msgstr "Փոփոխությունները հետ են շրջվել։"

msgid "The classic builder can no longer create formats"
msgstr "Դասական կառուցիչն այլևս չի կարող ձևաչափեր ստեղծել"

msgid "The classic builder will be removed in version 17."
msgstr "Դասական կառուցիչը կհեռացվի 17-րդ տարբերակում։"

msgid "The classic builder will be removed in version 17. Convert this format to the new builder to keep editing it."
msgstr "Դասական կառուցիչը կհեռացվի 17-րդ տարբերակում։ Փոխարկեք այս ձևաչափը նոր կառուցիչի՝ այն շարունակելու խմբագրել։"

msgid "The closing balance {0} of the Stock Asset accounts differs from the closing value {1} of the Stock Balance report by {2}, which is within the allowed {3}% tolerance. Submit the Period Closing Voucher with this difference?"
msgstr "Պահեստային ակտիվների հաշիվների {0} փակման մնացորդը տարբերվում է Պաշարների մնացորդի հաշվետվության {1} փակման արժեքից {2}-ով, որը թույլատրելի {3}% շեղման սահմաններում է։ Հաստատե՞լ ժամանակաշրջանի փակման փաստաթուղթը այս տարբերությամբ։"

msgid "The closing balance {0} of the Stock Asset accounts does not match the closing value {1} of the Stock Balance report as on {2}. Resolve the difference using the Stock Ledger Variance report before closing the period."
msgstr "Պահեստային ակտիվների հաշիվների {0} փակման մնացորդը չի համապատասխանում Պաշարների մնացորդի հաշվետվության {1} փակման արժեքին {2} դրությամբ։ Ժամանակաշրջանը փակելուց առաջ վերացրեք տարբերությունը Պահեստային մատյանի շեղումների հաշվետվության միջոցով։"

msgid "The colour {0} is not one the desk offers and was skipped."
msgstr "{0} գույնը աշխատասեղանի առաջարկվող գույներից չէ և բաց է թողնվել։"

msgid "The column {0} has {1} different date formats. Automatically setting {2} as the default format as it is the most common. Please change other values in this column to this format."
msgstr "{0} սյունակն ունի {1} տարբեր ամսաթվի ձևաչափ։ Որպես լռելյայն ձևաչափ ավտոմատ սահմանվում է {2}-ը, քանի որ այն ամենատարածվածն է։ Խնդրում ենք այս սյունակի մյուս արժեքները փոխել այս ձևաչափով։"

msgid "The comment cannot be empty"
msgstr "Մեկնաբանությունը չի կարող դատարկ լինել"

msgid "The company {0} is not in South Africa. VAT Audit Report is only available for companies in South Africa."
msgstr "{0} ընկերությունը Հարավային Աֆրիկայում չէ։ VAT աուդիտի հաշվետվությունը հասանելի է միայն Հարավային Աֆրիկայի ընկերությունների համար։"

msgid "The company {0} is not in United Arab Emirates. UAE VAT 201 report is only available for companies in United Arab Emirates."
msgstr "{0} ընկերությունը Արաբական Միացյալ Էմիրություններում չէ։ UAE VAT 201 հաշվետվությունը հասանելի է միայն Արաբական Միացյալ Էմիրությունների ընկերությունների համար։"

msgid "The completed quantity {0} of an operation {1} cannot be greater than the completed quantity {2} of a previous operation {3}."
msgstr "{1} գործողության ավարտված քանակը՝ {0}, չի կարող գերազանցել նախորդ {3} գործողության ավարտված քանակը՝ {2}։"

msgid "The completed quantity {0} of an operation {1} cannot be greater than the manufactured quantity {2} of a previous operation {3}. Submit the manufacturing entry for the operation {3} first."
msgstr "{1} գործողության ավարտված քանակը՝ {0}, չի կարող գերազանցել նախորդ {3} գործողության արտադրված քանակը՝ {2}։ Նախ հաստատեք {3} գործողության արտադրական գրառումը։"

msgid "The configured SMTP server does not support DSN (Delivery Status Notification)."
msgstr "Կարգավորված SMTP սերվերը չի աջակցում DSN (առաքման կարգավիճակի ծանուցում)։"

msgid "The contents and weight of each package in a delivery."
msgstr "Առաքման յուրաքանչյուր փաթեթի պարունակությունը և քաշը։"

msgid "The contents of this email are strictly confidential. Please do not forward this email to anyone."
msgstr "Այս նամակի բովանդակությունը խիստ գաղտնի է։ Խնդրում ենք չփոխանցել այս նամակը որևէ մեկին։"

msgid "The cost of the secondary items cannot exceed the raw material cost of {0}."
msgstr "Երկրորդային ապրանքների արժեքը չի կարող գերազանցել {0}-ի հումքի արժեքը։"

msgid "The count shown is an estimated count. Click here to see the accurate count."
msgstr "Ցուցադրված քանակը մոտավոր է։ Սեղմեք այստեղ՝ ճշգրիտ քանակը տեսնելու համար։"

msgid "The country's ISO 3166 ALPHA-2 code."
msgstr "Երկրի ISO 3166 ALPHA-2 կոդը։"

msgid "The criteria formula fails when every variable is {0}. Check its syntax and guard divisions by a variable, for example: {1}"
msgstr "Չափանիշի բանաձևը ձախողվում է, երբ բոլոր փոփոխականները {0} են։ Ստուգեք շարահյուսությունը և պաշտպանեք փոփոխականով բաժանումները, օրինակ՝ {1}"

msgid "The currency of invoice {} ({}) is different from the currency of this dunning ({})."
msgstr "Հաշիվ-ապրանքագրի {} արժույթը ({}) տարբերվում է այս պարտքի հիշեցման արժույթից ({})։"

