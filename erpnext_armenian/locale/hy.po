msgid "Row {0} picked quantity is less than the required quantity, additional {1} {2} required."
msgstr "Տող {0}: Հավաքված քանակը փոքր է պահանջվող քանակից, անհրաժեշտ է լրացուցիչ {1} {2}։"

msgid "Row {0}# Allocated amount {1} cannot be greater than unclaimed amount {2}"
msgstr "Տող {0}# Բաշխված գումարը՝ {1}, չի կարող գերազանցել չպահանջված գումարը՝ {2}"

msgid "Row {0}# Item {1} not found in 'Raw Materials Supplied' table in {2} {3}"
msgstr "Տող {0}# {1} ապրանքը չի գտնվել 'Մատակարարված հումք' աղյուսակում {2} {3}-ում"

msgid "Row {0}# Paid Amount cannot be greater than Encashment amount"
msgstr "Տող {0}# Վճարված գումարը չի կարող գերազանցել փոխհատուցման գումարը"

msgid "Row {0}# Paid Amount cannot be greater than Total amount"
msgstr "Տող {0}# Վճարված գումարը չի կարող գերազանցել ընդհանուր գումարը"

msgid "Row {0}# Paid Amount cannot be greater than requested advance amount"
msgstr "Տող {0}# Վճարված գումարը չի կարող գերազանցել հայցված կանխավճարի գումարը"

msgid "Row {0}: Accepted Qty and Rejected Qty can't be zero at the same time."
msgstr "Տող {0}: Ընդունված և մերժված քանակները չեն կարող միաժամանակ զրո լինել։"

msgid "Row {0}: Account {1} and Party Type {2} have different account types"
msgstr "Տող {0}: {1} հաշիվը և {2} կողմի տեսակը ունեն տարբեր հաշվի տեսակներ"

msgid "Row {0}: Account {1} must be a {2} account"
msgstr "Տող {0}: {1} հաշիվը պետք է լինի {2} հաշիվ"

msgid "Row {0}: Accounting Dimension {1} is mandatory for account {2}. Set it on this Taxes and Charges row, or on Item Row {3} ({4})."
msgstr "Տող {0}: {1} հաշվապահական չափումը պարտադիր է {2} հաշվի համար։ Սահմանեք այն այս հարկերի և վճարների տողում կամ ապրանքի {3} տողում ({4})։"

msgid "Row {0}: Activity Type is mandatory."
msgstr "Տող {0}: Գործունեության տեսակը պարտադիր է։"

msgid "Row {0}: Activity Type {1} is disabled"
msgstr "Տող {0}: {1} գործունեության տեսակն անջատված է"

msgid "Row {0}: Advance against Customer must be credit"
msgstr "Տող {0}: Հաճախորդի դիմաց կանխավճարը պետք է կրեդիտ լինի"

msgid "Row {0}: Advance against Supplier must be debit"
msgstr "Տող {0}: Մատակարարի դիմաց կանխավճարը պետք է դեբետ լինի"

msgid "Row {0}: Allocated amount {1} must be less than or equal to invoice outstanding amount {2}"
msgstr "Տող {0}: Բաշխված {1} գումարը պետք է փոքր կամ հավասար լինի հաշիվ-ապրանքագրի {2} չմարված գումարին"

msgid "Row {0}: Allocated amount {1} must be less than or equal to remaining payment amount {2}"
msgstr "Տող {0}: Բաշխված {1} գումարը պետք է փոքր կամ հավասար լինի մնացած վճարման {2} գումարին"

msgid "Row {0}: As {1} is enabled, raw materials cannot be added to {2} entry. Use {3} entry to consume raw materials."
msgstr "Տող {0}: Քանի որ {1}-ը միացված է, հումքը չի կարող ավելացվել {2} գրառմանը։ Օգտագործեք {3} գրառումը՝ հումքը սպառելու համար։"

msgid "Row {0}: Bill of Materials not found for the Item {1}"
msgstr "Տող {0}: Նյութերի ցանկը չի գտնվել {1} ապրանքի համար"

msgid "Row {0}: Both Debit and Credit values cannot be zero"
msgstr "Տող {0}: Դեբետի և կրեդիտի արժեքները միաժամանակ չեն կարող զրո լինել"

msgid "Row {0}: Branch is only meaningful inside an If step"
msgstr "Տող {0}: Ճյուղն իմաստ ունի միայն If քայլի ներսում"

msgid "Row {0}: Cannot sell item {1} from Sample Retention Warehouse {2}"
msgstr "Տող {0}: Հնարավոր չէ վաճառել {1} ապրանքը {2} նմուշների պահպանման պահեստից"

msgid "Row {0}: Conversion Factor is mandatory"
msgstr "Տող {0}: Փոխարկման գործակիցը պարտադիր է"

msgid "Row {0}: Conversion Factor must be greater than zero."
msgstr "Տող {0}: Փոխարկման գործակիցը պետք է մեծ լինի զրոյից։"

msgid "Row {0}: Cost Center {1} does not belong to Company {2}"
msgstr "Տող {0}: {1} ծախսերի կենտրոնը չի պատկանում {2} ընկերությանը"

msgid "Row {0}: Cost center is required for an item {1}"
msgstr "Տող {0}: Ծախսերի կենտրոնը պարտադիր է {1} ապրանքի համար"

msgid "Row {0}: Credit entry can not be linked with a {1}"
msgstr "Տող {0}: Կրեդիտային գրառումը չի կարող կապակցվել {1}-ի հետ"

msgid "Row {0}: Currency of the BOM #{1} should be equal to the selected currency {2}"
msgstr "Տող {0}: #{1} BOM-ի արժույթը պետք է հավասար լինի ընտրված {2} արժույթին"

msgid "Row {0}: Debit entry can not be linked with a {1}"
msgstr "Տող {0}: Դեբետային գրառումը չի կարող կապակցվել {1}-ի հետ"

msgid "Row {0}: Delivery Warehouse ({1}) and Customer Warehouse ({2}) can not be same"
msgstr "Տող {0}: Առաքման պահեստը ({1}) և հաճախորդի պահեստը ({2}) չեն կարող նույնը լինել"

msgid "Row {0}: Delivery Warehouse cannot be same as Customer Warehouse for Item {1}."
msgstr "Տող {0}: Առաքման պահեստը չի կարող նույնը լինել, ինչ հաճախորդի պահեստը {1} ապրանքի համար։"

msgid "Row {0}: Due Date in the Payment Terms table cannot be before Posting Date"
msgstr "Տող {0}: Վճարման պայմանների աղյուսակում վճարման ժամկետը չի կարող լինել ձևակերպման ամսաթվից առաջ"

msgid "Row {0}: Either Delivery Note Item or Packed Item reference is mandatory."
msgstr "Տող {0}: Պարտադիր է կամ առաքման ակտի ապրանքի, կամ փաթեթավորված ապրանքի հղումը։"

msgid "Row {0}: Exchange Rate is mandatory"
msgstr "Տող {0}: Փոխարժեքը պարտադիր է"

msgid "Row {0}: Expected Value After Useful Life cannot be negative"
msgstr "Տող {0}: Օգտակար ծառայության ժամկետից հետո սպասվող արժեքը չի կարող բացասական լինել"

msgid "Row {0}: Expected Value After Useful Life must be less than Net Purchase Amount"
msgstr "Տող {0}: Օգտակար ծառայության ժամկետից հետո սպասվող արժեքը պետք է փոքր լինի գնման զուտ գումարից"

msgid "Row {0}: Expense Account {1} is linked to company {2}. Please select an account belonging to company {3}."
msgstr "Տող {0}: {1} ծախսի հաշիվը կապակցված է {2} ընկերությանը։ Խնդրում ենք ընտրել {3} ընկերությանը պատկանող հաշիվ։"

msgid "Row {0}: Expense Head changed to {1} as no Purchase Receipt is created against Item {2}."
