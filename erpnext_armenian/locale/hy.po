msgid "A draft reverse journal for {0} has been created: {1}"
msgstr "{0}-ի համար ստեղծվել է հակադարձ ձևակերպման սևագիր՝ {1}"

msgid "A driver must be set to submit."
msgstr "Հաստատելու համար պետք է նշված լինի վարորդ։"

msgid "A few quick questions so we can set things up the way you work."
msgstr "Մի քանի արագ հարց, որպեսզի ամեն ինչ կարգավորենք ձեր աշխատաոճին համապատասխան։"

msgid "A field with the name {0} already exists in {1}"
msgstr "{0} անվանումով դաշտ արդեն գոյություն ունի {1}-ում"

msgid "A file with same name {} already exists"
msgstr "{} նույն անվանումով ֆայլ արդեն գոյություն ունի"

msgid "A finer grouping of bank accounts, like savings or current."
msgstr "Բանկային հաշիվների ավելի մանրամասն խմբավորում, օրինակ՝ խնայողական կամ ընթացիկ։"

msgid "A folder cannot have a File URL"
msgstr "Թղթապանակը չի կարող ունենալ ֆայլի URL"

msgid "A friendly reminder of an important date for our team."
msgstr "Բարեկամական հիշեցում մեր թիմի համար կարևոր ամսաթվի մասին։"

msgid "A group of tax withholding categories that apply together."
msgstr "Հարկի պահման կատեգորիաների խումբ, որոնք կիրառվում են միասին։"

msgid "A group of units of an item made or received together."
msgstr "Ապրանքի միավորների խումբ, որոնք արտադրվել կամ ստացվել են միասին։"

msgid "A grouping of bank accounts, like checking or credit card."
msgstr "Բանկային հաշիվների խմբավորում, օրինակ՝ ընթացիկ կամ վարկային քարտ։"

msgid "A grouping of calls, like sales or support."
msgstr "Զանգերի խմբավորում, օրինակ՝ վաճառք կամ աջակցություն։"

msgid "A grouping of inspection parameters."
msgstr "Ստուգման պարամետրերի խմբավորում։"

msgid "A grouping of issues, like billing or technical."
msgstr "Խնդիրների խմբավորում, օրինակ՝ հաշվարկային կամ տեխնիկական։"

msgid "A grouping of projects, like internal or external."
msgstr "Նախագծերի խմբավորում, օրինակ՝ ներքին կամ արտաքին։"

msgid "A grouping of tasks, like bug or feature."
msgstr "Առաջադրանքների խմբավորում, օրինակ՝ սխալ կամ գործառույթ։"

msgid "A grouping of units, like weight or length."
msgstr "Միավորների խմբավորում, օրինակ՝ քաշ կամ երկարություն։"

msgid "A grouping of warehouses, like transit or store."
msgstr "Պահեստների խմբավորում, օրինակ՝ տարանցիկ կամ խանութ։"

msgid "A guarantee a bank gives on your behalf, or on a customer's or supplier's."
msgstr "Երաշխիք, որը բանկը տալիս է ձեր, հաճախորդի կամ մատակարարի անունից։"

msgid "A job title, like manager or accountant."
msgstr "Պաշտոն, օրինակ՝ կառավարիչ կամ հաշվապահ։"

msgid "A kind of stock entry, like material transfer or manufacture."
msgstr "Պահեստային գործառնության տեսակ, օրինակ՝ նյութերի տեղափոխում կամ արտադրություն։"

msgid "A kind of work you track time against, like design or support."
msgstr "Աշխատանքի տեսակ, որի համար հաշվառում եք ժամանակը, օրինակ՝ դիզայն կամ աջակցություն։"

msgid "A kind of workstation, with its costs."
msgstr "Աշխատատեղի տեսակ՝ իր ծախսերով։"

msgid "A layout saved on {0} could not be read and was skipped."
msgstr "{0}-ին պահպանված դասավորությունը հնարավոր չեղավ կարդալ և այն բաց թողնվեց։"

msgid "A layout with this name already exists"
msgstr "Այս անվանումով դասավորություն արդեն գոյություն ունի"

msgid "A ledger in your chart of accounts that entries are posted to."
msgstr "Հաշվային պլանի հաշիվ, որին ձևակերպվում են գրառումները։"

msgid "A legal entity with its own books, like your business or a subsidiary."
msgstr "Իրավաբանական անձ՝ իր հաշվապահական մատյաններով, օրինակ՝ ձեր բիզնեսը կամ դուստր ընկերությունը։"

msgid "A line from your bank statement, ready to be matched with a payment."
msgstr "Տող ձեր բանկային քաղվածքից, որը պատրաստ է վճարման հետ համադրվելու։"

msgid "A list of resources which the Client App will have access to after the user allows it.<br> e.g. project"
msgstr "Ռեսուրսների ցանկ, որոնց կլիենտ հավելվածը հասանելիություն կունենա օգտատիրոջ թույլտվությունից հետո։<br> օր.՝ project"

msgid "A little about you"
msgstr "Մի քիչ ձեր մասին"

msgid "A machine or place where operations are done."
msgstr "Մեքենա կամ վայր, որտեղ կատարվում են գործողությունները։"

msgid "A marketing campaign, to see which leads and sales it brought in."
msgstr "Մարքեթինգային արշավ՝ տեսնելու համար, թե ինչ լիդեր և վաճառքներ է այն բերել։"

msgid "A meeting booked with a lead or customer."
msgstr "Լիդի կամ հաճախորդի հետ ամրագրված հանդիպում։"

msgid "A meeting to review quality, with its agenda and minutes."
msgstr "Որակի վերանայման հանդիպում՝ իր օրակարգով և արձանագրությամբ։"

msgid "A naming series conflict occurred while creating serial numbers. Please change the naming series for the item {0}."
msgstr "Սերիական համարներ ստեղծելիս առաջացել է անվանման շարքի հակասություն։ Խնդրում ենք փոխել {0} ապրանքի անվանման շարքը։"

msgid "A new appointment has been created for you with {0}"
msgstr "Ձեզ համար ստեղծվել է նոր հանդիպում {0}-ի հետ"

msgid "A new area to place fields in"
msgstr "Դաշտերի տեղադրման նոր տարածք"

msgid "A new fiscal year has been automatically created."
msgstr "Նոր ֆինանսական տարին ստեղծվել է ավտոմատ։"

msgid "A parcel size you ship often."
msgstr "Ծանրոցի չափ, որը հաճախ եք առաքում։"

msgid "A parcel you send through a carrier."
msgstr "Ծանրոց, որն ուղարկում եք փոխադրողի միջոցով։"

msgid "A part of your business you track income and expenses for, like a branch or product line."
msgstr "Ձեր բիզնեսի մաս, որի համար հաշվառում եք եկամուտներն ու ծախսերը, օրինակ՝ մասնաճյուղ կամ արտադրանքի գիծ։"

msgid "A periodic check of how a quality goal is going."
msgstr "Որակի նպատակի ընթացքի պարբերական ստուգում։"

msgid "A person or company that owns shares in your company."
msgstr "Անձ կամ ընկերություն, որը ձեր ընկերության բաժնետոմսերի սեփականատեր է։"

msgid "A person you deal with, at a customer, supplier or anywhere else."
msgstr "Անձ, ում հետ գործ ունեք՝ հաճախորդի, մատակարարի կամ այլ տեղում։"

msgid "A phone call made or received."
msgstr "Կատարված կամ ստացված հեռախոսազանգ։"

msgid "A piece of work to be done, often part of a project."
msgstr "Կատարման ենթակա աշխատանք, հաճախ՝ նախագծի մաս։"

msgid "A piece of work with tasks, time and costs."
msgstr "Աշխատանք՝ առաջադրանքներով, ժամանակով և ծախսերով։"

msgid "A place where you keep stock."
msgstr "Վայր, որտեղ պահում եք պաշարը։"

msgid "A place where your assets are kept."
msgstr "Վայր, որտեղ պահվում են ձեր ակտիվները։"

msgid "A postal address of a customer, supplier, company or contact."
msgstr "Հաճախորդի, մատակարարի, ընկերության կամ կոնտակտի փոստային հասցե։"

msgid "A potential sale to a lead or customer."
msgstr "Հնարավոր վաճառք լիդին կամ հաճախորդին։"

msgid "A private workspace is yours alone. Only you can see it."
msgstr "Անձնական աշխատանքային տարածքը միայն ձերն է։ Միայն դուք կարող եք այն տեսնել։"

msgid "A problem or question raised by a customer."
msgstr "Հաճախորդի կողմից բարձրացված խնդիր կամ հարց։"

msgid "A product or a service you sell. See [Item](https://docs.frappe.io/erpnext/user/manual/en/item)."
msgstr "Ապրանք կամ ծառայություն, որը վաճառում եք։ Տե՛ս [Ապրանք](https://docs.frappe.io/erpnext/user/manual/en/item)։"

msgid "A product or service you buy, sell or keep in stock."
msgstr "Ապրանք կամ ծառայություն, որը գնում, վաճառում կամ պահում եք պաշարում։"

msgid "A progress update collected from the project team."
msgstr "Նախագծի թիմից հավաքված առաջընթացի թարմացում։"

msgid "A property item variants differ by, like size or colour."
msgstr "Հատկանիշ, որով տարբերվում են ապրանքի տարբերակները, օրինակ՝ չափս կամ գույն։"

msgid "A published list of codes, like units or tax categories, used in e-invoicing."
msgstr "Կոդերի հրապարակված ցանկ, օրինակ՝ միավորներ կամ հարկային կատեգորիաներ, որն օգտագործվում է էլեկտրոնային հաշիվ-ապրանքագրերում։"

msgid "A quality inspection must be completed before generating a Delivery Note for this item."
msgstr "Այս ապրանքի համար առաքման ակտ ստեղծելուց առաջ պետք է ավարտել որակի ստուգումը։"

msgid "A quality inspection must be completed before generating a Purchase Receipt for this item."
msgstr "Այս ապրանքի համար ապրանքի ընդունման ակտ ստեղծելուց առաջ պետք է ավարտել որակի ստուգումը։"

msgid "A record of maintenance done on an asset."
msgstr "Ակտիվի վրա կատարված սպասարկման գրառում։"

msgid "A record of shares issued, bought back or moved between shareholders."
msgstr "Թողարկված, հետ գնված կամ բաժնետերերի միջև փոխանցված բաժնետոմսերի գրառում։"

msgid "A recurring {0} {1} has been created for you via Auto Repeat {2}."
msgstr "Ձեզ համար ստեղծվել է կրկնվող {0} {1}՝ Ավտոմատ կրկնում {2}-ի միջոցով։"

msgid "A region you sell in, to group customers and set targets."
msgstr "Տարածաշրջան, որտեղ վաճառում եք՝ հաճախորդներին խմբավորելու և թիրախներ սահմանելու համար։"

msgid "A regular email summing up how the business is doing."
msgstr "Պարբերական էլ. նամակ՝ բիզնեսի վիճակի ամփոփմամբ։"

msgid "A reminder to a customer about an overdue invoice."
msgstr "Հիշեցում հաճախորդին ժամկետանց հաշիվ-ապրանքագրի մասին։"

msgid "A repair made to an asset, and what it cost."
msgstr "Ակտիվի վերանորոգում և դրա արժեքը։"

msgid "A request to buy, transfer or make items."
msgstr "Ապրանքներ գնելու, տեղափոխելու կամ արտադրելու հայտ։"

msgid "A sale made at the point of sale."
msgstr "Վաճառքի կետում կատարված վաճառք։"

msgid "A saved set of accounts to start journal entries from."
msgstr "Հաշիվների պահպանված հավաքածու՝ հաշվապահական ձևակերպումներ սկսելու համար։"

msgid "A separate Purchase Order is created for each Supplier."
msgstr "Յուրաքանչյուր մատակարարի համար ստեղծվում է առանձին գնման պատվեր։"

msgid "A separate set of books, for example to depreciate assets under another rule."
msgstr "Առանձին հաշվապահական մատյաններ, օրինակ՝ ակտիվները այլ կանոնով մաշեցնելու համար։"

msgid "A series of emails sent to leads or contacts on a schedule."
msgstr "Լիդերին կամ կոնտակտներին ժամանակացույցով ուղարկվող էլ. նամակների շարք։"

msgid "A set of discounts and free items, like buy two get one free."
msgstr "Զեղչերի և անվճար ապրանքների հավաքածու, օրինակ՝ գնիր երկուսը, ստացիր մեկը անվճար։"

msgid "A set of item prices for buying, selling or both."
msgstr "Ապրանքների գների հավաքածու՝ գնման, վաճառքի կամ երկուսի համար։"

msgid "A set of payment terms to apply to invoices and orders."
msgstr "Վճարման պայմանների հավաքածու՝ հաշիվ-ապրանքագրերի և պատվերների համար։"

msgid "A set of tasks to start new projects from."
msgstr "Առաջադրանքների հավաքածու՝ նոր նախագծեր սկսելու համար։"

msgid "A shared workspace needs a module other than {0}."
msgstr "Ընդհանուր աշխատանքային տարածքին անհրաժեշտ է {0}-ից տարբեր մոդուլ։"

msgid "A short code added to account names, like Cash - AC."
msgstr "Հաշիվների անվանումներին ավելացվող կարճ կոդ, օրինակ՝ Cash - AC։"

msgid "A sidebar needs at least one entry that leads somewhere. Put one back, or use Reset to drop this arrangement."
msgstr "Կողային վահանակին անհրաժեշտ է առնվազն մեկ տարր, որը ինչ-որ տեղ է տանում։ Վերադարձրեք մեկը կամ օգտագործեք Վերակայել՝ այս դասավորությունը հեռացնելու համար։"

msgid "A sidebar's name is part of its desk URL, so it cannot contain {0}."
msgstr "Կողային վահանակի անվանումը նրա desk URL-ի մասն է, ուստի այն չի կարող պարունակել {0}։"

msgid "A single unit of an item, tracked by its own number."
msgstr "Ապրանքի մեկ միավոր, որը հետևվում է իր սեփական համարով։"

msgid "A site's overrides on a standard (app-shipped) workspace. Site-owned and standard-only: there is no user layer, deliberately -- a private workspace is already yours to edit directly, and a public one is the site's. The merge is split on purpose. Roles, icon, visibility and sequence are a true diff, so an app's later changes to them keep flowing through. Content is a snapshot, so customizing the layout freezes it against app updates: workspace content is nested editor blocks where headings, paragraphs and spacers carry no key at all, and a delta cannot be written against unkeyed prose. Do not \"fix\" this into one or the other; `reset_workspace_customization` is the escape hatch."
msgstr "Կայքի վերասահմանումները ստանդարտ (հավելվածի կողմից մատակարարվող) աշխատանքային տարածքի վրա։ Միայն կայքին պատկանող և միայն ստանդարտ. օգտատիրոջ շերտ միտումնավոր չկա -- անձնական աշխատանքային տարածքն արդեն ձերն է՝ ուղղակիորեն խմբագրելու համար, իսկ հանրայինը՝ կայքինը։ Միաձուլումը միտումնավոր բաժանված է։ Դերերը, պատկերակը, տեսանելիությունը և հերթականությունը իրական տարբերություն (diff) են, ուստի հավելվածի հետագա փոփոխությունները դրանցում շարունակում են փոխանցվել։ Բովանդակությունը պատկեր (snapshot) է, ուստի դասավորության հարմարեցումը սառեցնում է այն հավելվածի թարմացումների նկատմամբ. աշխատանքային տարածքի բովանդակությունը ներդրված խմբագրիչի բլոկներ են, որտեղ վերնագրերը, պարբերությունները և բացատները ընդհանրապես բանալի չունեն, և չի կարելի տարբերություն գրել առանց բանալու տեքստի նկատմամբ։ Մի \"ուղղեք\" սա մեկի կամ մյուսի. `reset_workspace_customization`-ը ելքի ճանապարհն է։"

