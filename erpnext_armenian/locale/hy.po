msgstr "Միացնել Urchin Tracking Module (UTM) պարամետրերը գնային առաջարկում, վաճառքի պատվերում, վաճառքի հաշիվ-ապրանքագրում, POS հաշիվ-ապրանքագրում, լիդում և առաքման ակտում։"

msgid "Enable YouTube Tracking"
msgstr "Միացնել YouTube հետևումը"

msgid "Enable an Automation Flow only after adding at least one action"
msgstr "Ավտոմատացման հոսքը միացրեք միայն առնվազն մեկ գործողություն ավելացնելուց հետո"

msgid "Enable automatic party matching"
msgstr "Միացնել կողմերի ավտոմատ համապատասխանեցումը"

msgid "Enable bulk edit for child table fields in Form view."
msgstr "Միացնել ենթակա աղյուսակի դաշտերի զանգվածային խմբագրումը ձևի տեսքում։"

msgid "Enable bulk update of this field across child table rows."
msgstr "Միացնել այս դաշտի զանգվածային թարմացումը ենթակա աղյուսակի տողերում։"

msgid "Enable checkboxes to select multiple records and perform bulk operations."
msgstr "Միացնել նշավանդակները՝ մի քանի գրառում ընտրելու և զանգվածային գործողություններ կատարելու համար։"

msgid "Enable cost center, projects and other custom accounting dimensions"
msgstr "Միացնել ծախսերի կենտրոնները, նախագծերը և այլ անհատական հաշվապահական չափումները"

msgid "Enable cut-off date on creating bulk Delivery Notes"
msgstr "Միացնել վերջնաժամկետի ամսաթիվը առաքման ակտերի զանգվածային ստեղծման ժամանակ"

msgid "Enable developer mode to change whether a dock is standard -- it is backed by a file in its app."
msgstr "Միացրեք մշակողի ռեժիմը՝ փոխելու համար, թե արդյոք dock-ը ստանդարտ է. այն հիմնված է իր հավելվածի ֆայլի վրա։"

msgid "Enable developer mode to change whether a sidebar is standard -- it is backed by a file in its app."
msgstr "Միացրեք մշակողի ռեժիմը՝ փոխելու համար, թե արդյոք կողագոտին ստանդարտ է. այն հիմնված է իր հավելվածի ֆայլի վրա։"

msgid "Enable developer mode to create a standard Print Format Snippet"
msgstr "Միացրեք մշակողի ռեժիմը՝ ստանդարտ Print Format Snippet ստեղծելու համար"

msgid "Enable developer mode to create a standard Print Template"
msgstr "Միացրեք մշակողի ռեժիմը՝ ստանդարտ Print Template ստեղծելու համար"

msgid "Enable developer mode to create a standard Web Template"
msgstr "Միացրեք մշակողի ռեժիմը՝ ստանդարտ Web Template ստեղծելու համար"

msgid "Enable discount accounting for selling"
msgstr "Միացնել զեղչերի հաշվառումը վաճառքի համար"

msgid "Enable for drop shipping - supplier delivers directly to the customer without passing through your warehouse."
msgstr "Միացրեք ուղիղ առաքման համար. մատակարարն առաքում է անմիջապես հաճախորդին՝ առանց ձեր պահեստով անցնելու։"

msgid "Enable for raw material items used in BOM. Uncheck for additional services like 'washing' used in manufacturing."
msgstr "Միացրեք BOM-ում օգտագործվող հումքային ապրանքների համար։ Չնշեք արտադրության մեջ օգտագործվող լրացուցիչ ծառայությունների համար, օրինակ՝ «լվացում»։"

msgid "Enable if a vendor manufactures this item for you. You can choose to provide them raw materials using the default BOM."
msgstr "Միացրեք, եթե այս ապրանքը ձեզ համար արտադրում է մատակարարը։ Կարող եք նրան հումք տրամադրել լռելյայն BOM-ի հիման վրա։"

msgid ""
"Enable if on click\n"
"opens modal."
msgstr ""
"Միացնել, եթե սեղմելիս\n"
"բացվում է մոդալ պատուհան։"

msgid "Enable if this item is a company asset like machinery or furniture."
msgstr "Միացրեք, եթե այս ապրանքը ընկերության ակտիվ է, օրինակ՝ մեքենասարքավորում կամ կահույք։"

msgid "Enable if this item is provided by a customer and received via Stock Entry."
msgstr "Միացրեք, եթե այս ապրանքը տրամադրվում է հաճախորդի կողմից և ստացվում է պահեստային գործառնության միջոցով։"

msgid "Enable in-app website tracking"
msgstr "Միացնել կայքի ներհավելվածային հետևումը"

msgid "Enable it if users want to consider rejected materials to dispatch."
msgstr "Միացրեք, եթե օգտատերերը ցանկանում են առաքման համար հաշվի առնել մերժված նյութերը։"

msgid "Enable party name/description fuzzy matching"
msgstr "Միացնել կողմի անվանման/նկարագրության ոչ ճշգրիտ համապատասխանեցումը"

msgid "Enable stock reservation"
msgstr "Միացնել պաշարների ամրագրումը"

msgid "Enable the notification type before emailing it to users."
msgstr "Միացրեք ծանուցման տեսակը՝ նախքան այն օգտատերերին էլ. փոստով ուղարկելը։"

msgid "Enable this checkbox even if you want to set the zero priority"
msgstr "Նշեք այս վանդակը, նույնիսկ եթե ցանկանում եք սահմանել զրոյական առաջնահերթություն"

msgid "Enable this if you are experiencing issues with the new budget controller. Uses the older budget validation logic"
msgstr "Միացրեք սա, եթե նոր բյուջետային վերահսկիչի հետ խնդիրներ ունեք։ Օգտագործում է բյուջեի ստուգման հին տրամաբանությունը"

msgid "Enable this option to calculate daily depreciation by considering the total number of days in the entire depreciation period, (including leap years) while using daily pro-rata based depreciation"
msgstr "Միացրեք այս տարբերակը՝ օրական մաշվածությունը հաշվարկելու համար՝ հաշվի առնելով ամբողջ մաշվածության ժամանակահատվածի օրերի ընդհանուր թիվը (ներառյալ նահանջ տարիները), օրական համամասնական մաշվածություն օգտագործելիս"

msgid "Enable this option to include the field in the data import template"
msgstr "Միացրեք այս ընտրանքը՝ դաշտը տվյալների ներմուծման ձևանմուշում ներառելու համար"

msgid "Enable this option to permit the use of negative rates for items in sales transactions. This setting is useful for applying substantial discounts, processing refunds or returns, and handling special promotional pricing."
msgstr "Միացրեք այս տարբերակը՝ վաճառքի գործարքներում ապրանքների համար բացասական գներ թույլատրելու համար։ Այս կարգավորումն օգտակար է զգալի զեղչեր կիրառելու, փոխհատուցումներ կամ վերադարձներ մշակելու և հատուկ ակցիոն գներ կիրառելու համար։"

msgid "Enable this to block transactions where the selling price is less than the purchase or valuation rate"
msgstr "Միացրեք սա՝ արգելափակելու այն գործարքները, որտեղ վաճառքի գինը ցածր է գնման կամ գնահատման գնից"

msgid "Enable this to use a specific multiplier for public holidays. If unchecked, the standard multiplier will be used instead."
msgstr "Միացրեք սա՝ պետական տոների համար հատուկ գործակից օգտագործելու համար։ Եթե նշված չէ, կօգտագործվի ստանդարտ գործակիցը։"

msgid "Enable this to use a specific multiplier for weekends. If unchecked, the standard multiplier will be used instead."
msgstr "Միացրեք սա՝ հանգստյան օրերի համար հատուկ գործակից օգտագործելու համար։ Եթե նշված չէ, կօգտագործվի ստանդարտ գործակիցը։"

msgid "Enable to apply SLA on every {0}"
msgstr "Միացրեք՝ յուրաքանչյուր {0}-ի նկատմամբ SLA կիրառելու համար"

msgid "Enable to make this supplier selectable as a transporter on Delivery Notes and Stock Entries"
msgstr "Միացրեք, որպեսզի այս մատակարարը հնարավոր լինի ընտրել որպես փոխադրող առաքման ակտերում և պահեստային գործառնություններում"

msgid "Enable to reserve a small sample from each batch for any analysis arising ahead"
msgstr "Միացրեք՝ յուրաքանչյուր խմբաքանակից փոքր նմուշ պահելու համար՝ հետագա հնարավոր վերլուծությունների համար"

msgid "Enable tracking sales commissions"
msgstr "Միացնել վաճառքի միջնորդավճարների հետևումը"

msgid "Enabled"
msgstr "Միացված"

msgid "Enabled Scheduler"
msgstr "Պլանավորիչը միացված է"

msgid "Enabled email inbox for user {0}"
msgstr "Միացվեց էլ. փոստի մուտքային արկղը {0} օգտատիրոջ համար"

msgid "Enabled only for Employee Benefit components from Salary Structure Assignment"
msgstr "Միացված է միայն աշխատավարձի կառուցվածքի նշանակման աշխատակցի նպաստի բաղադրիչների համար"

msgid "Enables Calendar and Gantt views."
msgstr "Միացնում է Օրացույցի և Գանտի տեսքերը։"

msgid "Enabling Push Notifications..."
msgstr "Push ծանուցումների միացում..."

msgid "Enabling auto reply on an incoming email account will send automated replies to all the synchronized emails. Do you wish to continue?"
msgstr "Մուտքային էլ. փոստի հաշվում ավտոմատ պատասխանը միացնելու դեպքում ավտոմատ պատասխաններ կուղարկվեն բոլոր համաժամեցված նամակներին։ Ցանկանո՞ւմ եք շարունակել։"

msgid "Enabling email for {0} across all users in the background."
msgstr "{0}-ի համար էլ. փոստը միացվում է բոլոր օգտատերերի համար ֆոնային ռեժիմում։"

msgid "Enabling requires at least one action and a valid trigger."
msgstr "Միացնելու համար անհրաժեշտ է առնվազն մեկ գործողություն և վավեր գործարկիչ։"

msgid "Enabling the check box will fetch timesheet on select of a Project in Sales Invoice"
msgstr "Այս վանդակը նշելու դեպքում վաճառքի հաշիվ-ապրանքագրում նախագիծ ընտրելիս կստացվի աշխատաժամանակի թերթիկը"

msgid "Enabling this checkbox will force each Job Card Time Log to have From Time and To Time"
msgstr "Այս վանդակը նշելու դեպքում աշխատանքային քարտի յուրաքանչյուր ժամանակի գրառում պարտադիր պետք է ունենա սկզբի և ավարտի ժամ"

msgid "Enabling this ensures each Purchase Invoice has a unique value in Supplier Invoice No. field within a particular fiscal year"
msgstr "Սա միացնելով՝ ապահովվում է, որ յուրաքանչյուր գնման հաշիվ-ապրանքագիր որոշակի ֆինանսական տարվա ընթացքում ունենա եզակի արժեք «Մատակարարի հաշիվ-ապրանքագրի համար» դաշտում"

msgid "Enabling this option prevents the creation of a new Sales Invoice when the customer has an overdue limit set and their outstanding overdue amount exceeds that limit."
msgstr "Այս տարբերակը միացնելով՝ արգելվում է նոր վաճառքի հաշիվ-ապրանքագրի ստեղծումը, երբ հաճախորդի համար սահմանված է ժամկետանց պարտքի սահմանաչափ, և նրա չմարված ժամկետանց գումարը գերազանցում է այդ սահմանաչափը։"

msgid "Enabling this option will allow you to record - <br><br> 1. Advances Received in a <b>Liability Account</b> instead of the <b>Asset Account</b><br><br>2. Advances Paid in an <b>Asset Account</b> instead of the <b> Liability Account</b>"
msgstr "Այս տարբերակը միացնելով՝ կկարողանաք գրանցել - <br><br> 1. Ստացված կանխավճարները <b>պարտավորության հաշվում</b>՝ <b>ակտիվի հաշվի</b> փոխարեն<br><br>2. Վճարված կանխավճարները <b>ակտիվի հաշվում</b>՝ <b> պարտավորության հաշվի</b> փոխարեն"

msgid "Enabling this will allow creation of multi-currency invoices against single party account in company currency"
msgstr "Սա միացնելով՝ թույլատրվում է բազմարժութային հաշիվ-ապրանքագրերի ստեղծում ընկերության արժույթով կողմի մեկ հաշվի նկատմամբ"

msgid "Enabling this will change the way how cancelled transactions are handled."
msgstr "Սա միացնելով՝ կփոխվի չեղարկված գործարքների մշակման եղանակը։"

msgid ""
"Enabling this will do the following:\n"
"<ul style=\"padding-left:16px\">\n"
"<li>Make the rate column of all Packed/Bundle Items tables editable.</li>\n"
"<li>Calculate the prices of all <a href=\"/desk/product-bundle\" rel=\"noopener noreferrer\">Product Bundles</a> in the Items table, based on the prices of its child Items, specified in the Packed/Bundle Items table. </li>\n"
"</ul>\n"
"Note: If this is enabled, updating the rate of the Product Bundle in the Items table will not change its price. It will get reset to the price based on its Child Items on saving the doc."
msgstr ""
"Սա միացնելով՝ տեղի կունենա հետևյալը.\n"
"<ul style=\"padding-left:16px\">\n"
"<li>Բոլոր փաթեթավորված/համալիր ապրանքների աղյուսակների գնի սյունակը կդառնա խմբագրելի։</li>\n"
"<li>Ապրանքների աղյուսակում բոլոր <a href=\"/desk/product-bundle\" rel=\"noopener noreferrer\">ապրանքային համալիրների</a> գները կհաշվարկվեն դրանց ենթաապրանքների գների հիման վրա, որոնք նշված են փաթեթավորված/համալիր ապրանքների աղյուսակում։ </li>\n"
"</ul>\n"
"Նշում. եթե սա միացված է, ապրանքների աղյուսակում ապրանքային համալիրի գնի թարմացումը չի փոխի դրա գինը։ Փաստաթուղթը պահպանելիս գինը կվերակայվի՝ ըստ ենթաապրանքների գների։"

msgid "Enabling this will register your site on a central relay server to send push notifications for all installed apps through Firebase Cloud Messaging. This server only stores user tokens and error logs, and no messages are saved."
msgstr "Սա միացնելու դեպքում ձեր կայքը կգրանցվի կենտրոնական ռելե սերվերում՝ Firebase Cloud Messaging-ի միջոցով բոլոր տեղադրված հավելվածների համար push ծանուցումներ ուղարկելու նպատակով։ Այս սերվերը պահում է միայն օգտատերերի թոքենները և սխալների մատյանները, հաղորդագրություններ չեն պահվում։"

