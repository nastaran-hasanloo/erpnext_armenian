"\n"
"<pre>&lt;h3&gt;Order Overdue&lt;/h3&gt;\n"
"\n"
"&lt;p&gt;Transaction {{ doc.name }} has exceeded Due Date. Please take necessary action.&lt;/p&gt;\n"
"\n"
"&lt;!-- show last comment --&gt;\n"
"{% if comments %}\n"
"Last comment: {{ comments[-1].comment }} by {{ comments[-1].by }}\n"
"{% endif %}\n"
"\n"
"&lt;h4&gt;Details&lt;/h4&gt;\n"
"\n"
"&lt;ul&gt;\n"
"&lt;li&gt;Customer: {{ doc.customer }}\n"
"&lt;li&gt;Amount: {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"
msgstr ""
"<h5>Հաղորդագրության օրինակ</h5>\n"
"\n"
"<pre>&lt;h3&gt;Պատվերը ժամկետանց է&lt;/h3&gt;\n"
"\n"
"&lt;p&gt;{{ doc.name }} գործարքը գերազանցել է վճարման ժամկետը։ Խնդրում ենք ձեռնարկել անհրաժեշտ քայլեր։&lt;/p&gt;\n"
"\n"
"&lt;!-- ցուցադրել վերջին մեկնաբանությունը --&gt;\n"
"{% if comments %}\n"
"Վերջին մեկնաբանություն՝ {{ comments[-1].comment }} հեղինակ՝ {{ comments[-1].by }}\n"
"{% endif %}\n"
"\n"
"&lt;h4&gt;Մանրամասներ&lt;/h4&gt;\n"
"\n"
"&lt;ul&gt;\n"
"&lt;li&gt;Հաճախորդ՝ {{ doc.customer }}\n"
"&lt;li&gt;Գումար՝ {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"

