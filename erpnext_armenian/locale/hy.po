msgid "The flow's steps as they were when the run started. A resumed run executes these, not the current flow."
msgstr "Հոսքի քայլերն այնպես, ինչպես դրանք էին գործարկման սկզբում։ Վերսկսված գործարկումը կատարում է սրանք, այլ ոչ թե ընթացիկ հոսքը։"

msgid "The folio numbers are not matching"
msgstr "Ֆոլիոյի համարները չեն համընկնում"

