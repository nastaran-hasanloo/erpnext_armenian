msgid "<b>{0}</b> is shipped by its app. Saving this layout keeps your arrangement, and the app's later changes to this page's layout will stop showing up here. Its roles, icon and visibility keep following the app either way, and <b>Reset to Standard</b> undoes this."
msgstr "<b>{0}</b>-ը մատակարարվում է իր հավելվածի կողմից։ Այս դասավորությունը պահպանելով՝ ձեր դասավորությունը կպահպանվի, և հավելվածի հետագա փոփոխությունները այս էջի դասավորության մեջ այլևս չեն երևա այստեղ։ Դրա դերերը, պատկերակը և տեսանելիությունը ամեն դեպքում շարունակում են հետևել հավելվածին, իսկ <b>Վերակայել ստանդարտին</b>-ը չեղարկում է սա։"

msgid ""
"<br>\n"
"<h4>Note</h4>\n"
"<ul>\n"
"<li>\n"
"You can use <a href=\"https://jinja.palletsprojects.com/en/2.11.x/\" target=\"_blank\">Jinja tags</a> in <b>Subject</b> and <b>Body</b> fields for dynamic values.\n"
"</li><li>\n"
"    All fields in this doctype are available under the <b>doc</b> object and all fields for the customer to whom the mail will go to is available under the  <b>customer</b> object.\n"
"</li></ul>\n"
"<h4> Examples</h4>\n"
"<!-- {% raw %} -->\n"
"<ul>\n"
"    <li><b>Subject</b>:<br><br><pre><code>Statement Of Accounts for {{ customer.customer_name }}</code></pre><br></li>\n"
"    <li><b>Body</b>: <br><br>\n"
"<pre><code>Hello {{ customer.customer_name }},<br>PFA your Statement Of Accounts from {{ doc.from_date }} to {{ doc.to_date }}.</code> </pre></li>\n"
"</ul>\n"
"<!-- {% endraw %} -->"
msgstr ""
"<br>\n"
"<h4>Նշում</h4>\n"
"<ul>\n"
"<li>\n"
"Դինամիկ արժեքների համար <a href=\"https://jinja.palletsprojects.com/en/2.11.x/\" target=\"_blank\">Jinja թեգեր</a> կարող եք օգտագործել <b>Թեմա</b> և <b>Բովանդակություն</b> դաշտերում։\n"
"</li><li>\n"
"    Այս doctype-ի բոլոր դաշտերը հասանելի են <b>doc</b> օբյեկտում, իսկ այն հաճախորդի բոլոր դաշտերը, որին ուղարկվելու է նամակը, հասանելի են  <b>customer</b> օբյեկտում։\n"
"</li></ul>\n"
"<h4> Օրինակներ</h4>\n"
"<!-- {% raw %} -->\n"
"<ul>\n"
"    <li><b>Թեմա</b>՝<br><br><pre><code>Հաշվարկների քաղվածք {{ customer.customer_name }}-ի համար</code></pre><br></li>\n"
"    <li><b>Բովանդակություն</b>՝ <br><br>\n"
"<pre><code>Բարև Ձեզ, {{ customer.customer_name }},<br>Կից ներկայացնում ենք Ձեր հաշվարկների քաղվածքը {{ doc.from_date }}-ից {{ doc.to_date }} ժամանակահատվածի համար։</code> </pre></li>\n"
"</ul>\n"
"<!-- {% endraw %} -->"

