msgid "The following batches are expired, please restock them: <br> {0}"
msgstr "Հետևյալ խմբաքանակների պիտանելիության ժամկետն անցել է, խնդրում ենք համալրել դրանք՝ <br> {0}"

msgid "The following cancelled repost entries exist for <b>{0}</b>:<br><br>{1}<br><br>Kindly delete these entries before continuing."
msgstr "<b>{0}</b>-ի համար առկա են հետևյալ չեղարկված վերաձևակերպման գրառումները՝<br><br>{1}<br><br>Խնդրում ենք ջնջել այս գրառումները նախքան շարունակելը։"

msgid "The following configured IMAP folder(s) were not found or are not accessible on the server:<br><ul>{0}</ul>Please verify the folder names exactly as they appear on the server and ensure the account has access to them."
msgstr "Հետևյալ կարգավորված IMAP թղթապանակ(ներ)ը չեն գտնվել կամ հասանելի չեն սերվերում՝<br><ul>{0}</ul>Խնդրում ենք ստուգել թղթապանակների անունները ճիշտ այնպես, ինչպես դրանք երևում են սերվերում, և համոզվել, որ հաշիվն ունի դրանց հասանելիություն։"

msgid "The following deleted attributes exist in Variants but not in the Template. You can either delete the Variants or keep the attribute(s) in template."
msgstr "Հետևյալ ջնջված հատկանիշները առկա են Տարբերակներում, բայց ոչ Ձևանմուշում։ Կարող եք կամ ջնջել Տարբերակները, կամ պահել հատկանիշ(ներ)ը ձևանմուշում։"

msgid "The following employees are currently still reporting to {0}:"
msgstr "Հետևյալ աշխատակիցները դեռևս ենթարկվում են {0}-ին՝"

msgid "The following invalid Pricing Rules are deleted:"
msgstr "Հետևյալ անվավեր գնագոյացման կանոնները ջնջվել են՝"

msgid ""
"The following payment schedule(s) already exist:\n"
"{0}"
msgstr ""
"Հետևյալ վճարման ժամանակացույց(եր)ն արդեն գոյություն ունեն՝\n"
"{0}"

msgid "The following rows are duplicates:"
msgstr "Հետևյալ տողերը կրկնօրինակներ են՝"

msgid "The following rows are not valid fields of {0} and have to be removed: {1}"
msgstr "Հետևյալ տողերը {0}-ի վավեր դաշտեր չեն և պետք է հեռացվեն՝ {1}"

msgid "The following vouchers are not submitted: {0}"
msgstr "Հետևյալ փաստաթղթերը հաստատված չեն՝ {0}"

msgid "The following {0} were created: {1}"
msgstr "Ստեղծվել են հետևյալ {0}՝ {1}"

msgid "The fraction of Daily Salary per Leave should be between 0 and 1"
msgstr "Մեկ արձակուրդային օրվա համար օրական աշխատավարձի մասնաբաժինը պետք է լինի 0-ի և 1-ի միջև"

msgid "The fraction of daily wages to be paid for half-day attendance"
msgstr "Օրական աշխատավարձի մասնաբաժինը, որը վճարվում է կես օրվա ներկայության համար"

msgid "The frequency at which project progress and company transaction details will be updated. Set it to daily or monthly if you post a lot of transactions."
msgstr "Հաճախականությունը, որով կթարմացվեն նախագծի առաջընթացը և ընկերության գործարքների տվյալները։ Սահմանեք օրական կամ ամսական, եթե շատ գործարքներ եք ձևակերպում։"

msgid "The gross weight of the package. Usually net weight + packaging material weight. (for print)"
msgstr "Փաթեթի համախառն քաշը։ Սովորաբար զուտ քաշ + փաթեթավորման նյութի քաշ։ (տպման համար)"

msgid "The holiday on {0} is not between From Date and To Date"
msgstr "{0}-ի տոնական օրը Սկզբի ամսաթվի և Ավարտի ամսաթվի միջև չէ"

msgid "The holidays and weekly offs of a company or employee."
msgstr "Ընկերության կամ աշխատակցի տոնական և շաբաթական հանգստյան օրերը։"

msgid "The invoice is not fully allocated as there is a difference of {0}."
msgstr "Հաշիվ-ապրանքագիրն ամբողջությամբ բաշխված չէ, քանի որ առկա է {0} տարբերություն։"

msgid "The item {item} is not marked as {type_of} item. You can enable it as {type_of} item from its Item master."
msgstr "{item} ապրանքը նշված չէ որպես {type_of} ապրանք։ Կարող եք միացնել այն որպես {type_of} ապրանք դրա Ապրանքի քարտից։"

msgid "The items and quantities to pick from the warehouse."
msgstr "Պահեստից հավաքվելիք ապրանքները և քանակները։"

msgid "The items {0} and {1} are present in the following {2} :"
msgstr "{0} և {1} ապրանքները առկա են հետևյալ {2}-ում՝"

msgid "The items {items} are not marked as {type_of} item. You can enable them as {type_of} item from their Item masters."
msgstr "{items} ապրանքները նշված չեն որպես {type_of} ապրանք։ Կարող եք միացնել դրանք որպես {type_of} ապրանք դրանց Ապրանքի քարտերից։"

msgid "The job card {0} is in {1} state and you cannot complete."
msgstr "{0} աշխատանքային քարտը {1} վիճակում է, և դուք չեք կարող այն ավարտել։"

msgid "The job card {0} is in {1} state and you cannot start it again."
msgstr "{0} աշխատանքային քարտը {1} վիճակում է, և դուք չեք կարող այն կրկին սկսել։"

msgid "The kind of thing you own, marked as a fixed asset. See [Item](https://docs.frappe.io/erpnext/user/manual/en/item)."
msgstr "Ձեր սեփականություն հանդիսացող իրի տեսակը՝ նշված որպես հիմնական միջոց։ Տե՛ս [Item](https://docs.frappe.io/erpnext/user/manual/en/item)։"

msgid "The last account row must not have any debit or credit amounts set."
msgstr "Վերջին հաշվի տողում չպետք է լինեն դեբետային կամ կրեդիտային գումարներ։"

msgid "The last scanned warehouse has been cleared and won't be set in the subsequently scanned items"
msgstr "Վերջին սկանավորված պահեստը մաքրվել է և չի սահմանվի հետագա սկանավորված ապրանքների համար"

msgid "The latest changes could not be saved and will be lost if you leave."
msgstr "Վերջին փոփոխությունները չհաջողվեց պահպանել, և դրանք կկորչեն, եթե լքեք էջը։"

msgid "The latest changes to this letter head are not saved."
msgstr "Այս ձևաթղթի գլխագրի վերջին փոփոխությունները պահպանված չեն։"

msgid "The latest changes to this print format are not saved."
msgstr "Այս տպման ձևաչափի վերջին փոփոխությունները պահպանված չեն։"

msgid "The latest changes to {0} could not be saved."
msgstr "{0}-ի վերջին փոփոխությունները չհաջողվեց պահպանել։"

msgid "The layout of {0} will be rewritten for the new builder. The original layout is kept as a backup you can restore from the Print Format form. Continue?"
msgstr "{0}-ի դասավորությունը կվերագրվի նոր կառուցիչի համար։ Սկզբնական դասավորությունը պահպանվում է որպես պահուստային պատճեն, որը կարող եք վերականգնել Տպման ձևաչափի ձևից։ Շարունակե՞լ։"

msgid "The link expires in 1 minute."
msgstr "Հղումը կսպառվի 1 րոպեից։"

msgid "The link expires in {0} minutes."
msgstr "Հղումը կսպառվի {0} րոպեից։"

msgid "The link you trying to login is invalid or expired."
msgstr "Հղումը, որով փորձում եք մուտք գործել, անվավեր է կամ ժամկետանց։"

msgid "The link {0} was added to a shipped card and cannot be carried by a customization."
msgstr "{0} հղումն ավելացվել է մատակարարված քարտին և չի կարող իրականացվել կարգավորման միջոցով։"

msgid "The lowest tier must have a minimum spent amount of 0. Customers need to be part of a tier as soon as they are enrolled in the program."
msgstr "Ամենացածր մակարդակի նվազագույն ծախսված գումարը պետք է լինի 0։ Հաճախորդները պետք է որևէ մակարդակի մեջ լինեն ծրագրին միանալու պահից։"

msgid "The materials a subcontractor uses to make an item for you."
msgstr "Նյութերը, որոնք ենթակապալառուն օգտագործում է ձեզ համար ապրանք պատրաստելու համար։"

msgid "The materials and operations it takes to make an item."
msgstr "Ապրանքը պատրաստելու համար անհրաժեշտ նյութերը և գործողությունները։"

msgid "The meta description is an HTML attribute that provides a brief summary of a web page. Search engines such as Google often display the meta description in search results, which can influence click-through rates."
msgstr "Մետա նկարագրությունը HTML ատրիբուտ է, որը տրամադրում է վեբ էջի համառոտ ամփոփում։ Որոնողական համակարգերը, ինչպես Google-ը, հաճախ ցուցադրում են մետա նկարագրությունը որոնման արդյունքներում, ինչը կարող է ազդել սեղմումների ցուցանիշի վրա։"

msgid "The meta image is unique image representing the content of the page. Images for this Card should be at least 280px in width, and at least 150px in height."
msgstr "Մետա պատկերը էջի բովանդակությունը ներկայացնող եզակի պատկեր է։ Այս քարտի պատկերները պետք է լինեն առնվազն 280px լայնությամբ և առնվազն 150px բարձրությամբ։"

msgid "The metrics for this report are calculated based on the {0}. Please set {0} in {1}."
msgstr "Այս հաշվետվության ցուցանիշները հաշվարկվում են {0}-ի հիման վրա։ Խնդրում ենք {1}-ում սահմանել {0}։"

msgid "The metrics for this report are calculated based on {0}. Please set {0} in {1}."
msgstr "Այս հաշվետվության ցուցանիշները հաշվարկվում են {0}-ի հիման վրա։ Խնդրում ենք {1}-ում սահմանել {0}։"

msgid "The module this sidebar belongs to. Neither required nor unique: one module may own several sidebars, and which of them answers for the module itself is decided by the name -- the one called after the module -- rather than by a column here. May also be blank, which means the sidebar belongs to its app rather than to any one of the app's modules; such a sidebar is exported to the app's own folder and says which app in `app`."
msgstr "Մոդուլը, որին պատկանում է այս կողային վահանակը։ Ոչ պարտադիր է, ոչ էլ եզակի. մեկ մոդուլը կարող է ունենալ մի քանի կողային վահանակ, և թե դրանցից որն է պատասխանատու հենց մոդուլի համար, որոշվում է անունով՝ մոդուլի անունը կրողը, այլ ոչ թե այստեղի սյունակով։ Կարող է նաև դատարկ լինել, ինչը նշանակում է, որ կողային վահանակը պատկանում է իր հավելվածին, այլ ոչ թե հավելվածի որևէ մոդուլի. նման կողային վահանակն արտահանվում է հավելվածի սեփական թղթապանակ և `app`-ում նշում է, թե որ հավելվածն է։"

msgid "The module this workspace belongs to. Decides which module's dock entry and sidebar it appears under."
msgstr "Մոդուլը, որին պատկանում է այս աշխատանքային տարածքը։ Որոշում է, թե որ մոդուլի dock տարրի և կողային վահանակի տակ այն կհայտնվի։"

msgid "The name that will appear in Google Calendar"
msgstr "Անունը, որը կհայտնվի Google Calendar-ում"

msgid "The net weight of this package. (calculated automatically as sum of net weight of items)"
msgstr "Այս փաթեթի զուտ քաշը։ (ավտոմատ հաշվարկվում է որպես ապրանքների զուտ քաշերի գումար)"

msgid "The new BOM after replacement"
msgstr "Նոր BOM-ը փոխարինումից հետո"

msgid "The next generated name continues after this number."
msgstr "Հաջորդ ստեղծվող անունը կշարունակվի այս համարից հետո։"

msgid "The next tour will start from where the user left off."
msgstr "Հաջորդ շրջայցը կսկսվի այնտեղից, որտեղ օգտատերը կանգ էր առել։"

msgid "The number of seconds until the request expires"
msgstr "Վայրկյանների քանակը, մինչև հարցման ժամկետը սպառվի"

msgid "The number of shares and the share numbers are inconsistent"
msgstr "Բաժնետոմսերի քանակը և բաժնետոմսերի համարները չեն համապատասխանում"

msgid "The opening balance might not match your bank statement. Would you like to reconcile them?"
msgstr "Սկզբնական մնացորդը կարող է չհամապատասխանել ձեր բանկային քաղվածքին։ Ցանկանո՞ւմ եք դրանք համադրել։"

msgid "The operation {0} can not add multiple times"
msgstr "{0} գործողությունը չի կարող ավելացվել մի քանի անգամ"

msgid "The operation {0} can not be the sub operation"
msgstr "{0} գործողությունը չի կարող լինել ենթագործողություն"

msgid "The order of operations to make an item."
msgstr "Ապրանքը պատրաստելու գործողությունների հերթականությունը։"

msgid "The ordered entries this layer has an opinion about. Row order is the arrangement; an entry this layer never names keeps its incoming order and follows the ones it does, which is how a newly installed app's modules still reach someone who has already arranged their dock."
msgstr "Դասավորված տարրերը, որոնց վերաբերյալ այս շերտն ունի կարծիք։ Տողերի հերթականությունը հենց դասավորությունն է. այն տարրը, որը այս շերտը երբեք չի նշում, պահպանում է իր մուտքային հերթականությունը և հետևում է նշվածներին. այսպես նոր տեղադրված հավելվածի մոդուլները դեռ հասնում են նրան, ով արդեն դասավորել է իր dock-ը։"

msgid "The original invoice should be consolidated before or along with the return invoice."
msgstr "Սկզբնական հաշիվ-ապրանքագիրը պետք է համախմբվի վերադարձի հաշիվ-ապրանքագրից առաջ կամ դրա հետ միասին։"

msgid "The outstanding amount {0} in {1} is lesser than {2}. Updating the outstanding to this invoice."
msgstr "{1}-ում {0} չմարված գումարը փոքր է {2}-ից։ Չմարված գումարը թարմացվում է այս հաշիվ-ապրանքագրի համար։"

msgid "The parameters to check an item for."
msgstr "Ապրանքի ստուգման պարամետրերը։"

msgid "The parameters to inspect and what counts as a pass, reused on every inspection. See [Quality Inspection Template](https://docs.frappe.io/erpnext/user/manual/en/quality-inspection-template)."
msgstr "Ստուգվող պարամետրերը և այն, թե ինչն է համարվում անցած, որոնք կրկին օգտագործվում են յուրաքանչյուր ստուգման ժամանակ։ Տե՛ս [Quality Inspection Template](https://docs.frappe.io/erpnext/user/manual/en/quality-inspection-template)։"

msgid "The parent account {0} does not exists in the uploaded template"
msgstr "{0} ծնող հաշիվը գոյություն չունի վերբեռնված ձևանմուշում"

msgid "The payment gateway account in plan {0} is different from the payment gateway account in this payment request"
msgstr "{0} պլանի վճարային դարպասի հաշիվը տարբերվում է այս վճարման հարցման վճարային դարպասի հաշվից"

msgid "The people responsible for maintaining assets."
msgstr "Ակտիվների սպասարկման համար պատասխանատու անձինք։"

msgid "The people you manage, with their joining date, department and reporting manager. See [Employee](https://docs.frappe.io/hr/employee)."
msgstr "Ձեր աշխատակիցները՝ աշխատանքի ընդունման ամսաթվով, ստորաբաժանումով և անմիջական ղեկավարով։ Տե՛ս [Աշխատակից](https://docs.frappe.io/hr/employee)։"

msgid "The percentage by which you are allowed to order more on a Purchase Order than the quantity requested on the originating Material Request. For example, if the Material Request has 100 units and the allowance is 10%, you can order up to 110 units"
msgstr "Տոկոսը, որով թույլատրվում է Գնման պատվերում պատվիրել ավելին, քան սկզբնական Նյութերի հայտում պահանջված քանակն է։ Օրինակ՝ եթե Նյութերի հայտում 100 միավոր է, և թույլատրելի շեղումը 10% է, կարող եք պատվիրել մինչև 110 միավոր"

msgid "The percentage you are allowed to bill more against the amount ordered. For example, if the order value is $100 for an item and tolerance is set as 10%, then you are allowed to bill up to $110 "
msgstr "Տոկոսը, որով թույլատրվում է հաշվարկել պատվիրված գումարից ավելին։ Օրինակ՝ եթե ապրանքի պատվերի արժեքը $100 է, և շեղումը սահմանված է 10%, ապա թույլատրվում է հաշվարկել մինչև $110 "

msgid "The percentage you are allowed to pick more items in the pick list than the ordered quantity."
msgstr "Տոկոսը, որով թույլատրվում է հավաքման ցանկում հավաքել ավելի շատ ապրանքներ, քան պատվիրված քանակն է։"

msgid "The percentage you are allowed to receive or deliver more against the quantity ordered. For example, if you have ordered 100 units, and your Allowance is 10%, then you are allowed to receive 110 units."
msgstr "Տոկոսը, որով թույլատրվում է ստանալ կամ առաքել պատվիրված քանակից ավելին։ Օրինակ՝ եթե պատվիրել եք 100 միավոր, և ձեր թույլատրելի շեղումը 10% է, ապա թույլատրվում է ստանալ 110 միավոր։"

msgid "The percentage you are allowed to transfer more against the quantity ordered. For example, if you have ordered 100 units, and your Allowance is 10%, then you are allowed transfer 110 units."
msgstr "Տոկոսը, որով թույլատրվում է տեղափոխել պատվիրված քանակից ավելին։ Օրինակ՝ եթե պատվիրել եք 100 միավոր, և ձեր թույլատրելի շեղումը 10% է, ապա թույլատրվում է տեղափոխել 110 միավոր։"

msgid "The person whose own arrangement this is. Blank means the app's own dock or the site's arrangement of it, told apart by `standard`."
msgstr "Անձը, որի սեփական դասավորությունն է սա։ Դատարկը նշանակում է հավելվածի սեփական dock-ը կամ կայքի կողմից դրա դասավորությունը, որոնք տարբերակվում են `standard`-ով։"

msgid "The price of an item in a price list."
msgstr "Ապրանքի գինը գնացուցակում։"

msgid "The print button is enabled for the user in the document."
msgstr "Տպելու կոճակը միացված է օգտատիրոջ համար փաստաթղթում։"

msgid "The process for deletion of {0} data associated with {1} has been initiated."
msgstr "{1}-ի հետ կապված {0} տվյալների ջնջման գործընթացը սկսվել է։"

msgid "The progress of a BOM replacement or cost update."
msgstr "BOM-ի փոխարինման կամ արժեքի թարմացման առաջընթացը։"

msgid ""
"The project number obtained from Google Cloud Console under <a href=\"https://console.cloud.google.com/iam-admin/settings\">\n"
"\"IAM &amp; Admin\" &gt; \"Settings\"\n"
"</a>"
msgstr ""
"Google Cloud Console-ից ստացված նախագծի համարը՝ <a href=\"https://console.cloud.google.com/iam-admin/settings\">\n"
"\"IAM &amp; Admin\" &gt; \"Settings\"\n"
"</a> բաժնում"

msgid "The questions to ask when collecting quality feedback."
msgstr "Որակի վերաբերյալ կարծիքներ հավաքելիս տրվող հարցերը։"

msgid "The rate at which this item was last purchased via a Purchase Invoice. Auto-updated by the system."
msgstr "Գինը, որով այս ապրանքը վերջին անգամ գնվել է Գնման հաշիվ-ապրանքագրի միջոցով։ Ավտոմատ թարմացվում է համակարգի կողմից։"

msgid "The rate to convert one currency into another."
msgstr "Մեկ արժույթը մյուսին փոխարկելու փոխարժեքը։"

msgid ""
"The raw materials, and how much of each, that go into one unit of your product. Submit it to use it in production. See [BOM](https://docs.frappe.io/erpnext/user/manual/en/bill-of-materials).\n"
"\n"
"Sending some of the work to a supplier? See [Subcontracting](https://docs.frappe.io/erpnext/user/manual/en/subcontracting)."
msgstr ""
"Հումքը և դրա քանակը, որոնք անհրաժեշտ են ձեր արտադրանքի մեկ միավորի համար։ Հաստատեք այն՝ արտադրությունում օգտագործելու համար։ Տե՛ս [BOM](https://docs.frappe.io/erpnext/user/manual/en/bill-of-materials)։\n"
"\n"
"Աշխատանքի մի մասն ուղարկո՞ւմ եք մատակարարին։ Տե՛ս [Subcontracting](https://docs.frappe.io/erpnext/user/manual/en/subcontracting)։"

msgid "The record this entry opens, in the doctype `link_type` names. A `Sidebar` target need not exist as a document: most modules have a computed base and no `Sidebar` row at all, so a row of that kind names a shell rather than referencing one, which is why link validation on a `Dock` is a deliberate no-op."
msgstr "Գրառումը, որը բացում է այս տարրը՝ `link_type`-ում նշված doctype-ում։ `Sidebar` թիրախը պարտադիր չէ, որ գոյություն ունենա որպես փաստաթուղթ. մոդուլների մեծ մասն ունի հաշվարկված հիմք և ընդհանրապես չունի `Sidebar` տող, ուստի այդ տեսակի տողը անվանում է շրջանակ, այլ ոչ թե հղում անում դրան. ահա թե ինչու `Dock`-ի հղումների վավերացումը միտումնավոր ոչինչ չի անում։"

msgid "The reference number of the transaction"
msgstr "Գործարքի հղման համարը"

msgid "The report may be too large to render in a single request. Narrow the filters and try again, or use Print and save as PDF from your browser."
msgstr "Հաշվետվությունը կարող է չափազանց մեծ լինել մեկ հարցմամբ արտապատկերելու համար։ Նեղացրեք ֆիլտրերը և կրկին փորձեք կամ օգտագործեք Տպել և պահպանեք որպես PDF Ձեր դիտարկիչից։"

msgid "The report you requested has been generated.<br><br>Click here to download:<br><a href='{0}'>{0}</a><br><br>This link will expire in {1} hours."
msgstr "Ձեր պահանջած հաշվետվությունը ստեղծվել է։<br><br>Սեղմեք այստեղ՝ ներբեռնելու համար՝<br><a href='{0}'>{0}</a><br><br>Այս հղումը կսպառվի {1} ժամից։"

msgid "The request could not be completed. Check your connection and try again."
msgstr "Հարցումը չհաջողվեց ավարտել։ Ստուգեք Ձեր կապը և կրկին փորձեք։"

msgid "The reserved stock will be released when you update items. Are you certain you wish to proceed?"
msgstr "Ապրանքները թարմացնելիս ամրագրված պաշարը կազատվի։ Համոզվա՞ծ եք, որ ցանկանում եք շարունակել։"

msgid "The reserved stock will be released. Are you certain you wish to proceed?"
msgstr "Ամրագրված պաշարը կազատվի։ Համոզվա՞ծ եք, որ ցանկանում եք շարունակել։"

msgid "The reset password link has been expired"
msgstr "Գաղտնաբառի վերակայման հղումը ժամկետանց է"

msgid "The reset password link has either been used before or is invalid"
msgstr "Գաղտնաբառի վերակայման հղումը կամ արդեն օգտագործվել է, կամ անվավեր է"

msgid "The resource you are looking for is not available"
msgstr "Ձեր փնտրած ռեսուրսը հասանելի չէ"

msgid "The result of creating or submitting many documents at once."
msgstr "Միաժամանակ բազմաթիվ փաստաթղթեր ստեղծելու կամ հաստատելու արդյունքը։"

msgid "The root account {0} must be a group"
msgstr "{0} արմատային հաշիվը պետք է լինի խումբ"

msgid "The rows and formulas of a custom financial statement."
msgstr "Անհատական ֆինանսական հաշվետվության տողերը և բանաձևերը։"

msgid "The rows of Item {0} in Warehouse {1} are not the stock it should hold on this date. Make the Adjustment Entry again from the Stock Valuation Comparison report."
msgstr "{1} պահեստում {0} ապրանքի տողերը չեն համապատասխանում այն պաշարին, որը պետք է լինի այս ամսաթվի դրությամբ։ Կրկին կատարեք ճշգրտման գրառումը Պաշարների գնահատման համեմատության հաշվետվությունից։"

msgid "The salary slip emailed to the employee will be password protected, the password will be generated based on the password policy."
msgstr "Աշխատակցին էլ. փոստով ուղարկվող աշխատավարձի թերթիկը պաշտպանված կլինի գաղտնաբառով, որը կստեղծվի գաղտնաբառի քաղաքականության համաձայն։"

msgid "The selected BOMs are not for the same item"
msgstr "Ընտրված BOM-երը նույն ապրանքի համար չեն"

msgid "The selected change account {} doesn't belongs to Company {}."
msgstr "Ընտրված մանրադրամի հաշիվը {} չի պատկանում {} ընկերությանը։"

msgid "The selected document {0} is not a {1}."
msgstr "Ընտրված {0} փաստաթուղթը {1} չէ։"

msgid "The selected item cannot have Batch"
msgstr "Ընտրված ապրանքը չի կարող ունենալ խմբաքանակ"

msgid "The sell quantity is less than the total asset quantity. The remaining quantity will be split into a new asset. This action cannot be undone. <br><br><b>Do you want to continue?</b>"
msgstr "Վաճառքի քանակը փոքր է ակտիվի ընդհանուր քանակից։ Մնացած քանակը կառանձնացվի նոր ակտիվի մեջ։ Այս գործողությունը հնարավոր չէ հետարկել։ <br><br><b>Ցանկանո՞ւմ եք շարունակել։</b>"

msgid "The seller and the buyer cannot be the same"
msgstr "Վաճառողը և գնորդը չեն կարող նույնը լինել"

msgid "The serial and batch bundle {0} not linked to {1} {2}"
msgstr "{0} սերիական համարների և խմբաքանակների փաթեթը կապված չէ {1} {2}-ի հետ"

msgid "The serial no {0} does not belong to item {1}"
msgstr "{0} սերիական համարը չի պատկանում {1} ապրանքին"

msgid "The serial numbers and batches moved in a transaction."
msgstr "Գործարքում տեղափոխված սերիական համարները և խմբաքանակները։"

msgid "The shareholder does not belong to this company"
msgstr "Բաժնետերը չի պատկանում այս ընկերությանը"

msgid "The shares already exist"
msgstr "Բաժնետոմսերն արդեն գոյություն ունեն"

msgid "The shares don't exist with the {0}"
msgstr "{0}-ով բաժնետոմսեր գոյություն չունեն"

msgid "The sidebar as this arrangement leaves it."
msgstr "Կողային վահանակը այնպես, ինչպես այս դասավորությունն է թողնում։"

msgid "The site's editor.js block layout for this workspace, shown verbatim. Once set, the app's later changes to this workspace's layout stop reaching the site; roles, icon and visibility keep updating. Managed by the workspace editor."
msgstr "Այս աշխատանքային տարածքի համար կայքի editor.js բլոկների դասավորությունը՝ ցուցադրված բառացի։ Սահմանվելուց հետո հավելվածի հետագա փոփոխություններն այս աշխատանքային տարածքի դասավորությունում այլևս չեն հասնում կայքին. դերերը, պատկերակը և տեսանելիությունը շարունակում են թարմացվել։ Կառավարվում է աշխատանքային տարածքի խմբագրիչի կողմից։"

msgid "The standard chart for your country works for most businesses."
msgstr "Ձեր երկրի ստանդարտ հաշվային պլանը հարմար է բիզնեսների մեծ մասի համար։"

msgid "The step condition that skipped this step."
msgstr "Քայլի պայմանը, որի պատճառով այս քայլը բաց է թողնվել։"

msgid "The steps of a process you follow to keep quality in check."
msgstr "Որակը վերահսկելու համար ձեր կողմից կատարվող գործընթացի քայլերը։"

msgid "The steps your team follows, so it is done the same way every time. See [Quality Management](https://docs.frappe.io/erpnext/user/manual/en/quality-management)."
msgstr "Ձեր թիմի կատարած քայլերը, որպեսզի աշխատանքը ամեն անգամ կատարվի նույն կերպ։ Տե՛ս [Quality Management](https://docs.frappe.io/erpnext/user/manual/en/quality-management)։"

msgid "The stock for the item {0} in the {1} warehouse was negative on the {2}. You should create a positive entry {3} before the date {4} and time {5} to post the correct valuation rate. For more details, please read the <a href='https://docs.erpnext.com/docs/user/manual/en/stock-adjustment-cogs-with-negative-stock'>documentation<a>."
msgstr "{0} ապրանքի պաշարը {1} պահեստում բացասական է եղել {2}-ին։ Ճիշտ գնահատման գինը ձևակերպելու համար պետք է ստեղծեք դրական գրառում {3} մինչև {4} ամսաթիվը և {5} ժամը։ Մանրամասների համար խնդրում ենք կարդալ <a href='https://docs.erpnext.com/docs/user/manual/en/stock-adjustment-cogs-with-negative-stock'>փաստաթղթերը<a>։"

msgid "The stock has been reserved for the following Items and Warehouses, un-reserve the same to {0} the Stock Reconciliation: <br /><br /> {1}"
msgstr "Պաշարն ամրագրված է հետևյալ ապրանքների և պահեստների համար. Պաշարների համադրումը {0} համար հանեք ամրագրումը՝ <br /><br /> {1}"

msgid "The stock qty and value of the selected items are set right on this date, without reposting. Stock and accounting reports before it keep the old values, and no stock transaction can be posted before it for these items afterwards."
msgstr "Ընտրված ապրանքների պաշարի քանակը և արժեքը ճշգրտվում են այս ամսաթվի դրությամբ՝ առանց վերաձևակերպման։ Մինչ այդ ամսաթիվը պահեստային և հաշվապահական հաշվետվությունները պահպանում են հին արժեքները, և այսուհետ այս ապրանքների համար որևէ պահեստային գործարք չի կարող ձևակերպվել այդ ամսաթվից առաջ։"

msgid "The sync has started in the background, please check the {0} list for new records."
msgstr "Համաժամեցումը սկսվել է ֆոնային ռեժիմում, խնդրում ենք ստուգել {0} ցանկը նոր գրառումների համար։"

msgid "The system found a mirror transaction ({0}) in another account with the same amount and date."
msgstr "Համակարգը մեկ այլ հաշվում գտել է նույն գումարով և ամսաթվով հայելային գործարք ({0})։"

msgid "The system is being updated. Please refresh again after a few moments."
msgstr "Համակարգը թարմացվում է։ Խնդրում ենք մի քանի պահից կրկին թարմացնել էջը։"

msgid "The system provides many pre-defined roles. You can add new roles to set finer permissions."
msgstr "Համակարգը տրամադրում է բազմաթիվ նախասահմանված դերեր։ Կարող եք ավելացնել նոր դերեր՝ ավելի մանրամասն թույլտվություններ սահմանելու համար։"

msgid "The system will attempt to automatically match a party to a bank transaction based on account number or IBAN."
msgstr "Համակարգը կփորձի ավտոմատ համապատասխանեցնել կողմը բանկային գործարքին՝ հիմնվելով հաշվի համարի կամ IBAN-ի վրա։"

msgid "The system will create a Sales Invoice or a POS Invoice from the POS interface based on this setting. For high-volume transactions, it is recommended to use POS Invoice."
msgstr "Այս կարգավորման հիման վրա համակարգը POS ինտերֆեյսից կստեղծի Վաճառքի հաշիվ-ապրանքագիր կամ POS հաշիվ-ապրանքագիր։ Մեծ ծավալի գործարքների համար խորհուրդ է տրվում օգտագործել POS հաշիվ-ապրանքագիր։"

msgid "The tariff code an item is declared under at customs."
msgstr "Մաքսային ծածկագիրը, որով ապրանքը հայտարարագրվում է մաքսատանը։"

msgid "The task has been enqueued as a background job. In case there is any issue on processing in background, the system will add a comment about the error on this Stock Reconciliation and revert to the Draft stage"
msgstr "Առաջադրանքը հերթագրվել է որպես ֆոնային աշխատանք։ Ֆոնային մշակման ընթացքում խնդրի դեպքում համակարգը այս Պաշարների համադրման վրա կավելացնի մեկնաբանություն սխալի մասին և կվերադարձնի այն Սևագիր փուլ"

msgid "The task has been enqueued as a background job. In case there is any issue on processing in background, the system will add a comment about the error on this Stock Reconciliation and revert to the Submitted stage"
msgstr "Առաջադրանքը հերթագրվել է որպես ֆոնային աշխատանք։ Ֆոնային մշակման ընթացքում խնդրի դեպքում համակարգը այս Պաշարների համադրման վրա կավելացնի մեկնաբանություն սխալի մասին և կվերադարձնի այն Հաստատված փուլ"

msgid "The taxes and charges, like shipping or insurance, to add to purchases."
msgstr "Գնումներին ավելացվող հարկերը և վճարները, օրինակ՝ առաքում կամ ապահովագրություն։"

msgid "The taxes and charges, like shipping or insurance, to add to sales."
msgstr "Վաճառքներին ավելացվող հարկերը և վճարները, օրինակ՝ առաքում կամ ապահովագրություն։"

msgid "The taxes that fill in on every invoice. We added your country's where we had them; check the rates match what you charge. Purchase taxes live in [Purchase Taxes and Charges Template](/desk/purchase-taxes-and-charges-template). See [Setting Up Taxes](https://docs.frappe.io/erpnext/user/manual/en/setting-up-taxes)."
msgstr "Հարկերը, որոնք լրացվում են յուրաքանչյուր հաշիվ-ապրանքագրում։ Մենք ավելացրել ենք ձեր երկրի հարկերը, որտեղ դրանք ունեինք. ստուգեք, որ դրույքները համապատասխանում են ձեր կիրառածին։ Գնումների հարկերը գտնվում են [Purchase Taxes and Charges Template](/desk/purchase-taxes-and-charges-template)-ում։ Տե՛ս [Setting Up Taxes](https://docs.frappe.io/erpnext/user/manual/en/setting-up-taxes)։"

msgid "The time after the shift start time when check-in is considered as late (in minutes)."
msgstr "Հերթափոխի սկզբից հետո այն ժամանակը, որից հետո գրանցումը համարվում է ուշացած (րոպեներով)։"

msgid "The time before the shift end time when check-out is considered as early (in minutes)."
msgstr "Հերթափոխի ավարտից առաջ այն ժամանակը, որից առաջ դուրսգրանցումը համարվում է վաղաժամ (րոպեներով)։"

msgid "The time before the shift start time during which Employee Check-in is considered for attendance."
msgstr "Հերթափոխի սկզբից առաջ այն ժամանակահատվածը, որի ընթացքում աշխատակցի գրանցումը հաշվի է առնվում ներկայության համար։"

msgid "The title of a standard workspace is managed by the app."
msgstr "Ստանդարտ աշխատանքային տարածքի վերնագիրը կառավարվում է հավելվածի կողմից։"

msgid "The total Issue / Transfer quantity {0} in Material Request {1}  cannot be greater than allowed requested quantity {2} for Item {3}"
msgstr "{1} նյութերի հայտում ընդհանուր Թողարկման / Տեղափոխման քանակը՝ {0},  չի կարող գերազանցել {3} ապրանքի համար թույլատրելի պահանջված քանակը՝ {2}"

msgid "The total Issue / Transfer quantity {0} in Material Request {1} cannot be greater than requested quantity {2} for Item {3}"
msgstr "{1} նյութերի հայտում ընդհանուր Թողարկման / Տեղափոխման քանակը՝ {0}, չի կարող գերազանցել {3} ապրանքի համար պահանջված քանակը՝ {2}"

msgid "The upkeep tasks an asset needs, and who does them."
msgstr "Ակտիվի սպասարկման համար անհրաժեշտ աշխատանքները և դրանք կատարողները։"

msgid "The uploaded file could not be parsed as a genericode XML document."
msgstr "Վերբեռնված ֆայլը հնարավոր չեղավ վերլուծել որպես genericode XML փաստաթուղթ։"

msgid "The uploaded file does not appear to be in valid MT940 format."
msgstr "Վերբեռնված ֆայլը, ըստ երևույթին, վավեր MT940 ձևաչափով չէ։"

msgid "The uploaded file does not match the selected Code List."
msgstr "Վերբեռնված ֆայլը չի համապատասխանում ընտրված կոդերի ցանկին։"

msgid "The user can create a new Item but cannot edit existing items."
msgstr "Օգտատերը կարող է ստեղծել նոր Ապրանք, բայց չի կարող խմբագրել առկա ապրանքները։"

msgid "The user can delete Draft / Cancelled documents."
msgstr "Օգտատերը կարող է ջնջել Սևագիր / Չեղարկված փաստաթղթերը։"

msgid "The user can export report data."
msgstr "Օգտատերը կարող է արտահանել հաշվետվության տվյալները։"

msgid "The user can import new records or update existing data for the document."
msgstr "Օգտատերը կարող է ներմուծել նոր գրառումներ կամ թարմացնել փաստաթղթի առկա տվյալները։"

msgid "The user can select a Customer in Sales Order but cannot open the Customer master."
msgstr "Օգտատերը կարող է ընտրել Հաճախորդ Վաճառքի պատվերում, բայց չի կարող բացել Հաճախորդի քարտը։"

msgid "The user can share document access with another user."
msgstr "Օգտատերը կարող է կիսվել փաստաթղթի հասանելիությամբ այլ օգտատիրոջ հետ։"

msgid "The user can update a customer or any other fields in an existing Sales Order but cannot create a new Sales Order."
msgstr "Օգտատերը կարող է թարմացնել հաճախորդին կամ ցանկացած այլ դաշտ առկա Վաճառքի պատվերում, բայց չի կարող ստեղծել նոր Վաճառքի պատվեր։"

msgid "The user can view Sales Invoices but cannot modify any field values in them."
msgstr "Օգտատերը կարող է դիտել Վաճառքի հաշիվ-ապրանքագրերը, բայց չի կարող փոփոխել դրանց դաշտերի արժեքները։"

msgid "The user cannot submit the Serial and Batch Bundle manually"
msgstr "Օգտատերը չի կարող ձեռքով հաստատել Սերիական համարների և խմբաքանակների փաթեթը"

msgid "The user will be able to transfer additional materials from the store to the Work in Progress (WIP) warehouse."
msgstr "Օգտատերը կկարողանա լրացուցիչ նյութեր տեղափոխել պահեստից Անավարտ արտադրության (WIP) պահեստ։"

msgid "The users with this Role are allowed to create/modify a stock transaction, even though the transaction is frozen."
msgstr "Այս դերով օգտատերերին թույլատրվում է ստեղծել/փոփոխել պահեստային գործարք, նույնիսկ եթե գործարքը սառեցված է։"

msgid "The value of the field {0} is too long in the {1} document. To resolve this issue, please reduce the value length or change the {0} field Type to Long Text using customize form, and then try again."
msgstr "{0} դաշտի արժեքը չափազանց երկար է {1} փաստաթղթում։ Այս խնդիրը լուծելու համար խնդրում ենք կրճատել արժեքի երկարությունը կամ Ձևի կարգավորման միջոցով փոխել {0} դաշտի տեսակը Long Text-ի, ապա կրկին փորձել։"

msgid "The value of {0} differs between Items {1} and {2}"
msgstr "{0}-ի արժեքը տարբերվում է {1} և {2} ապրանքների միջև"

msgid "The value you pasted was {0} characters long. Max allowed characters is {1}."
msgstr "Ձեր տեղադրած արժեքը {0} նիշ երկարություն ուներ։ Թույլատրելի առավելագույն նիշերը {1} են։"

msgid "The value {0} is already assigned to an existing Item {1}."
