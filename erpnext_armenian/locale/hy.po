msgstr "Տող #{0}: {1} պահեստի համար {2} վերապատվիրման տեսակով վերապատվիրման գրառում արդեն գոյություն ունի։"

msgid "Row #{0}: Acceptance Criteria Formula is incorrect."
msgstr "Տող #{0}: Ընդունման չափանիշների բանաձևը սխալ է։"

msgid "Row #{0}: Acceptance Criteria Formula is required."
msgstr "Տող #{0}: Ընդունման չափանիշների բանաձևը պարտադիր է։"

msgid "Row #{0}: Accepted Warehouse and Rejected Warehouse cannot be same"
msgstr "Տող #{0}: Ընդունված ապրանքների պահեստը և մերժված ապրանքների պահեստը չեն կարող նույնը լինել"

msgid "Row #{0}: Accepted Warehouse is mandatory for the accepted Item {1}"
msgstr "Տող #{0}: Ընդունված ապրանքների պահեստը պարտադիր է ընդունված {1} ապրանքի համար"

msgid "Row #{0}: Account {1} does not belong to company {2}"
msgstr "Տող #{0}: {1} հաշիվը չի պատկանում {2} ընկերությանը"

msgid "Row #{0}: Allocated Amount cannot be greater than Outstanding Amount of Payment Request {1}"
msgstr "Տող #{0}: Բաշխված գումարը չի կարող գերազանցել {1} վճարման հարցման չմարված գումարը"

msgid "Row #{0}: Allocated Amount cannot be greater than outstanding amount."
msgstr "Տող #{0}: Բաշխված գումարը չի կարող գերազանցել չմարված գումարը։"

msgid "Row #{0}: Allocated amount:{1} is greater than outstanding amount:{2} for Payment Term {3}"
msgstr "Տող #{0}: Բաշխված գումարը՝ {1}, գերազանցում է չմարված գումարը՝ {2}, {3} վճարման պայմանի համար"

msgid "Row #{0}: Amount must be a positive number"
msgstr "Տող #{0}: Գումարը պետք է լինի դրական թիվ"

msgid "Row #{0}: Asset {1} cannot be sold, it is already {2}"
msgstr "Տող #{0}: {1} ակտիվը հնարավոր չէ վաճառել, այն արդեն {2} է"

msgid "Row #{0}: Asset {1} is already sold"
msgstr "Տող #{0}: {1} ակտիվն արդեն վաճառված է"

msgid "Row #{0}: BOM is not specified for subcontracting item {0}"
msgstr "Տող #{0}: BOM-ը նշված չէ {0} ենթապայմանագրային ապրանքի համար"

msgid "Row #{0}: BOM not found for FG Item {1}"
msgstr "Տող #{0}: BOM-ը չի գտնվել {1} պատրաստի արտադրանքի համար"

msgid "Row #{0}: Batch No {1} is already selected."
msgstr "Տող #{0}: {1} խմբաքանակի համարն արդեն ընտրված է։"

msgid "Row #{0}: Batch No(s) {1} is not a part of the linked Subcontracting Inward Order. Please select valid Batch No(s)."
msgstr "Տող #{0}: {1} խմբաքանակի համար(ներ)ը կապակցված ենթապայմանագրային մուտքային պատվերի մաս չեն։ Խնդրում ենք ընտրել վավեր խմբաքանակի համար(ներ)։"

msgid "Row #{0}: Cannot allocate more than {1} against payment term {2}"
msgstr "Տող #{0}: Հնարավոր չէ բաշխել ավելի քան {1} {2} վճարման պայմանի դիմաց"

msgid "Row #{0}: Cannot cancel this Manufacturing Stock Entry as billed quantity of Item {1} cannot be greater than consumed quantity."
msgstr "Տող #{0}: Հնարավոր չէ չեղարկել այս արտադրական պահեստային գործառնությունը, քանի որ {1} ապրանքի հաշվարկված քանակը չի կարող գերազանցել սպառված քանակը։"

msgid "Row #{0}: Cannot cancel this Manufacturing Stock Entry as quantity of Secondary Item {1} produced cannot be less than quantity delivered."
msgstr "Տող #{0}: Հնարավոր չէ չեղարկել այս արտադրական պահեստային գործառնությունը, քանի որ {1} երկրորդային ապրանքի արտադրված քանակը չի կարող փոքր լինել առաքված քանակից։"

msgid "Row #{0}: Cannot cancel this Stock Entry as returned quantity cannot be greater than delivered quantity for Item {1} in the linked Subcontracting Inward Order"
msgstr "Տող #{0}: Հնարավոր չէ չեղարկել այս պահեստային գործառնությունը, քանի որ վերադարձված քանակը չի կարող գերազանցել առաքված քանակը {1} ապրանքի համար կապակցված ենթապայմանագրային մուտքային պատվերում"

msgid "Row #{0}: Cannot change the UOM or conversion factor of Item {1} after part of it was received or delivered."
msgstr "Տող #{0}: Հնարավոր չէ փոխել {1} ապրանքի Չ/մ-ն կամ փոխարկման գործակիցը, երբ դրա մի մասն արդեն ստացվել կամ առաքվել է։"

msgid "Row #{0}: Cannot create entry with different taxable AND withholding document links."
msgstr "Տող #{0}: Հնարավոր չէ ստեղծել գրառում տարբեր հարկվող ԵՎ պահման փաստաթղթերի հղումներով։"

msgid "Row #{0}: Cannot delete item {1} which has already been billed."
msgstr "Տող #{0}: Հնարավոր չէ ջնջել {1} ապրանքը, որն արդեն հաշվարկված է։"

msgid "Row #{0}: Cannot delete item {1} which has already been delivered"
msgstr "Տող #{0}: Հնարավոր չէ ջնջել {1} ապրանքը, որն արդեն առաքված է"

msgid "Row #{0}: Cannot delete item {1} which has already been received"
msgstr "Տող #{0}: Հնարավոր չէ ջնջել {1} ապրանքը, որն արդեն ստացված է"

msgid "Row #{0}: Cannot delete item {1} which has work order assigned to it."
msgstr "Տող #{0}: Հնարավոր չէ ջնջել {1} ապրանքը, որին նշանակված է արտադրական պատվեր։"

msgid "Row #{0}: Cannot delete item {1} which is already ordered against this Sales Order."
msgstr "Տող #{0}: Հնարավոր չէ ջնջել {1} ապրանքը, որն արդեն պատվիրված է այս վաճառքի պատվերի դիմաց։"

msgid "Row #{0}: Cannot return {1} of Batch {2}, only {3} was delivered and not returned yet."
msgstr "Տող #{0}: Հնարավոր չէ վերադարձնել {2} խմբաքանակից {1}, առաքվել և դեռ չի վերադարձվել միայն {3}։"

msgid "Row #{0}: Cannot set Rate if the billed amount is greater than the amount for Item {1}."
msgstr "Տող #{0}: Հնարավոր չէ սահմանել գինը, եթե հաշվարկված գումարը գերազանցում է {1} ապրանքի գումարը։"

msgid "Row #{0}: Cannot set amount or formula for Salary Component {1} with Variable Based On Taxable Salary"
msgstr "Տող #{0}: Հնարավոր չէ սահմանել գումար կամ բանաձև {1} աշխատավարձի բաղադրիչի համար, որն ունի «Փոփոխական՝ հիմնված հարկվող աշխատավարձի վրա» նշումը"

msgid "Row #{0}: Cannot transfer more than Required Qty {1} for Item {2} against Job Card {3}"
msgstr "Տող #{0}: Հնարավոր չէ տեղափոխել ավելի քան {1} պահանջվող քանակը {2} ապրանքի համար {3} աշխատանքային քարտի դիմաց"

msgid "Row #{0}: Cannot transfer {1} {2} of Item {3}. Maximum transferable quantity is {4} {2}."
msgstr "Տող #{0}: Հնարավոր չէ տեղափոխել {3} ապրանքից {1} {2}։ Առավելագույն տեղափոխելի քանակն է {4} {2}։"

msgid "Row #{0}: Child Item should not be a Product Bundle. Please remove Item {1} and Save"
msgstr "Տող #{0}: Ենթատարր ապրանքը չպետք է լինի ապրանքների փաթեթ։ Խնդրում ենք հեռացնել {1} ապրանքը և պահպանել"

msgid "Row #{0}: Company {1} does not match with the company {2} in Serial and Batch Bundle {3}."
msgstr "Տող #{0}: {1} ընկերությունը չի համապատասխանում {3} սերիական համարների և խմբաքանակների փաթեթի {2} ընկերությանը։"

msgid "Row #{0}: Consumed Asset {1} cannot be Draft"
msgstr "Տող #{0}: Սպառված {1} ակտիվը չի կարող սևագիր լինել"

msgid "Row #{0}: Consumed Asset {1} cannot be cancelled"
msgstr "Տող #{0}: Սպառված {1} ակտիվը հնարավոր չէ չեղարկել"

msgid "Row #{0}: Consumed Asset {1} cannot be the same as the Target Asset"
msgstr "Տող #{0}: Սպառված {1} ակտիվը չի կարող նույնը լինել, ինչ նպատակային ակտիվը"

msgid "Row #{0}: Consumed Asset {1} cannot be {2}"
msgstr "Տող #{0}: Սպառված {1} ակտիվը չի կարող լինել {2}"

msgid "Row #{0}: Consumed Asset {1} does not belong to company {2}"
msgstr "Տող #{0}: Սպառված {1} ակտիվը չի պատկանում {2} ընկերությանը"

msgid "Row #{0}: Cost Center {1} does not belong to company {2}"
msgstr "Տող #{0}: {1} ծախսերի կենտրոնը չի պատկանում {2} ընկերությանը"

msgid "Row #{0}: Could not find enough {1} entries to match. Remaining amount: {2}"
msgstr "Տող #{0}: Համապատասխանեցման համար բավարար {1} գրառումներ չեն գտնվել։ Մնացած գումար՝ {2}"

msgid "Row #{0}: Cumulative threshold cannot be less than Single Transaction threshold"
msgstr "Տող #{0}: Կուտակային շեմը չի կարող փոքր լինել մեկ գործարքի շեմից"

msgid "Row #{0}: Customer Provided Item {1} against Subcontracting Inward Order Item {2} ({3}) cannot be added multiple times."
msgstr "Տող #{0}: Հաճախորդի տրամադրած {1} ապրանքը {2} ({3}) ենթապայմանագրային մուտքային պատվերի ապրանքի դիմաց չի կարող ավելացվել մի քանի անգամ։"

msgid "Row #{0}: Customer Provided Item {1} cannot be added multiple times in the Subcontracting Inward process."
msgstr "Տող #{0}: Հաճախորդի տրամադրած {1} ապրանքը չի կարող ավելացվել մի քանի անգամ ենթապայմանագրային մուտքային գործընթացում։"

msgid "Row #{0}: Customer Provided Item {1} cannot be added multiple times."
msgstr "Տող #{0}: Հաճախորդի տրամադրած {1} ապրանքը չի կարող ավելացվել մի քանի անգամ։"

msgid "Row #{0}: Customer Provided Item {1} does not exist in the Required Items table linked to the Subcontracting Inward Order."
msgstr "Տող #{0}: Հաճախորդի տրամադրած {1} ապրանքը գոյություն չունի ենթապայմանագրային մուտքային պատվերին կապակցված պահանջվող ապրանքների աղյուսակում։"

msgid "Row #{0}: Customer Provided Item {1} exceeds quantity available through Subcontracting Inward Order"
msgstr "Տող #{0}: Հաճախորդի տրամադրած {1} ապրանքը գերազանցում է ենթապայմանագրային մուտքային պատվերով հասանելի քանակը"

msgid "Row #{0}: Customer Provided Item {1} has insufficient quantity in the Subcontracting Inward Order. Available quantity is {2}."
msgstr "Տող #{0}: Հաճախորդի տրամադրած {1} ապրանքի քանակը ենթապայմանագրային մուտքային պատվերում բավարար չէ։ Հասանելի քանակն է {2}։"

msgid "Row #{0}: Customer Provided Item {1} is not a part of Subcontracting Inward Order {2}"
msgstr "Տող #{0}: Հաճախորդի տրամադրած {1} ապրանքը {2} ենթապայմանագրային մուտքային պատվերի մաս չէ"

msgid "Row #{0}: Customer Provided Item {1} is not a part of Work Order {2}"
msgstr "Տող #{0}: Հաճախորդի տրամադրած {1} ապրանքը {2} արտադրական պատվերի մաս չէ"

msgid "Row #{0}: Dates overlapping with other row in group {1}"
msgstr "Տող #{0}: Ամսաթվերը համընկնում են {1} խմբի մեկ այլ տողի հետ"

msgid "Row #{0}: Default BOM not found for FG Item {1}"
msgstr "Տող #{0}: Լռելյայն BOM-ը չի գտնվել {1} պատրաստի արտադրանքի համար"

msgid "Row #{0}: Delivery of Item {1} is ensured by produced Serial No, but no Serial No is reserved against Sales Order {2}. Reserve the produced Serial Nos from the Sales Order."
msgstr "Տող #{0}: {1} ապրանքի առաքումն ապահովվում է արտադրված սերիական համարով, սակայն {2} վաճառքի պատվերի դիմաց ոչ մի սերիական համար ամրագրված չէ։ Ամրագրեք արտադրված սերիական համարները վաճառքի պատվերից։"

msgid "Row #{0}: Depreciation Start Date is required"
msgstr "Տող #{0}: Մաշվածության սկզբի ամսաթիվը պարտադիր է"

msgid "Row #{0}: Duplicate entry in References {1} {2}"
msgstr "Տող #{0}: Կրկնվող գրառում հղումներում՝ {1} {2}"

msgid "Row #{0}: Expected Delivery Date cannot be before Purchase Order Date"
msgstr "Տող #{0}: Առաքման սպասվող ամսաթիվը չի կարող լինել գնման պատվերի ամսաթվից առաջ"

msgid "Row #{0}: Expense Account not set for the Item {1}. {2}"
msgstr "Տող #{0}: Ծախսի հաշիվը սահմանված չէ {1} ապրանքի համար։ {2}"

msgid "Row #{0}: Expense account {1} is not valid for Purchase Invoice {2}. Only expense accounts from non-stock items are allowed."
msgstr "Տող #{0}: {1} ծախսի հաշիվը վավեր չէ {2} գնման հաշիվ-ապրանքագրի համար։ Թույլատրվում են միայն ոչ պահեստային ապրանքների ծախսի հաշիվները։"

msgid "Row #{0}: FG / Semi FG Item is required for the operation {1} as 'Track Semi Finished Goods' is enabled."
msgstr "Տող #{0}: Պատրաստի / կիսապատրաստ արտադրանքը պարտադիր է {1} գործողության համար, քանի որ 'Հետևել կիսապատրաստ արտադրանքին'-ը միացված է։"

msgid "Row #{0}: Finished Good Item Qty can not be zero"
msgstr "Տող #{0}: Պատրաստի արտադրանքի քանակը չի կարող զրո լինել"

msgid "Row #{0}: Finished Good Item is not specified for service item {1}"
msgstr "Տող #{0}: Պատրաստի արտադրանքը նշված չէ {1} ծառայության համար"

msgid "Row #{0}: Finished Good Item {1} cannot be added in the Secondary Items table."
msgstr "Տող #{0}: {1} պատրաստի արտադրանքը չի կարող ավելացվել երկրորդային ապրանքների աղյուսակում։"

msgid "Row #{0}: Finished Good Item {1} must be a sub-contracted item"
msgstr "Տող #{0}: {1} պատրաստի արտադրանքը պետք է լինի ենթապայմանագրային ապրանք"

msgid "Row #{0}: Finished Good must be {1}"
msgstr "Տող #{0}: Պատրաստի արտադրանքը պետք է լինի {1}"

msgid "Row #{0}: Finished Good reference is mandatory for Secondary Item {1}."
msgstr "Տող #{0}: Պատրաստի արտադրանքի հղումը պարտադիր է {1} երկրորդային ապրանքի համար։"

msgid "Row #{0}: For Customer Provided Item {1}, Source Warehouse must be {2}"
msgstr "Տող #{0}: Հաճախորդի տրամադրած {1} ապրանքի համար աղբյուր պահեստը պետք է լինի {2}"

msgid "Row #{0}: For {1}, you can select reference document only if account gets credited"
msgstr "Տող #{0}: {1}-ի համար կարող եք ընտրել հղման փաստաթուղթ միայն այն դեպքում, եթե հաշիվը կրեդիտագրվում է"

msgid "Row #{0}: For {1}, you can select reference document only if account gets debited"
msgstr "Տող #{0}: {1}-ի համար կարող եք ընտրել հղման փաստաթուղթ միայն այն դեպքում, եթե հաշիվը դեբետագրվում է"

msgid "Row #{0}: Frequency of Depreciation must be greater than zero"
msgstr "Տող #{0}: Մաշվածության հաճախականությունը պետք է մեծ լինի զրոյից"

msgid "Row #{0}: From Date cannot be before To Date"
msgstr "Տող #{0}: Սկզբի ամսաթիվը չի կարող լինել ավարտի ամսաթվից առաջ"

msgid "Row #{0}: From Time and To Time fields are required"
msgstr "Տող #{0}: «Սկզբի ժամ» և «Ավարտի ժամ» դաշտերը պարտադիր են"

msgid "Row #{0}: Item added"
msgstr "Տող #{0}: Ապրանքն ավելացվեց"

msgid "Row #{0}: Item {1} cannot be transferred more than {2} against {3} {4}"
msgstr "Տող #{0}: {1} ապրանքը չի կարող տեղափոխվել ավելի քան {2} {3} {4}-ի դիմաց"

msgid "Row #{0}: Item {1} does not exist"
msgstr "Տող #{0}: {1} ապրանքը գոյություն չունի"

msgid "Row #{0}: Item {1} does not match the item of its schedule row"
msgstr "Տող #{0}: {1} ապրանքը չի համապատասխանում իր ժամանակացույցի տողի ապրանքին"

msgid "Row #{0}: Item {1} has Operation {2}. Set a Routing to create BOMs with operations."
msgstr "Տող #{0}: {1} ապրանքն ունի {2} գործողություն։ Սահմանեք տեխնոլոգիական երթուղի՝ գործողություններով BOM-եր ստեղծելու համար։"

msgid "Row #{0}: Item {1} has been picked, please reserve stock from the Pick List."
msgstr "Տող #{0}: {1} ապրանքը հավաքված է, խնդրում ենք ամրագրել պաշարը հավաքման ցանկից։"

msgid "Row #{0}: Item {1} has no stock in warehouse {2}."
msgstr "Տող #{0}: {1} ապրանքը պաշար չունի {2} պահեստում։"

msgid "Row #{0}: Item {1} has zero rate but '{2}' is not enabled."
msgstr "Տող #{0}: {1} ապրանքն ունի զրոյական գին, բայց '{2}'-ը միացված չէ։"

msgid "Row #{0}: Item {1} in warehouse {2}: Available {3}, Needed {4}."
msgstr "Տող #{0}: {1} ապրանքը {2} պահեստում՝ հասանելի է {3}, անհրաժեշտ է {4}։"

msgid "Row #{0}: Item {1} is already added with the same Type in the Secondary Items table."
msgstr "Տող #{0}: {1} ապրանքն արդեն ավելացված է նույն տեսակով երկրորդային ապրանքների աղյուսակում։"

msgid "Row #{0}: Item {1} is not a Customer Provided Item."
msgstr "Տող #{0}: {1} ապրանքը հաճախորդի տրամադրած ապրանք չէ։"

msgid "Row #{0}: Item {1} is not a Serialized/Batched Item. It cannot have a Serial No/Batch No against it."
msgstr "Տող #{0}: {1} ապրանքը սերիական/խմբաքանակային ապրանք չէ։ Այն չի կարող ունենալ սերիական համար/խմբաքանակի համար։"

msgid "Row #{0}: Item {1} is not a part of Subcontracting Inward Order {2}"
msgstr "Տող #{0}: {1} ապրանքը {2} ենթապայմանագրային մուտքային պատվերի մաս չէ"

msgid "Row #{0}: Item {1} is not a service item"
msgstr "Տող #{0}: {1} ապրանքը ծառայություն չէ"

msgid "Row #{0}: Item {1} is not a stock item"
msgstr "Տող #{0}: {1} ապրանքը պահեստային ապրանք չէ"

msgid "Row #{0}: Item {1} is not part of the source manufacture entry and cannot be added to this disassembly."
msgstr "Տող #{0}: {1} ապրանքը սկզբնական արտադրական գրառման մաս չէ և չի կարող ավելացվել այս ապամոնտաժմանը։"

msgid "Row #{0}: Item {1} mismatch. Changing of item code is not permitted, add another row instead."
msgstr "Տող #{0}: {1} ապրանքի անհամապատասխանություն։ Ապրանքի կոդի փոփոխությունը թույլատրված չէ, փոխարենը ավելացրեք նոր տող։"

msgid "Row #{0}: Item {1} mismatch. Changing of item code is not permitted."
msgstr "Տող #{0}: {1} ապրանքի անհամապատասխանություն։ Ապրանքի կոդի փոփոխությունը թույլատրված չէ։"

msgid "Row #{0}: Item {1} must be a stock item with Supply Raw Materials for Purchase enabled for a Subcontracting Material Request"
msgstr "Տող #{0}: Ենթապայմանագրային նյութերի հայտի համար {1} ապրանքը պետք է լինի պահեստային ապրանք՝ միացված «Մատակարարել հումք գնման համար» կարգավորումով"

msgid "Row #{0}: Item {1} quantity ({2} in stock UOM) does not match the quantity derived from the source ({3}). Do not change the UOM, conversion factor or quantity of disassembly rows."
msgstr "Տող #{0}: {1} ապրանքի քանակը ({2} պահեստային Չ/մ-ով) չի համապատասխանում աղբյուրից ստացված քանակին ({3})։ Մի փոխեք ապամոնտաժման տողերի Չ/մ-ը, փոխարկման գործակիցը կամ քանակը։"

msgid "Row #{0}: Journal Entry {1} does not have account {2} or already matched against another voucher"
msgstr "Տող #{0}: {1} հաշվապահական ձևակերպումը չունի {2} հաշիվը կամ արդեն համապատասխանեցված է մեկ այլ փաստաթղթի"

msgid "Row #{0}: Next Depreciation Date cannot be before Available-for-use Date"
msgstr "Տող #{0}: Հաջորդ մաշվածության ամսաթիվը չի կարող լինել օգտագործման համար հասանելի լինելու ամսաթվից առաջ"

msgid "Row #{0}: Next Depreciation Date cannot be before Purchase Date"
msgstr "Տող #{0}: Հաջորդ մաշվածության ամսաթիվը չի կարող լինել գնման ամսաթվից առաջ"

msgid "Row #{0}: Not allowed to change Supplier as Purchase Order already exists"
msgstr "Տող #{0}: Մատակարարի փոփոխությունը թույլատրված չէ, քանի որ գնման պատվերն արդեն գոյություն ունի"

msgid "Row #{0}: Objective {1} is not part of Quality Goal {2}"
msgstr "Տող #{0}: {1} նպատակը {2} որակի նպատակի մաս չէ"

msgid "Row #{0}: Only {1} available to reserve for the Item {2}"
msgstr "Տող #{0}: {2} ապրանքի համար ամրագրման հասանելի է միայն {1}"

msgid "Row #{0}: Opening Accumulated Depreciation must be less than or equal to {1}"
msgstr "Տող #{0}: Բացման կուտակված մաշվածությունը պետք է փոքր կամ հավասար լինի {1}-ին"

msgid "Row #{0}: Operation {1} is not completed for {2} qty of finished goods in Work Order {3}. Please update operation status via Job Card {4}."
msgstr "Տող #{0}: {1} գործողությունն ավարտված չէ պատրաստի արտադրանքի {2} քանակի համար {3} արտադրական պատվերում։ Խնդրում ենք թարմացնել գործողության կարգավիճակը {4} աշխատանքային քարտի միջոցով։"

msgid "Row #{0}: Overconsumption of Customer Provided Item {1} against Work Order {2} is not allowed in the Subcontracting Inward process."
msgstr "Տող #{0}: Հաճախորդի տրամադրած {1} ապրանքի գերսպառումը {2} արտադրական պատվերի դիմաց թույլատրված չէ ենթապայմանագրային մուտքային գործընթացում։"

msgid "Row #{0}: Parameter {1} is already added"
msgstr "Տող #{0}: {1} պարամետրն արդեն ավելացված է"

msgid "Row #{0}: Parameter {1} is not part of Quality Feedback Template {2}"
msgstr "Տող #{0}: {1} պարամետրը {2} որակի կարծիքի ձևանմուշի մաս չէ"

msgid "Row #{0}: Planned Qty must be greater than 0 for Item {1}."
msgstr "Տող #{0}: Պլանավորված քանակը պետք է մեծ լինի 0-ից {1} ապրանքի համար։"

msgid "Row #{0}: Please select Item Code in Assembly Items"
msgstr "Տող #{0}: Խնդրում ենք ընտրել ապրանքի կոդը հավաքման ապրանքներում"

msgid "Row #{0}: Please select the BOM No in Assembly Items"
msgstr "Տող #{0}: Խնդրում ենք ընտրել BOM-ի համարը հավաքման ապրանքներում"

msgid "Row #{0}: Please select the Finished Good Item against which this Customer Provided Item will be used."
msgstr "Տող #{0}: Խնդրում ենք ընտրել պատրաստի արտադրանքը, որի համար կօգտագործվի այս հաճախորդի տրամադրած ապրանքը։"

msgid "Row #{0}: Please select the Sub Assembly Warehouse"
msgstr "Տող #{0}: Խնդրում ենք ընտրել ենթահավաքման պահեստը"

msgid "Row #{0}: Please set reorder quantity"
msgstr "Տող #{0}: Խնդրում ենք սահմանել վերապատվիրման քանակը"

msgid "Row #{0}: Please update deferred revenue/expense account in item row or default account in company master"
msgstr "Տող #{0}: Խնդրում ենք թարմացնել հետաձգված հասույթի/ծախսի հաշիվը ապրանքի տողում կամ լռելյայն հաշիվը ընկերության քարտում"

msgid "Row #{0}: Process Loss Percentage should be less than 100% for {1} Item {2}"
msgstr "Տող #{0}: Գործընթացային կորստի տոկոսը պետք է փոքր լինի 100%-ից {1} {2} ապրանքի համար"

msgid "Row #{0}: Qty increased by {1}"
msgstr "Տող #{0}: Քանակն ավելացվեց {1}-ով"

msgid "Row #{0}: Qty must be a positive number"
msgstr "Տող #{0}: Քանակը պետք է լինի դրական թիվ"

msgid "Row #{0}: Qty should be less than or equal to Available Qty to Reserve (Actual Qty - Reserved Qty) {1} for Iem {2} against Batch {3} in Warehouse {4}."
msgstr "Տող #{0}: Քանակը պետք է փոքր կամ հավասար լինի ամրագրման հասանելի քանակին (փաստացի քանակ - ամրագրված քանակ)՝ {1}, {2} ապրանքի համար {3} խմբաքանակի դիմաց {4} պահեստում։"

msgid "Row #{0}: Quality Inspection is required for Item {1}"
msgstr "Տող #{0}: Որակի ստուգումը պարտադիր է {1} ապրանքի համար"

msgid "Row #{0}: Quality Inspection {1} is not submitted for the item: {2}"
msgstr "Տող #{0}: {1} որակի ստուգումը հաստատված չէ ապրանքի համար՝ {2}"

msgid "Row #{0}: Quality Inspection {1} was rejected for item {2}"
msgstr "Տող #{0}: {1} որակի ստուգումը մերժվել է {2} ապրանքի համար"

msgid "Row #{0}: Quantity cannot be a non-positive number. Please increase the quantity or remove the Item {1}"
msgstr "Տող #{0}: Քանակը չի կարող լինել ոչ դրական թիվ։ Խնդրում ենք ավելացնել քանակը կամ հեռացնել {1} ապրանքը"

msgid "Row #{0}: Quantity for Item {1} cannot be zero."
msgstr "Տող #{0}: {1} ապրանքի քանակը չի կարող զրո լինել։"

msgid "Row #{0}: Quantity must be a positive number"
msgstr "Տող #{0}: Քանակը պետք է լինի դրական թիվ"

msgid "Row #{0}: Quantity must be greater than 0 for Item {1}"
msgstr "Տող #{0}: Քանակը պետք է մեծ լինի 0-ից {1} ապրանքի համար"

msgid "Row #{0}: Quantity of Item {1} cannot be more than {2} {3} against Subcontracting Inward Order {4}"
msgstr "Տող #{0}: {1} ապրանքի քանակը չի կարող գերազանցել {2} {3}-ը {4} ենթապայմանագրային մուտքային պատվերի դիմաց"

msgid "Row #{0}: Quantity to reserve for the Item {1} should be greater than 0."
msgstr "Տող #{0}: {1} ապրանքի համար ամրագրվող քանակը պետք է մեծ լինի 0-ից։"

msgid "Row #{0}: Rate must be same as {1}: {2} ({3} / {4})"
msgstr "Տող #{0}: Գինը պետք է նույնը լինի, ինչ {1}: {2} ({3} / {4})"

msgid "Row #{0}: Reading {1} {2} is not a valid number in the {3} number format. Use {4} as the decimal separator."
msgstr "Տող #{0}: {1} {2} ցուցմունքը վավեր թիվ չէ {3} թվային ձևաչափում։ Օգտագործեք {4}-ը որպես տասնորդական բաժանիչ։"

msgid "Row #{0}: Reference Document Type must be one of Purchase Order, Purchase Invoice or Journal Entry"
msgstr "Տող #{0}: Հղման փաստաթղթի տեսակը պետք է լինի գնման պատվեր, գնման հաշիվ-ապրանքագիր կամ հաշվապահական ձևակերպում"

msgid "Row #{0}: Reference Document Type must be one of Sales Order, Sales Invoice, Journal Entry or Dunning"
msgstr "Տող #{0}: Հղման փաստաթղթի տեսակը պետք է լինի վաճառքի պատվեր, վաճառքի հաշիվ-ապրանքագիր, հաշվապահական ձևակերպում կամ պարտքի հիշեցում"

msgid "Row #{0}: Rejected Qty cannot be set for Secondary Item {1}."
msgstr "Տող #{0}: Մերժված քանակը չի կարող սահմանվել {1} երկրորդային ապրանքի համար։"

msgid "Row #{0}: Rejected Warehouse is mandatory for the rejected Item {1}"
msgstr "Տող #{0}: Մերժված ապրանքների պահեստը պարտադիր է մերժված {1} ապրանքի համար"

msgid "Row #{0}: Repair cost {1} exceeds available amount {2} for Purchase Invoice {3} and Account {4}"
msgstr "Տող #{0}: {1} նորոգման արժեքը գերազանցում է հասանելի {2} գումարը {3} գնման հաշիվ-ապրանքագրի և {4} հաշվի համար"

msgid "Row #{0}: Return Against is required for returning asset"
msgstr "Տող #{0}: Ակտիվը վերադարձնելու համար «Վերադարձ դիմաց»-ը պարտադիր է"

msgid "Row #{0}: Returned quantity cannot be greater than available quantity for Item {1}"
msgstr "Տող #{0}: Վերադարձված քանակը չի կարող գերազանցել հասանելի քանակը {1} ապրանքի համար"

msgid "Row #{0}: Returned quantity cannot be greater than available quantity to return for Item {1}"
msgstr "Տող #{0}: Վերադարձված քանակը չի կարող գերազանցել վերադարձի հասանելի քանակը {1} ապրանքի համար"

msgid "Row #{0}: Secondary Item Qty cannot be zero"
msgstr "Տող #{0}: Երկրորդային ապրանքի քանակը չի կարող զրո լինել"

msgid ""
"Row #{0}: Selling rate for item {1} is lower than its {2}.\n"
"\t\t\t\t\tSelling {3} should be atleast {4}.<br><br>Alternatively,\n"
"\t\t\t\t\tyou can disable '{5}' in {6} to bypass\n"
"\t\t\t\t\tthis validation."
msgstr ""
"Տող #{0}: {1} ապրանքի վաճառքի գինը ցածր է դրա {2}-ից։\n"
"\t\t\t\t\tՎաճառքի {3}-ը պետք է լինի առնվազն {4}։<br><br>Այլապես,\n"
"\t\t\t\t\tկարող եք անջատել '{5}'-ը {6}-ում՝ շրջանցելու\n"
"\t\t\t\t\tայս ստուգումը։"

msgid "Row #{0}: Sequence ID must be {1} or {2} for Operation {3}."
msgstr "Տող #{0}: Հաջորդականության ID-ն պետք է լինի {1} կամ {2} {3} գործողության համար։"

msgid "Row #{0}: Serial No {1} does not belong to Batch {2}"
msgstr "Տող #{0}: {1} սերիական համարը չի պատկանում {2} խմբաքանակին"

msgid "Row #{0}: Serial No {1} for Item {2} is not available in {3} {4} or might be reserved in another {5}."
msgstr "Տող #{0}: {2} ապրանքի {1} սերիական համարը հասանելի չէ {3} {4}-ում կամ կարող է ամրագրված լինել մեկ այլ {5}-ում։"

msgid "Row #{0}: Serial No {1} is already selected."
msgstr "Տող #{0}: {1} սերիական համարն արդեն ընտրված է։"

msgid "Row #{0}: Serial No {1} is not reserved against Sales Order {2}. Deliver only the Serial Nos produced and reserved for it."
msgstr "Տող #{0}: {1} սերիական համարն ամրագրված չէ {2} վաճառքի պատվերի դիմաց։ Առաքեք միայն դրա համար արտադրված և ամրագրված սերիական համարները։"

msgid "Row #{0}: Serial No(s) {1} are not a part of the linked Subcontracting Inward Order. Please select valid Serial No(s)."
msgstr "Տող #{0}: {1} սերիական համար(ներ)ը կապակցված ենթապայմանագրային մուտքային պատվերի մաս չեն։ Խնդրում ենք ընտրել վավեր սերիական համար(ներ)։"

msgid "Row #{0}: Service End Date cannot be before Invoice Posting Date"
msgstr "Տող #{0}: Ծառայության ավարտի ամսաթիվը չի կարող լինել հաշիվ-ապրանքագրի ձևակերպման ամսաթվից առաջ"

msgid "Row #{0}: Service Start Date cannot be greater than Service End Date"
msgstr "Տող #{0}: Ծառայության սկզբի ամսաթիվը չի կարող լինել ծառայության ավարտի ամսաթվից հետո"

msgid "Row #{0}: Service Start and End Date is required for deferred accounting"
msgstr "Տող #{0}: Հետաձգված հաշվառման համար ծառայության սկզբի և ավարտի ամսաթվերը պարտադիր են"

msgid "Row #{0}: Set Supplier for item {1}"
msgstr "Տող #{0}: Սահմանեք մատակարար {1} ապրանքի համար"

msgid "Row #{0}: Since 'Track Semi Finished Goods' is enabled, the BOM {1} cannot be used for Sub Assembly Items"
msgstr "Տող #{0}: Քանի որ 'Հետևել կիսապատրաստ արտադրանքին'-ը միացված է, {1} BOM-ը չի կարող օգտագործվել ենթահավաքման ապրանքների համար"

msgid "Row #{0}: Source Warehouse must be same as Customer Warehouse {1} from the linked Subcontracting Inward Order"
msgstr "Տող #{0}: Աղբյուր պահեստը պետք է նույնը լինի, ինչ կապակցված ենթապայմանագրային մուտքային պատվերի {1} հաճախորդի պահեստը"

msgid "Row #{0}: Source Warehouse {1} for item {2} cannot be a customer warehouse."
msgstr "Տող #{0}: {2} ապրանքի {1} աղբյուր պահեստը չի կարող լինել հաճախորդի պահեստ։"

msgid "Row #{0}: Source Warehouse {1} for item {2} must be same as Source Warehouse {3} in the Work Order."
msgstr "Տող #{0}: {2} ապրանքի {1} աղբյուր պահեստը պետք է նույնը լինի, ինչ արտադրական պատվերի {3} աղբյուր պահեստը։"

msgid "Row #{0}: Source and Target Warehouse cannot be the same for Material Transfer"
msgstr "Տող #{0}: Նյութերի տեղափոխման համար աղբյուր և նպատակային պահեստները չեն կարող նույնը լինել"

msgid "Row #{0}: Source, Target Warehouse and Inventory Dimensions cannot be the exact same for Material Transfer"
msgstr "Տող #{0}: Նյութերի տեղափոխման համար աղբյուր պահեստը, նպատակային պահեստը և պաշարի չափումները չեն կարող լիովին նույնը լինել"

msgid "Row #{0}: Start Time must be before End Time"
msgstr "Տող #{0}: Սկզբի ժամը պետք է լինի ավարտի ժամից առաջ"

msgid "Row #{0}: Status is mandatory"
msgstr "Տող #{0}: Կարգավիճակը պարտադիր է"

msgid "Row #{0}: Status must be {1} for Invoice Discounting {2}"
msgstr "Տող #{0}: Կարգավիճակը պետք է լինի {1} {2} հաշիվ-ապրանքագրերի զեղչման համար"

msgid "Row #{0}: Stock cannot be reserved for Item {1} against a disabled Batch {2}."
msgstr "Տող #{0}: Պաշարը չի կարող ամրագրվել {1} ապրանքի համար անջատված {2} խմբաքանակի դիմաց։"

msgid "Row #{0}: Stock cannot be reserved for a non-stock Item {1}"
msgstr "Տող #{0}: Պաշարը չի կարող ամրագրվել ոչ պահեստային {1} ապրանքի համար"

msgid "Row #{0}: Stock cannot be reserved for the Item {1} as its delivery is ensured based on the produced Serial Nos. The Work Order will reserve them on manufacture."
msgstr "Տող #{0}: Պաշարը չի կարող ամրագրվել {1} ապրանքի համար, քանի որ դրա առաքումն ապահովվում է արտադրված սերիական համարների հիման վրա։ Արտադրական պատվերը դրանք կամրագրի արտադրության ժամանակ։"

msgid "Row #{0}: Stock cannot be reserved in group warehouse {1}."
msgstr "Տող #{0}: Պաշարը չի կարող ամրագրվել {1} խմբային պահեստում։"

msgid "Row #{0}: Stock is already reserved for the Item {1}."
msgstr "Տող #{0}: Պաշարն արդեն ամրագրված է {1} ապրանքի համար։"

msgid "Row #{0}: Stock is reserved for item {1} in warehouse {2}."
msgstr "Տող #{0}: Պաշարն ամրագրված է {1} ապրանքի համար {2} պահեստում։"

msgid "Row #{0}: Stock not available to reserve for Item {1} against Batch {2} in Warehouse {3}."
msgstr "Տող #{0}: Ամրագրման համար պաշար հասանելի չէ {1} ապրանքի համար {2} խմբաքանակի դիմաց {3} պահեստում։"

msgid "Row #{0}: Stock not available to reserve for the Item {1} in Warehouse {2}."
msgstr "Տող #{0}: Ամրագրման համար պաշար հասանելի չէ {1} ապրանքի համար {2} պահեստում։"

msgid "Row #{0}: Stock quantity {1} ({2}) for item {3} cannot exceed {4}"
msgstr "Տող #{0}: {3} ապրանքի պաշարի քանակը՝ {1} ({2}), չի կարող գերազանցել {4}-ը"

msgid "Row #{0}: Target Warehouse must be same as Customer Warehouse {1} from the linked Subcontracting Inward Order"
msgstr "Տող #{0}: Նպատակային պահեստը պետք է նույնը լինի, ինչ կապակցված ենթապայմանագրային մուտքային պատվերի {1} հաճախորդի պահեստը"

msgid "Row #{0}: Target Warehouse {1} must be a Transit warehouse when Add to Transit is enabled."
msgstr "Տող #{0}: {1} նպատակային պահեստը պետք է լինի տարանցիկ պահեստ, երբ «Ավելացնել տարանցիկին»-ը միացված է։"

msgid "Row #{0}: The batch {1} has already expired."
msgstr "Տող #{0}: {1} խմբաքանակի պիտանելիության ժամկետն արդեն լրացել է։"

msgid "Row #{0}: The operation {1} has 'Is Final Finished Good' checked, so its FG / Semi FG Item must be {2}."
msgstr "Տող #{0}: {1} գործողության համար նշված է 'Վերջնական պատրաստի արտադրանք է', ուստի դրա պատրաստի / կիսապատրաստ արտադրանքը պետք է լինի {2}։"

msgid "Row #{0}: The warehouse {1} is not a child warehouse of a group warehouse {2}"
msgstr "Տող #{0}: {1} պահեստը {2} խմբային պահեստի ենթապահեստ չէ"

msgid "Row #{0}: The {1} Component has the options {2} and {3} enabled."
msgstr "Տող #{0}: {1} բաղադրիչում միացված են {2} և {3} տարբերակները։"

msgid "Row #{0}: Timesheet amount will overwrite the Earning component amount for the Salary Component {1}"
msgstr "Տող #{0}: Աշխատաժամանակի թերթիկի գումարը կվերագրի հաշվարկման բաղադրիչի գումարը {1} աշխատավարձի բաղադրիչի համար"

msgid "Row #{0}: Timings conflicts with row {1}"
msgstr "Տող #{0}: Ժամերը հակասում են {1} տողի հետ"

msgid "Row #{0}: Total Number of Depreciations cannot be less than or equal to Opening Number of Booked Depreciations"
msgstr "Տող #{0}: Մաշվածությունների ընդհանուր քանակը չի կարող փոքր կամ հավասար լինել բացման ձևակերպված մաշվածությունների քանակին"

msgid "Row #{0}: Total Number of Depreciations must be greater than zero"
msgstr "Տող #{0}: Մաշվածությունների ընդհանուր քանակը պետք է մեծ լինի զրոյից"

msgid "Row #{0}: Warehouse {1} does not match with the warehouse {2} in Serial and Batch Bundle {3}."
msgstr "Տող #{0}: {1} պահեստը չի համապատասխանում {3} սերիական համարների և խմբաքանակների փաթեթի {2} պահեստին։"

msgid "Row #{0}: Withholding Amount {1} does not match calculated amount {2}."
msgstr "Տող #{0}: Պահման {1} գումարը չի համապատասխանում հաշվարկված {2} գումարին։"

msgid "Row #{0}: Work Order exists against full or partial quantity of Item {1}"
msgstr "Տող #{0}: {1} ապրանքի ամբողջ կամ մասնակի քանակի դիմաց արտադրական պատվեր գոյություն ունի"

msgid "Row #{0}: You cannot use the inventory dimension '{1}' in Stock Reconciliation to modify the quantity or valuation rate. Stock reconciliation with inventory dimensions is intended solely for performing opening entries."
msgstr "Տող #{0}: Դուք չեք կարող օգտագործել '{1}' պաշարի չափումը պաշարի համադրման մեջ՝ քանակը կամ գնահատման գինը փոփոխելու համար։ Պաշարի չափումներով պաշարի համադրումը նախատեսված է բացառապես բացման գրառումներ կատարելու համար։"

msgid "Row #{0}: You must select an Asset for Item {1}."
msgstr "Տող #{0}: Դուք պետք է ընտրեք ակտիվ {1} ապրանքի համար։"

msgid "Row #{0}: a dock entry opens a Sidebar, a Workspace or a web address, not a {1}."
msgstr "Տող #{0}: Dock-ի գրառումը բացում է կողային վահանակ, աշխատանքային տարածք կամ վեբ հասցե, ոչ թե {1}։"

msgid "Row #{0}: an entry on this dock needs an icon and a title of its own."
msgstr "Տող #{0}: Այս dock-ի գրառմանն անհրաժեշտ է սեփական պատկերակ և վերնագիր։"

msgid "Row #{0}: {1} account is not of type {2}"
msgstr "Տող #{0}: {1} հաշիվը {2} տեսակի չէ"

msgid "Row #{0}: {1} can not be negative for item {2}"
msgstr "Տող #{0}: {1}-ը չի կարող բացասական լինել {2} ապրանքի համար"

msgid "Row #{0}: {1} is mandatory for the Inventory Dimension {2}."
msgstr "Տող #{0}: {1}-ը պարտադիր է {2} պաշարի չափման համար։"

msgid "Row #{0}: {1} is not a valid reading field. Please refer to the field description."
msgstr "Տող #{0}: {1}-ը վավեր ցուցմունքի դաշտ չէ։ Խնդրում ենք ծանոթանալ դաշտի նկարագրությանը։"

msgid "Row #{0}: {1} is required to create the Opening {2} Invoices"
msgstr "Տող #{0}: {1}-ը պարտադիր է բացման {2} հաշիվ-ապրանքագրերը ստեղծելու համար"

msgid "Row #{0}: {1} of {2} should be {3}. Please update the {1} or select a different account."
msgstr "Տող #{0}: {2}-ի {1}-ը պետք է լինի {3}։ Խնդրում ենք թարմացնել {1}-ը կամ ընտրել այլ հաշիվ։"

msgid "Row #{0}:Quantity for Item {1} cannot be zero."
msgstr "Տող #{0}: {1} ապրանքի քանակը չի կարող զրո լինել։"

msgid "Row #{1}: Warehouse is mandatory for stock Item {0}"
msgstr "Տող #{1}: Պահեստը պարտադիր է {0} պահեստային ապրանքի համար"

msgid "Row #{idx}: Cannot select Supplier Warehouse while suppling raw materials to subcontractor."
msgstr "Տող #{idx}: Հնարավոր չէ ընտրել մատակարարի պահեստը ենթակապալառուին հումք մատակարարելիս։"

msgid "Row #{idx}: Item rate has been updated as per valuation rate since its an internal stock transfer."
msgstr "Տող #{idx}: Ապրանքի գինը թարմացվել է ըստ գնահատման գնի, քանի որ սա ներքին պաշարի տեղափոխում է։"

msgid "Row #{idx}: Please enter a location for the asset item {item_code}."
msgstr "Տող #{idx}: Խնդրում ենք մուտքագրել գտնվելու վայր {item_code} ակտիվ ապրանքի համար։"

msgid "Row #{idx}: Received Qty must be equal to Accepted + Rejected Qty for Item {item_code}."
msgstr "Տող #{idx}: Ստացված քանակը պետք է հավասար լինի ընդունված + մերժված քանակին {item_code} ապրանքի համար։"

msgid "Row #{idx}: {field_label} can not be negative for item {item_code}."
msgstr "Տող #{idx}: {field_label}-ը չի կարող բացասական լինել {item_code} ապրանքի համար։"

msgid "Row #{idx}: {field_label} is mandatory."
msgstr "Տող #{idx}: {field_label}-ը պարտադիր է։"

msgid "Row #{idx}: {from_warehouse_field} and {to_warehouse_field} cannot be same."
msgstr "Տող #{idx}: {from_warehouse_field}-ը և {to_warehouse_field}-ը չեն կարող նույնը լինել։"

msgid "Row #{idx}: {schedule_date} cannot be before {transaction_date}."
msgstr "Տող #{idx}: {schedule_date}-ը չի կարող լինել {transaction_date}-ից առաջ։"

msgid "Row #{}: Currency of {} - {} doesn't matches company currency."
msgstr "Տող #{}: {} - {}-ի արժույթը չի համապատասխանում ընկերության արժույթին։"

msgid "Row #{}: Either Party ID or Party Name is required"
msgstr "Տող #{}: Պարտադիր է կամ կողմի ID-ն, կամ կողմի անվանումը"

msgid "Row #{}: Fieldname is required"
msgstr "Տող #{}: Դաշտի անվանումը պարտադիր է"

msgid "Row #{}: Finance Book should not be empty since you're using multiple."
msgstr "Տող #{}: Ֆինանսական մատյանը չպետք է դատարկ լինի, քանի որ օգտագործում եք մի քանիսը։"

msgid "Row #{}: POS Invoice {} has been {}"
msgstr "Տող #{}: {} POS հաշիվ-ապրանքագիրը {} է"

