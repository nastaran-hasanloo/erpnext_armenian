msgid "Stock cannot be updated for Purchase Invoice {0} because a Purchase Receipt {1} has already been created for this transaction. Please disable the 'Update Stock' checkbox in the Purchase Invoice and save the invoice."
msgstr "Պաշարը չի կարող թարմացվել {0} գնման հաշիվ-ապրանքագրի համար, քանի որ այս գործարքի համար արդեն ստեղծվել է {1} ապրանքի ընդունման ակտը։ Խնդրում ենք անջատել «Թարմացնել պաշարը» նշավանդակը գնման հաշիվ-ապրանքագրում և պահպանել այն։"

msgid "Stock entries exist with the old account. Changing the account may lead to a mismatch between the warehouse closing balance and the account closing balance. The overall closing balance will still match, but not for the specific account."
msgstr "Առկա են պահեստային գործառնություններ հին հաշվով։ Հաշվի փոփոխությունը կարող է հանգեցնել պահեստի վերջնական մնացորդի և հաշվի վերջնական մնացորդի անհամապատասխանության։ Ընդհանուր վերջնական մնացորդը կհամընկնի, բայց ոչ կոնկրետ հաշվի համար։"

msgid "Stock frozen up to"
msgstr "Պաշարը սառեցված է մինչև"

msgid "Stock goes down as the goods leave, and the invoice can be made from the delivery. See [Delivery Note](https://docs.frappe.io/erpnext/user/manual/en/delivery-note)."
msgstr "Պաշարը նվազում է, երբ ապրանքները դուրս են գալիս, և հաշիվ-ապրանքագիրը կարող է ստեղծվել առաքումից։ Տե՛ս [Առաքման ակտ](https://docs.frappe.io/erpnext/user/manual/en/delivery-note)։"

msgid "Stock goes up in the warehouse you receive into, and the bill can be made from the receipt. See [Purchase Receipt](https://docs.frappe.io/erpnext/user/manual/en/purchase-receipt)."
msgstr "Պաշարն ավելանում է այն պահեստում, որտեղ ընդունում եք, և հաշիվը կարող է ստեղծվել ընդունման ակտից։ Տե՛ս [Ապրանքի ընդունման ակտ](https://docs.frappe.io/erpnext/user/manual/en/purchase-receipt)։"

msgid "Stock has been unreserved for work order {0}."
