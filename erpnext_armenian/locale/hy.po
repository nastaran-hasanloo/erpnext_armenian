msgid "If \"Months\" is selected, a fixed amount will be booked as deferred revenue or expense for each month irrespective of the number of days in a month. It will be prorated if deferred revenue or expense is not booked for an entire month"
msgstr "Եթե ընտրված է «Ամիսներ», ապա յուրաքանչյուր ամսվա համար որպես հետաձգված եկամուտ կամ ծախս կձևակերպվի ֆիքսված գումար՝ անկախ ամսվա օրերի քանակից։ Այն համամասնորեն կհաշվարկվի, եթե հետաձգված եկամուտը կամ ծախսը չի ձևակերպվում ամբողջ ամսվա համար"

msgid ""
"If <b>Enabled</b> - Reconciliation happens on the <b>Advance Payment posting date</b><br>\n"
"If <b>Disabled</b> - Reconciliation happens on oldest of 2 Dates: <b>Invoice Date</b> or the <b>Advance Payment posting date</b><br>\n"
msgstr ""
"Եթե <b>Միացված է</b>՝ համադրումը կատարվում է <b>Կանխավճարի ձևակերպման ամսաթվով</b><br>\n"
"Եթե <b>Անջատված է</b>՝ համադրումը կատարվում է 2 ամսաթվերից ամենավաղով՝ <b>Հաշիվ-ապրանքագրի ամսաթիվ</b> կամ <b>Կանխավճարի ձևակերպման ամսաթիվ</b><br>\n"

msgid "If Apply Strict User Permission is checked and User Permission is defined for a DocType for a User, then all the documents where value of the link is blank, will not be shown to that User"
msgstr "Եթե «Կիրառել օգտատիրոջ խիստ թույլտվություն»-ը նշված է, և Օգտատիրոջ թույլտվություն է սահմանված DocType-ի համար օգտատիրոջ համար, ապա այն բոլոր փաստաթղթերը, որտեղ հղման արժեքը դատարկ է, չեն ցուցադրվի այդ օգտատիրոջը"

msgid "If Auto Opt In is checked, then the customers will be automatically linked with the concerned Loyalty Program (on save)"
msgstr "Եթե «Ավտոմատ միացում»-ը նշված է, հաճախորդներն ավտոմատ կերպով կկապվեն համապատասխան հավատարմության ծրագրի հետ (պահպանելիս)"

msgid "If Checked workflow status will not override status in list view"
msgstr "Եթե նշված է, աշխատանքային հոսքի կարգավիճակը չի փոխարինի կարգավիճակը ցանկի տեսքում"

msgid "If Income or Expense"
msgstr "Եթե եկամուտ կամ ծախս է"

msgid "If Owner"
msgstr "Եթե սեփականատեր է"

msgid "If a Role does not have access at Level 0, then higher levels are meaningless."
msgstr "Եթե Դերը մուտք չունի 0 մակարդակում, ապա ավելի բարձր մակարդակներն իմաստ չունեն։"

msgid "If a party cannot be matched by account number or IBAN, the system will try fuzzy matching using the party name and transaction description."
msgstr "Եթե կողմը հնարավոր չէ համապատասխանեցնել հաշվի համարով կամ IBAN-ով, համակարգը կփորձի մոտավոր համապատասխանեցում կատարել՝ օգտագործելով կողմի անվանումը և գործարքի նկարագրությունը։"

msgid "If an operation is divided into sub operations, they can be added here."
msgstr "Եթե գործողությունը բաժանված է ենթագործողությունների, դրանք կարելի է ավելացնել այստեղ։"

msgid "If blank, parent Warehouse Account or company default will be considered in transactions"
msgstr "Եթե դատարկ է, գործարքներում հաշվի կառնվի ծնող պահեստի հաշիվը կամ ընկերության լռելյայն հաշիվը"

msgid "If checked, <i>Prepared Report</i> will not be enabled automatically on slow runs."
msgstr "Եթե նշված է, <i>Պատրաստված հաշվետվությունը</i> ավտոմատ չի միացվի դանդաղ կատարումների դեպքում։"

msgid "If checked, Payroll Payable will be booked against each employee"
msgstr "Եթե նշված է, վճարման ենթակա աշխատավարձը կգրանցվի յուրաքանչյուր աշխատակցի համար առանձին"

msgid "If checked, Rejected Quantity will be included while making Purchase Invoice from Purchase Receipt."
msgstr "Եթե նշված է, ապրանքի ընդունման ակտից գնման հաշիվ-ապրանքագիր ստեղծելիս կներառվի մերժված քանակը։"

msgid "If checked, Stock will be reserved on <b>Submit</b>"
msgstr "Եթե նշված է, պաշարը կամրագրվի <b>Հաստատելիս</b>"

msgid "If checked, a confirmation will be required before performing workflow actions."
msgstr "Եթե նշված է, աշխատանքային հոսքի գործողություններ կատարելուց առաջ կպահանջվի հաստատում։"

msgid "If checked, all other workflows become inactive."
msgstr "Եթե նշված է, մյուս բոլոր աշխատանքային հոսքերը դառնում են ոչ ակտիվ։"

msgid "If checked, flexible benefits are considered only if benefit application exists"
msgstr "Եթե նշված է, ճկուն նպաստները հաշվի են առնվում միայն նպաստի դիմումի առկայության դեպքում"

msgid "If checked, hides and disables Rounded Total field in Salary Slips"
msgstr "Եթե նշված է, աշխատավարձի թերթիկներում «Կլորացված գումար» դաշտը թաքցվում և անջատվում է"

msgid "If checked, journal entries made using bank reconciliation will be of type \"Credit Card Entry\""
msgstr "Եթե նշված է, բանկային համադրման միջոցով ստեղծված հաշվապահական ձևակերպումները կլինեն «Վարկային քարտի գրառում» տեսակի"

msgid "If checked, negative numeric values of Currency, Quantity or Count would be shown as positive"
msgstr "Եթե նշված է, Արժույթի, Քանակի կամ Հաշվարկի բացասական թվային արժեքները կցուցադրվեն որպես դրական"

msgid "If checked, overtime slip creation can be handled as part of payroll processing"
msgstr "Եթե նշված է, արտաժամյա աշխատանքի թերթիկների ստեղծումը կարող է կատարվել աշխատավարձի հաշվարկի գործընթացի շրջանակում"

msgid "If checked, picked qty won't automatically be fulfilled on submit of pick list."
msgstr "Եթե նշված է, հավաքված քանակը ավտոմատ կերպով չի կատարվի հավաքման ցանկը հաստատելիս։"

msgid "If checked, the entire amount (e.g. Freight) is allocated to the valuation of stock & asset items only. If unchecked, the amount is distributed across all items and the portion belonging to non-stock items is not added to valuation."
msgstr "Եթե նշված է, ամբողջ գումարը (օր.՝ բեռնափոխադրումը) բաշխվում է միայն պահեստային և ակտիվ ապրանքների գնահատմանը։ Եթե նշված չէ, գումարը բաշխվում է բոլոր ապրանքների միջև, և ոչ պահեստային ապրանքներին բաժին ընկնող մասը չի ավելացվում գնահատմանը։"

msgid "If checked, the full amount will be deducted from taxable income before calculating income tax without any declaration or proof submission."
msgstr "Եթե նշված է, ամբողջ գումարը կնվազեցվի հարկվող եկամտից մինչև եկամտային հարկի հաշվարկը՝ առանց որևէ հայտարարագրի կամ ապացույցի ներկայացման։"

msgid "If checked, the tax amount will be considered as already included in the Paid Amount in Payment Entry"
msgstr "Եթե նշված է, հարկի գումարը կհամարվի արդեն ներառված վճարման գրառման վճարված գումարում"

msgid "If checked, the tax amount will be considered as already included in the Print Rate / Print Amount"
msgstr "Եթե նշված է, հարկի գումարը կհամարվի արդեն ներառված տպման գնում / տպման գումարում"

msgid "If checked, updates inventory; stock and accounting entries are created together. Leave unchecked if a Delivery Note is created separately."
msgstr "Եթե նշված է, թարմացնում է պաշարը․ պահեստային և հաշվապահական գրառումները ստեղծվում են միասին։ Թողեք չնշված, եթե առաքման ակտը ստեղծվում է առանձին։"

msgid "If checked, updates inventory; stock and accounting entries are created together. Leave unchecked if a Purchase Receipt is created separately."
msgstr "Եթե նշված է, թարմացնում է պաշարը․ պահեստային և հաշվապահական գրառումները ստեղծվում են միասին։ Թողեք չնշված, եթե ապրանքի ընդունման ակտը ստեղծվում է առանձին։"

msgid "If checked, users will not see the Confirm Access dialog."
msgstr "Եթե նշված է, օգտատերերը չեն տեսնի Մուտքի հաստատման պատուհանը։"

msgid "If different than customer address"
msgstr "Եթե տարբերվում է հաճախորդի հասցեից"

msgid "If disable, 'In Words' field will not be visible in any transaction"
msgstr "Եթե անջատված է, «Բառերով» դաշտը տեսանելի չի լինի որևէ գործարքում"

msgid "If disable, 'Rounded Total' field will not be visible in any transaction"
msgstr "Եթե անջատված է, «Կլորացված գումար» դաշտը տեսանելի չի լինի որևէ գործարքում"

msgid "If disabled, this role will be removed from all users."
msgstr "Եթե անջատված է, այս դերը կհեռացվի բոլոր օգտատերերից։"

msgid "If enabled then system won't apply the pricing rule on the delivery note which will be create from the pick list"
msgstr "Եթե միացված է, համակարգը գնագոյացման կանոնը չի կիրառի հավաքման ցանկից ստեղծվող առաքման ակտի վրա"

msgid "If enabled then system won't override the picked qty / batches / serial numbers / warehouse."
msgstr "Եթե միացված է, համակարգը չի վերագրի հավաքված քանակը / խմբաքանակները / սերիական համարները / պահեստը։"

msgid "If enabled,  user can login from any IP Address using Two Factor Auth, this can also be set for all users in System Settings"
msgstr "Եթե միացված է, օգտատերը կարող է մուտք գործել ցանկացած IP հասցեից՝ օգտագործելով երկգործոն նույնականացում։ Սա կարող է սահմանվել նաև բոլոր օգտատերերի համար Համակարգի կարգավորումներում"

msgid "If enabled, Tax Exemption Declaration will be considered for income tax calculation."
msgstr "Եթե միացված է, եկամտային հարկի հաշվարկի համար հաշվի կառնվի հարկային արտոնության հայտարարագիրը։"

msgid "If enabled, a print of this document will be attached to each email"
msgstr "Եթե միացված է, այս փաստաթղթի տպված տարբերակը կկցվի յուրաքանչյուր էլ. նամակին"

msgid "If enabled, a weekly scheduler scans the Stock Ledger Variance for item-warehouses with incorrect valuation in the current financial year and auto-creates Item & Warehouse based reposts to fix them."
msgstr "Եթե միացված է, շաբաթական պլանավորիչը ստուգում է պահեստային մատյանի շեղումները՝ ընթացիկ ֆինանսական տարում սխալ գնահատում ունեցող ապրանք-պահեստ զույգերը գտնելու համար, և ավտոմատ ստեղծում է ապրանքի և պահեստի վրա հիմնված վերաձևակերպումներ՝ դրանք ուղղելու համար։"

msgid "If enabled, additional ledger entries will be made for discounts in a separate Discount Account"
msgstr "Եթե միացված է, զեղչերի համար լրացուցիչ մատյանային գրառումներ կկատարվեն առանձին զեղչի հաշվում"

msgid "If enabled, all files attached to this document will be attached to each email"
msgstr "Եթե միացված է, այս փաստաթղթին կցված բոլոր ֆայլերը կկցվեն յուրաքանչյուր էլ. նամակին"

msgid "If enabled, all responses on the web form will be submitted anonymously"
msgstr "Եթե միացված է, վեբ ձևի բոլոր պատասխանները կներկայացվեն անանուն"

msgid "If enabled, all users can login from any IP Address using Two Factor Auth. This can also be set only for specific user(s) in User Page"
msgstr "Եթե միացված է, բոլոր օգտատերերը կարող են մուտք գործել ցանկացած IP հասցեից՝ օգտագործելով երկգործոն նույնականացում։ Սա կարող է սահմանվել նաև միայն որոշակի օգտատիրոջ (օգտատերերի) համար Օգտատիրոջ էջում"

msgid "If enabled, auto attendance will be marked on holidays if Employee Checkins exist"
msgstr "Եթե միացված է, տոնական օրերին ավտոմատ ներկայություն կնշվի, եթե առկա են աշխատակցի գրանցումներ"

msgid "If enabled, changes to the document are tracked and shown in timeline"
msgstr "Եթե միացված է, փաստաթղթի փոփոխությունները հետևվում և ցուցադրվում են ժամանակագրությունում"

msgid "If enabled, deducts payment days for absent attendance on holidays. By default, holidays are considered as paid"
msgstr "Եթե միացված է, տոնական օրերին բացակայության դեպքում վճարման օրերը կնվազեցվեն։ Լռելյայն տոնական օրերը համարվում են վճարովի"

msgid ""
"If enabled, do not update serial / batch values in the stock transactions on creation of auto Serial \n"
" / Batch Bundle. "
msgstr ""
"Եթե միացված է, սերիական \n"
" / խմբաքանակի փաթեթի ավտոմատ ստեղծման դեպքում պահեստային գործարքներում չթարմացնել սերիական / խմբաքանակի արժեքները։ "

msgid "If enabled, document views are tracked, this can happen multiple times"
msgstr "Եթե միացված է, փաստաթղթի դիտումները հետևվում են, ինչը կարող է տեղի ունենալ մի քանի անգամ"

msgid ""
"If enabled, formula for <b>Qty to Order</b>: <br>\n"
"Required Qty (BOM) - <a href=\"https://docs.frappe.io/erpnext/user/manual/en/projected-quantity\">Projected Qty</a>. <br> This helps avoid over-ordering."
msgstr ""
"Եթե միացված է, <b>Պատվիրելիք քանակի</b> բանաձևը՝ <br>\n"
"Պահանջվող քանակ (BOM) - <a href=\"https://docs.frappe.io/erpnext/user/manual/en/projected-quantity\">Կանխատեսվող քանակ</a>։ <br> Սա օգնում է խուսափել ավելորդ պատվերից։"

msgid ""
"If enabled, formula for <b>Required Qty</b>: <br>\n"
"Required Qty (BOM) - <a href=\"https://docs.frappe.io/erpnext/user/manual/en/projected-quantity\">Projected Qty</a>. <br> This helps avoid over-ordering."
msgstr ""
"Եթե միացված է, <b>Պահանջվող քանակի</b> բանաձևը՝ <br>\n"
"Պահանջվող քանակ (BOM) - <a href=\"https://docs.frappe.io/erpnext/user/manual/en/projected-quantity\">Կանխատեսվող քանակ</a>։ <br> Սա օգնում է խուսափել ավելորդ պատվերից։"

msgid "If enabled, ledger entries will be posted for change amount in POS transactions"
msgstr "Եթե միացված է, POS գործարքներում մանրի գումարի համար կձևակերպվեն մատյանային գրառումներ"

msgid "If enabled, only System Managers can upload public files. Other users can't see the checkbox <i>Is Private</i> in the upload dialog."
msgstr "Եթե միացված է, միայն Համակարգի կառավարիչները կարող են վերբեռնել հանրային ֆայլեր։ Մյուս օգտատերերը չեն տեսնի <i>Մասնավոր է</i> նշավանդակը վերբեռնման պատուհանում։"

msgid "If enabled, rule matching algorithm will run every hour"
msgstr "Եթե միացված է, կանոնների համապատասխանեցման ալգորիթմը կաշխատի ամեն ժամ"

msgid "If enabled, sales from this item will be included in Sales Person and Sales Partner commission calculations"
msgstr "Եթե միացված է, այս ապրանքի վաճառքները կներառվեն վաճառքի ներկայացուցչի և վաճառքի գործընկերոջ միջնորդավճարի հաշվարկներում"

msgid "If enabled, system will allow user to deliver the entire quantity of the finished goods produced against the Subcontracting Inward Order. If disabled, system will allow delivery of only the ordered quantity."
msgstr "Եթե միացված է, համակարգը թույլ կտա առաքել ենթապայմանագրային մուտքային պատվերի դիմաց արտադրված պատրաստի արտադրանքի ամբողջ քանակը։ Եթե անջատված է, համակարգը թույլ կտա առաքել միայն պատվիրված քանակը։"

msgid "If enabled, system will set incoming rate as zero for stand-alone credit notes with expired batch item."
msgstr "Եթե միացված է, համակարգը մուտքային գինը կսահմանի զրո ժամկետանց խմբաքանակով ապրանքով առանձին կրեդիտային նշումների համար։"

msgid "If enabled, the Secondary Items generated against a Finished Good will also be added in the Stock Entry when delivering that Finished Good."
msgstr "Եթե միացված է, պատրաստի արտադրանքի դիմաց առաջացած երկրորդային ապրանքները նույնպես կավելացվեն պահեստային գործառնության մեջ այդ պատրաստի արտադրանքն առաքելիս։"

msgid "If enabled, the amount will be excluded from accounting entries during Journal Entry creation."
msgstr "Եթե միացված է, գումարը կբացառվի հաշվապահական ձևակերպումներից՝ հաշվապահական ձևակերպում ստեղծելիս։"

msgid "If enabled, the component will be considered as a tax component and the amount will be auto-calculated as per the configured income tax slabs"
msgstr "Եթե միացված է, բաղադրիչը կդիտարկվի որպես հարկային բաղադրիչ, և գումարը ավտոմատ կհաշվարկվի՝ համաձայն կազմաձևված եկամտային հարկի սանդղակների"

msgid "If enabled, the component will be considered in the Income Tax Deductions report"
msgstr "Եթե միացված է, բաղադրիչը կներառվի «Եկամտային հարկի պահումներ» հաշվետվությունում"

msgid "If enabled, the component will not be displayed in the salary slip if the amount is zero"
msgstr "Եթե միացված է, բաղադրիչը չի ցուցադրվի աշխատավարձի թերթիկում, եթե գումարը զրո է"

msgid "If enabled, the consolidated invoices will have rounded total disabled"
msgstr "Եթե միացված է, համախմբված հաշիվ-ապրանքագրերում կլորացված գումարը կանջատվի"

msgid "If enabled, the document is marked as seen, the first time a user opens it"
msgstr "Եթե միացված է, փաստաթուղթը նշվում է որպես դիտված, երբ օգտատերն առաջին անգամ բացում է այն"

msgid "If enabled, the item rate won't adjust to the valuation rate during internal transfers, but accounting will still use the valuation rate. This will allow the user to specify a different rate for printing or taxation purposes."
msgstr "Եթե միացված է, ներքին տեղափոխումների ժամանակ ապրանքի գինը չի համապատասխանեցվի գնահատման գնին, սակայն հաշվապահությունը կօգտագործի գնահատման գինը։ Սա թույլ կտա օգտատիրոջը նշել այլ գին տպման կամ հարկման նպատակներով։"

msgid "If enabled, the notification will show up in the notifications dropdown on the top right corner of the navigation bar."
msgstr "Եթե միացված է, ծանուցումը կհայտնվի նավարկման վահանակի վերին աջ անկյունում գտնվող ծանուցումների բացվող ցանկում։"

msgid "If enabled, the password strength will be enforced based on the Minimum Password Score value. A value of 1 being very weak and 4 being very strong."
msgstr "Եթե միացված է, գաղտնաբառի ամրությունը կպարտադրվի՝ հիմնվելով Գաղտնաբառի նվազագույն գնահատականի արժեքի վրա։ 1 արժեքը շատ թույլ է, իսկ 4-ը՝ շատ ամուր։"

msgid "If enabled, the source and target warehouse in the Material Transfer Stock Entry must be different else an error will be thrown. If inventory dimensions are present, same source and target warehouse can be allowed but atleast any one of the inventory dimension fields must be different."
msgstr "Եթե միացված է, նյութերի տեղափոխման պահեստային գործառնությունում ելքային և մուտքային պահեստները պետք է տարբեր լինեն, հակառակ դեպքում սխալ կառաջանա։ Եթե առկա են պաշարի չափումներ, կարող է թույլատրվել նույն ելքային և մուտքային պահեստը, սակայն պաշարի չափման դաշտերից առնվազն մեկը պետք է տարբեր լինի։"

msgid "If enabled, the system will allow negative stock entries for the batch. But, this may lead to incorrect valuation rates, so it is recommended to avoid using this option. The system will permit negative stock only when it is caused by backdated entries and will validate and block negative stock in all other cases."
msgstr "Եթե միացված է, համակարգը թույլ կտա խմբաքանակի համար բացասական պաշարի գրառումներ։ Սակայն դա կարող է հանգեցնել գնահատման սխալ գների, ուստի խորհուրդ է տրվում խուսափել այս տարբերակից։ Համակարգը կթույլատրի բացասական պաշար միայն այն դեպքում, երբ այն առաջանում է հետին ամսաթվով գրառումների պատճառով, իսկ մնացած բոլոր դեպքերում կստուգի և կարգելափակի բացասական պաշարը։"

msgid "If enabled, the system will allow negative stock entries for this batch, overriding the 'Allow negative stock for Batch' setting in Stock Settings. This may lead to incorrect valuation rates, so it is recommended to avoid using this option."
msgstr "Եթե միացված է, համակարգը թույլ կտա բացասական պաշարի գրառումներ այս խմբաքանակի համար՝ վերագրելով պաշարի կարգավորումներում «Թույլատրել բացասական պաշար խմբաքանակի համար» կարգավորումը։ Դա կարող է հանգեցնել գնահատման սխալ գների, ուստի խորհուրդ է տրվում խուսափել այս տարբերակից։"

msgid "If enabled, the system will allow selecting UOMs in sales and purchase transactions only if the conversion rate is set in the item master."
msgstr "Եթե միացված է, համակարգը թույլ կտա վաճառքի և գնման գործարքներում ընտրել Չ/մ միայն այն դեպքում, եթե փոխարկման գործակիցը սահմանված է ապրանքի քարտում։"

msgid "If enabled, the system will allow users to edit the raw materials and their quantities in the Work Order. The system will not reset the quantities as per the BOM, if the user has changed them."
msgstr "Եթե միացված է, համակարգը թույլ կտա օգտատերերին խմբագրել հումքը և դրա քանակները արտադրական պատվերում։ Համակարգը չի վերակայի քանակներն ըստ BOM-ի, եթե օգտատերը փոխել է դրանք։"

msgid "If enabled, the system will generate an accounting entry for materials rejected in the Purchase Receipt."
msgstr "Եթե միացված է, համակարգը կստեղծի հաշվապահական գրառում ապրանքի ընդունման ակտում մերժված նյութերի համար։"

msgid "If enabled, the system will use the inventory account set in the Item Master or Item Group or Brand. Otherwise, it will use the inventory account set in the Warehouse."
msgstr "Եթե միացված է, համակարգը կօգտագործի ապրանքի քարտում, ապրանքային խմբում կամ ապրանքանիշում սահմանված պաշարի հաշիվը։ Հակառակ դեպքում կօգտագործվի պահեստում սահմանված պաշարի հաշիվը։"

msgid "If enabled, the system will use the moving average valuation method to calculate the valuation rate for the batched items and will not consider the individual batch-wise incoming rate."
msgstr "Եթե միացված է, համակարգը խմբաքանակով ապրանքների գնահատման գինը հաշվարկելու համար կօգտագործի շարժական միջինի գնահատման մեթոդը և հաշվի չի առնի առանձին խմբաքանակների մուտքային գինը։"

msgid "If enabled, the total no. of applications received for this opening will be displayed on the website"
msgstr "Եթե միացված է, այս թափուր աշխատատեղի համար ստացված դիմումների ընդհանուր քանակը կցուցադրվի կայքում"

msgid "If enabled, the value specified or calculated in this component will not contribute to the earnings or deductions. However, it's value can be referenced by other components that can be added or deducted. "
msgstr "Եթե միացված է, այս բաղադրիչում նշված կամ հաշվարկված արժեքը չի ազդի հաշվեգրումների կամ պահումների վրա։ Սակայն դրա արժեքին կարող են հղվել այլ բաղադրիչներ, որոնք կարող են ավելացվել կամ պահվել։ "

msgid "If enabled, the web form can only be used with a <i>Key</i> from a corresponding <b>Web Form Request</b>."
msgstr "Եթե միացված է, վեբ ձևը կարող է օգտագործվել միայն համապատասխան <b>Վեբ ձևի հարցման</b> <i>Բանալիով</i>։"

msgid "If enabled, then system will only validate the pricing rule and not apply automatically. User has to manually set the discount percentage / margin / free items to validate the pricing rule"
msgstr "Եթե միացված է, համակարգը միայն կստուգի գնագոյացման կանոնը և այն ավտոմատ չի կիրառի։ Գնագոյացման կանոնը ստուգելու համար օգտատերը պետք է ձեռքով սահմանի զեղչի տոկոսը / հավելագինը / անվճար ապրանքները"

msgid "If enabled, this component allows to accrue amounts without adding them to earnings. The accrued balance is tracked in the Employee Benefit Ledger and can be paid out later as needed."
msgstr "Եթե միացված է, այս բաղադրիչը թույլ է տալիս կուտակել գումարներ՝ առանց դրանք հաշվեգրումներին ավելացնելու։ Կուտակված մնացորդը հետևվում է աշխատակցի նպաստների մատյանում և կարող է վճարվել ավելի ուշ՝ ըստ անհրաժեշտության։"

msgid "If enabled, this component will be included in arrear calculations"
msgstr "Եթե միացված է, այս բաղադրիչը կներառվի հետվճարների հաշվարկներում"

msgid "If enabled, this row's values will be displayed on financial charts"
msgstr "Եթե միացված է, այս տողի արժեքները կցուցադրվեն ֆինանսական գծապատկերներում"

msgid "If enabled, total no. of working days will include holidays, and this will reduce the value of Salary Per Day"
msgstr "Եթե միացված է, աշխատանքային օրերի ընդհանուր քանակը կներառի տոնական օրերը, և դա կնվազեցնի օրական աշխատավարձի արժեքը"

msgid "If enabled, user will be alerted before resetting posting date to current date in relevant transactions"
msgstr "Եթե միացված է, համապատասխան գործարքներում ձևակերպման ամսաթիվը ընթացիկ ամսաթվով վերակայելուց առաջ օգտատերը կզգուշացվի"

msgid "If enabled, users must enter Serial No. / Batch data manually instead of using the selector dialog."
msgstr "Եթե միացված է, օգտատերերը պետք է սերիական համարի / խմբաքանակի տվյալները մուտքագրեն ձեռքով՝ ընտրության պատուհանի փոխարեն։"

msgid "If enabled, users who login from Restricted IP Address, won't be prompted for Two Factor Auth"
msgstr "Եթե միացված է, Սահմանափակված IP հասցեից մուտք գործող օգտատերերից երկգործոն նույնականացում չի պահանջվի"

msgid "If enabled, users will be notified every time they login. If not enabled, users will only be notified once."
msgstr "Եթե միացված է, օգտատերերը կծանուցվեն ամեն անգամ մուտք գործելիս։ Եթե միացված չէ, օգտատերերը կծանուցվեն միայն մեկ անգամ։"

msgid "If greater than zero, this sets the maximum benefit amount assignable to any employee"
msgstr "Եթե զրոյից մեծ է, սա սահմանում է ցանկացած աշխատակցի նշանակվող նպաստի առավելագույն գումարը"

msgid "If item is a variant of another item then description, image, pricing, taxes etc will be set from the template unless explicitly specified"
msgstr "Եթե ապրանքը մեկ այլ ապրանքի տարբերակ է, ապա նկարագրությունը, պատկերը, գնագոյացումը, հարկերը և այլն կվերցվեն ձևանմուշից, եթե բացահայտ նշված չեն"

msgid "If items in stock, proceed with Material Transfer or Purchase."
msgstr "Եթե ապրանքները պաշարում են, շարունակեք նյութերի տեղափոխմամբ կամ գնմամբ։"

msgid "If left empty, the default workspace will be the last visited workspace"
msgstr "Եթե դատարկ է, լռելյայն աշխատանքային տարածքը կլինի վերջին այցելածը"

msgid "If mentioned, the system will allow only the users with this Role to create or modify any stock transaction earlier than the latest stock transaction for a specific item and warehouse. If set as blank, it allows all users to create/edit back-dated transactions."
msgstr "Եթե նշված է, համակարգը միայն այս դերն ունեցող օգտատերերին թույլ կտա ստեղծել կամ փոփոխել պահեստային գործարքներ, որոնք ավելի վաղ են, քան տվյալ ապրանքի և պահեստի վերջին պահեստային գործարքը։ Եթե դատարկ է, բոլոր օգտատերերը կարող են ստեղծել/խմբագրել հետին ամսաթվով գործարքներ։"

msgid "If more than one package of the same type (for print)"
msgstr "Եթե նույն տեսակի մեկից ավելի փաթեթ կա (տպման համար)"

msgid "If multiple Pricing Rules continue to prevail, users are asked to set Priority manually to resolve conflict."
msgstr "Եթե մի քանի գնագոյացման կանոններ շարունակում են գերակայել, օգտատերերին կառաջարկվի ձեռքով սահմանել առաջնահերթությունը՝ հակասությունը լուծելու համար։"

msgid "If no Item Price is found for an item in the Price List set in the transaction, prices from the Default Price List will be fetched."
msgstr "Եթե գործարքում նշված գնացուցակում ապրանքի գին չի գտնվել, գները կվերցվեն լռելյայն գնացուցակից։"

msgid "If no Print Format is selected, the default template for this report will be used."
msgstr "Եթե Տպման ձևաչափ ընտրված չէ, կօգտագործվի այս հաշվետվության լռելյայն ձևանմուշը։"

msgid "If no taxes are set, and Taxes and Charges Template is selected, the system will automatically apply the taxes from the chosen template."
msgstr "Եթե հարկեր սահմանված չեն, և ընտրված է հարկերի և վճարների ձևանմուշ, համակարգը ավտոմատ կերպով կկիրառի ընտրված ձևանմուշի հարկերը։"

msgid "If non standard port (e.g. 587)"
msgstr "Եթե ոչ ստանդարտ պորտ է (օր.՝ 587)"

msgid "If non standard port (e.g. 587). If on Google Cloud, try port 2525."
msgstr "Եթե ոչ ստանդարտ պորտ է (օր.՝ 587)։ Google Cloud-ում փորձեք 2525 պորտը։"

msgid "If non-standard port (e.g. POP3: 995/110, IMAP: 993/143)"
msgstr "Եթե ոչ ստանդարտ պորտ է (օր.՝ POP3: 995/110, IMAP: 993/143)"

msgid "If not checked, the list will have to be added to each Department where it has to be applied."
msgstr "Եթե նշված չէ, ցանկը պետք է ավելացվի յուրաքանչյուր բաժնի, որտեղ այն պետք է կիրառվի։"

msgid "If not set, the currency precision will depend on number format"
msgstr "Եթե սահմանված չէ, արժույթի ճշտությունը կախված կլինի թվի ձևաչափից"

msgid "If not, you can Cancel / Submit this entry"
msgstr "Եթե ոչ, կարող եք չեղարկել / հաստատել այս գրառումը"

msgid "If party does not exist, create it using the Customer Name field."
msgstr "Եթե կողմը գոյություն չունի, ստեղծեք այն՝ օգտագործելով «Հաճախորդի անվանում» դաշտը։"

msgid "If party does not exist, create it using the Supplier Name field."
msgstr "Եթե կողմը գոյություն չունի, ստեղծեք այն՝ օգտագործելով «Մատակարարի անվանում» դաշտը։"

msgid "If rate is zero then item will be treated as \"Free Item\""
msgstr "Եթե գինը զրո է, ապրանքը կդիտվի որպես «Անվճար ապրանք»"

msgid "If rule matches, then:"
msgstr "Եթե կանոնը համապատասխանում է, ապա՝"

msgid "If selected Pricing Rule is made for 'Rate', it will overwrite Price List. Pricing Rule rate is the final rate, so no further discount should be applied. Hence, in transactions like Sales Order, Purchase Order etc, it will be fetched in 'Rate' field, rather than 'Price List Rate' field."
msgstr "Եթե ընտրված գնագոյացման կանոնը սահմանված է «Գին»-ի համար, այն կվերագրի գնացուցակը։ Գնագոյացման կանոնի գինը վերջնական գինն է, ուստի հետագա զեղչ չպետք է կիրառվի։ Հետևաբար, վաճառքի պատվերի, գնման պատվերի և այլ գործարքներում այն կլրացվի «Գին» դաշտում, այլ ոչ թե «Գնացուցակի գին» դաշտում։"

msgid "If selected, the value specified or calculated in this component will not contribute to the earnings or deductions. However, it's value can be referenced by other components that can be added or deducted. "
msgstr "Եթե ընտրված է, այս բաղադրիչում նշված կամ հաշվարկված արժեքը չի ազդի հաշվեգրումների կամ պահումների վրա։ Սակայն դրա արժեքին կարող են հղվել այլ բաղադրիչներ, որոնք կարող են ավելացվել կամ պահվել։ "

msgid "If set, accounting entries for this customer will post to these accounts instead of the company default."
msgstr "Եթե սահմանված է, այս հաճախորդի հաշվապահական գրառումները կձևակերպվեն այս հաշիվներում՝ ընկերության լռելյայն հաշիվների փոխարեն։"

msgid "If set, only user with these roles can access this chart. If not set, DocType or Report permissions will be used."
msgstr "Եթե սահմանված է, այս գծապատկերին կարող են մուտք գործել միայն այս դերերով օգտատերերը։ Եթե սահմանված չէ, կօգտագործվեն DocType-ի կամ Հաշվետվության թույլտվությունները։"

msgid "If set, the job opening will be closed automatically after this date"
msgstr "Եթե սահմանված է, թափուր աշխատատեղը ավտոմատ կփակվի այս ամսաթվից հետո"

msgid "If set, the system does not use the user's Email or the standard outgoing Email account for sending request for quotations."
msgstr "Եթե սահմանված է, համակարգը գնային առաջարկի հարցումներ ուղարկելու համար չի օգտագործում օգտատիրոջ էլ. փոստը կամ ստանդարտ ելքային էլ. փոստի հաշիվը։"

msgid "If the BOM results in Scrap material, the Scrap Warehouse needs to be selected."
msgstr "Եթե BOM-ի արդյունքում առաջանում է թափոն, պետք է ընտրել թափոնների պահեստը։"

msgid "If the account is frozen, entries are allowed to restricted users."
msgstr "Եթե հաշիվը սառեցված է, գրառումները թույլատրվում են սահմանափակված օգտատերերին։"

msgid "If the item is transacting as a Zero Valuation Rate item in this entry, please enable 'Allow Zero Valuation Rate' in the {0} Item table."
msgstr "Եթե այս գրառման մեջ ապրանքը գործարքվում է որպես զրոյական գնահատման գնով ապրանք, խնդրում ենք միացնել «Թույլատրել զրոյական գնահատման գին» {0} ապրանքների աղյուսակում։"

msgid "If the reorder check is set at the Group warehouse level, the available quantity becomes the sum of the projected quantities of all its child warehouses."
msgstr "Եթե վերապատվերի ստուգումը սահմանված է խմբային պահեստի մակարդակում, հասանելի քանակը դառնում է նրա բոլոր ենթապահեստների կանխատեսվող քանակների գումարը։"

msgid "If the selected BOM has Operations mentioned in it, the system will fetch all Operations from BOM, these values can be changed."
msgstr "Եթե ընտրված BOM-ում նշված են գործողություններ, համակարգը կվերցնի բոլոր գործողությունները BOM-ից, և այդ արժեքները կարելի է փոխել։"

msgid "If the user enables the mask property for the phone number field, the value will be displayed in a masked format (e.g., 811XXXXXXX)."
msgstr "Եթե օգտատերը միացնում է հեռախոսահամարի դաշտի դիմակավորման հատկությունը, արժեքը կցուցադրվի դիմակավորված ձևաչափով (օր.՝ 811XXXXXXX)։"

msgid "If the user has access to Employee and Report is enabled, they can view Employee-based reports."
msgstr "Եթե օգտատերը մուտք ունի Աշխատակցին, և Հաշվետվությունը միացված է, նա կարող է դիտել Աշխատակցի վրա հիմնված հաշվետվությունները։"

msgid "If the user has any role checked, then the user becomes a \"System User\". \"System User\" has access to the desktop"
msgstr "Եթե օգտատիրոջ համար որևէ դեր նշված է, ապա օգտատերը դառնում է \"Համակարգի օգտատեր\"։ \"Համակարգի օգտատերը\" մուտք ունի աշխատասեղան"

msgid "If there is no assigned timeslot, then communication will be handled by this group"
msgstr "Եթե նշանակված ժամանակահատված չկա, հաղորդակցությունը կսպասարկի այս խումբը"

msgid "If there is no title column, use the code column for the title."
msgstr "Եթե վերնագրի սյունակ չկա, վերնագրի համար օգտագործեք կոդի սյունակը։"

msgid "If these instructions where not helpful, please add in your suggestions on GitHub Issues."
msgstr "Եթե այս հրահանգները օգտակար չէին, խնդրում ենք ավելացնել ձեր առաջարկները GitHub Issues-ում։"

msgid "If this checkbox is checked, paid amount will be splitted and allocated as per the amounts in payment schedule against each payment term"
msgstr "Եթե այս վանդակը նշված է, վճարված գումարը կբաժանվի և կբաշխվի ըստ վճարման ժամանակացույցի գումարների՝ յուրաքանչյուր վճարման պայմանի դիմաց"

msgid "If this email is registered with us, a download link will be sent to it."
msgstr "Եթե այս էլ. փոստը գրանցված է մեզ մոտ, դրան կուղարկվի ներբեռնման հղում։"

msgid "If this email is registered with us, we have sent password reset instructions to it. Please check your inbox."
msgstr "Եթե այս էլ. փոստը գրանցված է մեզ մոտ, մենք դրան ուղարկել ենք գաղտնաբառի վերակայման հրահանգներ։ Խնդրում ենք ստուգել ձեր փոստարկղը։"

msgid "If this is checked subsequent new invoices will be created on calendar  month and quarter start dates irrespective of current invoice start date"
msgstr "Եթե սա նշված է, հաջորդ նոր հաշիվ-ապրանքագրերը կստեղծվեն օրացուցային ամսվա և եռամսյակի սկզբի ամսաթվերով՝ անկախ ընթացիկ հաշիվ-ապրանքագրի սկզբի ամսաթվից"

msgid "If this is unchecked Journal Entries will be saved in a Draft state and will have to be submitted manually"
msgstr "Եթե սա նշված չէ, հաշվապահական ձևակերպումները կպահպանվեն սևագրի կարգավիճակում և պետք է հաստատվեն ձեռքով"

msgid "If this is unchecked, direct GL entries will be created to book deferred revenue or expense"
msgstr "Եթե սա նշված չէ, հետաձգված եկամուտը կամ ծախսը ձևակերպելու համար կստեղծվեն ուղղակի ԳՄ գրառումներ"

msgid "If this is undesirable please cancel the corresponding Payment Entry."
msgstr "Եթե սա ցանկալի չէ, խնդրում ենք չեղարկել համապատասխան վճարման գրառումը։"

msgid "If this item has variants, then it cannot be selected in sales orders etc."
msgstr "Եթե այս ապրանքն ունի տարբերակներ, այն չի կարող ընտրվել վաճառքի պատվերներում և այլն։"

msgid "If this option is configured 'Yes', ERPNext will prevent you from creating a Purchase Invoice or Receipt without creating a Purchase Order first. This configuration can be overridden for a particular supplier by enabling the 'Allow Purchase Invoice Creation Without Purchase Order' checkbox in the Supplier master."
msgstr "Եթե այս տարբերակը կարգավորված է «Այո», ERPNext-ը թույլ չի տա ստեղծել գնման հաշիվ-ապրանքագիր կամ ընդունման ակտ՝ առանց նախապես գնման պատվեր ստեղծելու։ Այս կարգավորումը կարելի է վերագրել կոնկրետ մատակարարի համար՝ մատակարարի քարտում միացնելով «Թույլատրել գնման հաշիվ-ապրանքագրի ստեղծում առանց գնման պատվերի» վանդակը։"

msgid "If this option is configured 'Yes', ERPNext will prevent you from creating a Purchase Invoice without creating a Purchase Receipt first. This configuration can be overridden for a particular supplier by enabling the 'Allow Purchase Invoice Creation Without Purchase Receipt' checkbox in the Supplier master."
msgstr "Եթե այս տարբերակը կարգավորված է «Այո», ERPNext-ը թույլ չի տա ստեղծել գնման հաշիվ-ապրանքագիր՝ առանց նախապես ապրանքի ընդունման ակտ ստեղծելու։ Այս կարգավորումը կարելի է վերագրել կոնկրետ մատակարարի համար՝ մատակարարի քարտում միացնելով «Թույլատրել գնման հաշիվ-ապրանքագրի ստեղծում առանց ապրանքի ընդունման ակտի» վանդակը։"

msgid "If this was you:"
msgstr "Եթե սա դուք էիք՝"

msgid "If this wasn't you:"
msgstr "Եթե սա դուք չէիք՝"

msgid "If ticked, multiple materials can be used for a single Work Order. This is useful if one or more time consuming products are being manufactured."
msgstr "Եթե նշված է, մեկ արտադրական պատվերի համար կարող են օգտագործվել բազմաթիվ նյութեր։ Սա օգտակար է, եթե արտադրվում են մեկ կամ մի քանի ժամանակատար արտադրանքներ։"

msgid "If ticked, the BOM cost will be automatically updated based on Valuation Rate / Price List Rate / last purchase rate of raw materials."
msgstr "Եթե նշված է, BOM-ի արժեքն ավտոմատ կերպով կթարմացվի հումքի գնահատման գնի / գնացուցակի գնի / վերջին գնման գնի հիման վրա։"

msgid "If two or more Pricing Rules are found based on the above conditions, Priority is applied. Priority is a number between 0 to 20 while default value is zero (blank). Higher number means it will take precedence if there are multiple Pricing Rules with same conditions."
msgstr "Եթե վերոնշյալ պայմանների հիման վրա գտնվել են երկու կամ ավելի գնագոյացման կանոններ, կիրառվում է առաջնահերթությունը։ Առաջնահերթությունը 0-ից 20 թիվ է, իսկ լռելյայն արժեքը զրո է (դատարկ)։ Ավելի մեծ թիվը նշանակում է, որ այն կգերակայի նույն պայմաններով մի քանի գնագոյացման կանոնների առկայության դեպքում։"

msgid "If unchecked, the value will always be re-fetched on save."
msgstr "Եթե նշված չէ, արժեքը միշտ նորից կբեռնվի պահպանելիս։"

msgid "If unlimited expiry for the Loyalty Points, keep the Expiry Duration empty or 0."
msgstr "Եթե հավատարմության միավորների ժամկետն անսահմանափակ է, թողեք ժամկետի տևողությունը դատարկ կամ 0։"

msgid "If user is the owner"
msgstr "Եթե օգտատերը սեփականատերն է"

msgid "If yes, then this warehouse will be used to store rejected materials"
msgstr "Եթե այո, այս պահեստը կօգտագործվի մերժված նյութերը պահելու համար"

msgid "If you are maintaining stock of this Item in your Inventory, ERPNext will make a stock ledger entry for each transaction of this item."
msgstr "Եթե այս ապրանքի պաշարը վարում եք ձեր պահեստում, ERPNext-ը այս ապրանքի յուրաքանչյուր գործարքի համար կկատարի պահեստային մատյանի գրառում։"

msgid "If you are updating, please select \"Overwrite\" else existing rows will not be deleted."
