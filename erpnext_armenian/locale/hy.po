msgid "A Reconciliation Job {0} is running for the same filters. Cannot reconcile now"
msgstr "Նույն ֆիլտրերով արդեն ընթանում է համադրման {0} աշխատանք։ Այժմ հնարավոր չէ համադրել"

msgid "A Reverse Journal Entry {0} already exists for this Journal Entry."
msgstr "Այս հաշվապահական ձևակերպման համար արդեն գոյություն ունի հակադարձ ձևակերպում՝ {0}։"

msgid "A Single (Settings) doctype."
msgstr "Single (Կարգավորումներ) doctype։"

