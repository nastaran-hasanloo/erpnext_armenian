msgstr "Հետևյալ նշանակման օրերը կրկնվել են՝ {0}"

msgid "The following Header Script will add the current date to an element in 'Header HTML' with class 'header-content'"
msgstr "Հետևյալ Header Script-ը կավելացնի ընթացիկ ամսաթիվը 'Header HTML'-ի 'header-content' դասով տարրին"

msgid "The following Items, having Putaway Rules, could not be accomodated:"
msgstr "Տեղադրման կանոններ ունեցող հետևյալ ապրանքները հնարավոր չեղավ տեղավորել՝"

