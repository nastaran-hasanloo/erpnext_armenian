msgid "Row No {0}: Warehouse is required. Please set a Default Warehouse for Item {1} and Company {2}"
msgstr "Տող {0}: Պահեստը պարտադիր է։ Խնդրում ենք սահմանել լռելյայն պահեստ {1} ապրանքի և {2} ընկերության համար"

msgid "Row Number"
